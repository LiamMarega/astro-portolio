---
/**
 * A word whose letters swap for die-cut stickers on hover (tap on phones),
 * same trick as the giant name of the home page. Punctuation stays as is.
 * Behaviour: src/scripts/stickers.ts → initStickers().
 */
import Sticker, { type StickerType } from './Sticker.astro';
import { stickerGeo } from '../lib/stickers';

interface Props {
  text: string;
  stickers: StickerType[];
  uid: string;
  tilt?: number[];
  class?: string;
}
const { text, stickers, uid, tilt = [-7, 5, -4, 8, -6, 4], class: className } = Astro.props;
let k = 0;
---

<span class:list={['sw', className]} data-stickers aria-hidden="true">
  {
    [...text].map((ch, i) => {
      if (!/\p{L}|\p{N}/u.test(ch)) return <span class="sw__punct">{ch}</span>;
      const n = k++;
      const type = stickers[n % stickers.length];
      const g = stickerGeo[type];
      return (
        <span class="ch" style={`--s:${g.s}em;--y:${g.y}em;--r:${tilt[n % tilt.length]}deg`}>
          <span class="ch__glyph">{ch}</span>
          <span class="ch__sticker" data-type={type}>
            <Sticker type={type} char={ch} uid={`${uid}${i}`} />
          </span>
        </span>
      );
    })
  }
</span>

<style>
  .sw {
    display: inline-flex;
    position: relative;
    white-space: nowrap;
  }

  .ch {
    position: relative;
    display: inline-block;
    cursor: default;
  }

  .ch__glyph {
    display: inline-block;
    transition: opacity 0.08s linear;
  }
  .ch.is-on .ch__glyph {
    opacity: 0;
    transition-duration: 0.04s;
  }

  .ch__sticker {
    position: absolute;
    left: 50%;
    top: calc(0.863em + var(--y));
    width: var(--s);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    letter-spacing: 0;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%) rotate(var(--r)) scale(0.72);
    transition:
      opacity 0.12s ease,
      transform 0.16s ease;
    z-index: 4;
  }
  .ch.is-on .ch__sticker {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(var(--r)) scale(1);
    transition:
      opacity 0.08s ease,
      transform 0.42s cubic-bezier(0.3, 1.8, 0.45, 1);
  }
  .ch__sticker :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 0.012em 0.008em rgba(0, 0, 0, 0.18)) drop-shadow(0 0.04em 0.05em rgba(0, 0, 0, 0.16));
  }
</style>
