---
import SectionHead from './SectionHead.astro';
import Doodle from '../Doodle.astro';
import { useEcommerce } from '../../content/ecommerce';

const m = useEcommerce(Astro.currentLocale).method;
// highlight the method name inside the intro
const key = m.name.toLowerCase();
const at = m.intro.toLowerCase().indexOf(key);
const intro = at < 0 ? [m.intro, '', ''] : [m.intro.slice(0, at), m.intro.slice(at, at + key.length), m.intro.slice(at + key.length)];
const [creative, sell, ops] = m.pillars;
const rows = [78, 54, 66, 40];
---

<section class="esec emethod" data-pause-offscreen aria-labelledby="method-title">
  <SectionHead note={m.note} title={m.title} id="method-title" />
  <p class="emethod__intro" data-fade>
    {intro[0]}<b class="emethod__name">{intro[1]}</b>{intro[2]}
  </p>

  <div class="emethod__grid">
    <article class="pillar" data-reveal>
      <div class="pillar__art pillar__art--brand" aria-hidden="true">
        <span class="swatch" style="--c:#ffd60a;--x:-62%;--r:-8deg"></span>
        <span class="swatch" style="--c:#ff8a3d;--x:-22%;--r:4deg"></span>
        <span class="swatch" style="--c:#7be0b0;--x:18%;--r:-3deg"></span>
        <span class="swatch" style="--c:#8f7bff;--x:58%;--r:9deg"></span>
        <span class="pillar__aa">Aa</span>
        <span class="pillar__hand hand">{creative.art}</span>
        <Doodle name="sparkles" seed="pb" class="pillar__stars" onView duration={0.7} />
      </div>
      <p class="pillar__tag">{creative.tag}</p>
      <h3 class="pillar__title">{creative.title}</h3>
      <p class="pillar__text">{creative.text}</p>
    </article>

    <article class="pillar" data-reveal style="--reveal-delay:.08s">
      <div class="pillar__art pillar__art--flow" aria-hidden="true">
        <ol class="flow">
          {sell.flow?.map((s, i) => <li class:list={{ 'is-end': i === (sell.flow?.length ?? 0) - 1 }}>{s}</li>)}
        </ol>
        <span class="flow__dot"></span>
      </div>
      <p class="pillar__tag">{sell.tag}</p>
      <h3 class="pillar__title">{sell.title}</h3>
      <p class="pillar__text">{sell.text}</p>
    </article>

    <article class="pillar" data-reveal style="--reveal-delay:.16s">
      <div class="pillar__art pillar__art--cat" aria-hidden="true">
        <ul class="cat">
          {
            rows.map((w, i) => (
              <li class="cat__row" style={`--w:${w}%;--i:${i}`}>
                <span class="cat__thumb" />
                <span class="cat__lines">
                  <i />
                  <i />
                </span>
                <span class="cat__ok">
                  <svg viewBox="0 0 24 24"><path d="M6 12.5l4 4 8-9" /></svg>
                </span>
              </li>
            ))
          }
        </ul>
        <span class="cat__hand hand">{ops.art}</span>
        <Doodle name="arrow" seed="pc" class="cat__arrow" onView duration={0.7} delay={0.3} />
      </div>
      <p class="pillar__tag">{ops.tag}</p>
      <h3 class="pillar__title">{ops.title}</h3>
      <p class="pillar__text">{ops.text}</p>
    </article>
  </div>
</section>

<style>
  .emethod {
    contain: layout style;
  }
  .emethod__intro {
    max-width: 40em;
    margin-top: clamp(18px, 2vw, 32px);
    font-size: clamp(17px, 1.55vw, 26px);
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .emethod__name {
    padding: 0.05em 0.3em 0.1em;
    border-radius: 0.3em;
    background: #0b0b0b;
    color: var(--sun-text);
    font-weight: 500;
    white-space: nowrap;
  }

  .emethod__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(10px, 1.09vw, 18px);
    margin-top: clamp(34px, 4vw, 64px);
  }

  .pillar {
    display: flex;
    flex-direction: column;
    padding: clamp(14px, 1.2vw, 20px) clamp(14px, 1.2vw, 20px) clamp(22px, 2.4vw, 40px);
    border-radius: var(--radius-bento);
    background: var(--card);
  }
  .pillar__art {
    position: relative;
    height: clamp(190px, 16vw, 270px);
    border-radius: clamp(12px, 1vw, 16px);
    background: #fff;
    overflow: hidden;
    container-type: inline-size;
  }
  .pillar__tag {
    align-self: flex-start;
    margin: clamp(18px, 1.8vw, 28px) clamp(4px, 0.6vw, 10px) 0;
    padding: 0.32em 0.8em;
    border-radius: 999px;
    background: #e3e3e3;
    font-size: clamp(13px, 0.95vw, 15px);
    font-weight: 520;
    color: #111;
  }
  .pillar__title {
    margin: 12px clamp(4px, 0.6vw, 10px) 0;
    font-size: clamp(24px, 2.1vw, 38px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .pillar__text {
    margin: 10px clamp(4px, 0.6vw, 10px) 0;
    font-size: clamp(15px, 1.15vw, 19px);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  /* 1 · brand: swatches + bubble type */
  .pillar__art--brand {
    background: radial-gradient(ellipse 80% 90% at 100% 0%, #fff4c2, #fff 70%);
  }
  .swatch {
    position: absolute;
    left: 50%;
    bottom: 14%;
    width: 22cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--c);
    border: 0.9cqw solid #fff;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.12);
    transform: translateX(calc(-50% + var(--x) * 1.6)) rotate(var(--r));
    transition: transform 0.6s var(--ease-spring);
  }
  .pillar:hover .swatch {
    transform: translateX(calc(-50% + var(--x) * 1.9)) translateY(-6%) rotate(calc(var(--r) * -1));
  }
  .pillar__aa {
    position: absolute;
    left: 10%;
    top: 8%;
    font-family: var(--font-bubble);
    font-size: 30cqw;
    line-height: 1;
    color: #fff;
    -webkit-text-stroke: 1.6cqw #111;
    paint-order: stroke fill;
    text-shadow: 0.6cqw 0.9cqw 0 #111;
    transform: rotate(-6deg);
  }
  .pillar__hand {
    position: absolute;
    right: 9%;
    top: 16%;
    font-size: 9cqw;
    color: #555;
    transform: rotate(6deg);
  }
  .pillar__art :global(.pillar__stars) {
    position: absolute;
    right: 8%;
    top: 34%;
    width: 15cqw;
    color: #111;
  }

  /* 2 · flow: product → cart → pay → order */
  .pillar__art--flow {
    display: grid;
    place-items: center;
    background: #fff;
  }
  .flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 4cqw 7cqw;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: f;
  }
  .flow li {
    position: relative;
    padding: 2.6cqw 4.4cqw;
    border-radius: 999px;
    background: #f1f1f1;
    font-size: max(13px, 5.2cqw);
    font-weight: 500;
    white-space: nowrap;
    text-align: center;
  }
  .flow li.is-end {
    background: var(--sun);
    font-weight: 600;
  }
  .flow li:nth-child(1)::after,
  .flow li:nth-child(3)::after {
    content: '→';
    position: absolute;
    right: -5.6cqw;
    top: 50%;
    font-weight: 500;
    color: #999;
    transform: translateY(-52%);
  }
  .flow li:nth-child(2)::after {
    content: '↙';
    position: absolute;
    left: -2cqw;
    bottom: -4.8cqw;
    color: #999;
  }
  .flow__dot {
    position: absolute;
    width: 3.2cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #111;
    box-shadow: 0 0 0 1.2cqw rgba(255, 214, 10, 0.55);
    offset-path: inset(28% 14% 28% 14% round 20%);
    animation: flow-run 5s linear infinite;
  }
  @keyframes flow-run {
    to {
      offset-distance: 100%;
    }
  }
  @supports not (offset-path: inset(0)) {
    .flow__dot {
      display: none;
    }
  }

  /* 3 · catalog rows being migrated */
  .pillar__art--cat {
    background: #fff;
  }
  .cat {
    position: absolute;
    left: 6cqw;
    top: 50%;
    display: grid;
    gap: 2.6cqw;
    width: 58cqw;
    margin: 0;
    padding: 0;
    list-style: none;
    transform: translateY(-50%);
  }
  .cat__row {
    display: flex;
    align-items: center;
    gap: 3cqw;
    padding: 2.2cqw 3cqw;
    border-radius: 3cqw;
    background: #f4f4f4;
  }
  .cat__thumb {
    flex: none;
    width: 8cqw;
    aspect-ratio: 1;
    border-radius: 2cqw;
    background: #e0dcc8;
  }
  .cat__row:nth-child(2) .cat__thumb {
    background: #cfe1ee;
  }
  .cat__row:nth-child(3) .cat__thumb {
    background: #e7d2cf;
  }
  .cat__row:nth-child(4) .cat__thumb {
    background: #d3e6d2;
  }
  .cat__lines {
    flex: 1;
    display: grid;
    gap: 1.4cqw;
  }
  .cat__lines i {
    display: block;
    height: 1.6cqw;
    border-radius: 999px;
    background: #d8d8d8;
  }
  .cat__lines i:first-child {
    width: var(--w);
    background: #bdbdbd;
  }
  .cat__lines i:last-child {
    width: calc(var(--w) * 0.6);
  }
  .cat__ok {
    flex: none;
    display: grid;
    place-items: center;
    width: 6cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sun);
    transition: transform 0.5s var(--ease-spring);
  }
  .cat__ok svg {
    width: 60%;
    height: 60%;
    fill: none;
    stroke: #111;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pillar:hover .cat__ok {
    transform: scale(1.18);
  }
  .cat__hand {
    position: absolute;
    right: 6%;
    bottom: 12%;
    font-size: max(17px, 7cqw);
    line-height: 1;
    color: #333;
    transform: rotate(-6deg);
  }
  .pillar__art :global(.cat__arrow) {
    position: absolute;
    right: 20%;
    bottom: 26%;
    width: 14cqw;
    color: #555;
    transform: rotate(-150deg) scaleX(-1);
  }

  @media (max-width: 900px) {
    .emethod__grid {
      grid-template-columns: 1fr;
    }
    .pillar__art {
      height: auto;
      aspect-ratio: 1.6;
    }
  }

  .emethod.is-offscreen .flow__dot {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .flow__dot {
      animation: none;
    }
  }
</style>
