---
import Doodle from '../Doodle.astro';

interface Props {
  text: string;
  cta: string;
  href?: string;
  note?: string;
}
const { text, cta, href = '#aplicar', note } = Astro.props;
---

<div class="eband" data-reveal>
  <p class="eband__text">
    {note && <span class="eband__note hand">{note}</span>}
    {text}
  </p>
  <a class="ebtn ebtn--sun" href={href}>
    {cta}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
  </a>
  <Doodle name="sparkles" seed={text.length} class="eband__spark" onView duration={0.6} />
</div>

<style>
  .eband {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    margin-top: clamp(14px, 1.6vw, 26px);
    padding: clamp(22px, 2.6vw, 44px) clamp(22px, 3vw, 56px);
    border-radius: var(--radius-card);
    background:
      radial-gradient(ellipse 50% 140% at 100% 50%, rgba(254, 200, 26, 0.55) 0%, rgba(251, 220, 90, 0.3) 35%, rgba(242, 235, 189, 0) 80%),
      var(--card-warm);
    overflow: hidden;
  }
  .eband__text {
    font-size: clamp(22px, 2.3vw, 40px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .eband__note {
    display: block;
    margin-bottom: 4px;
    font-size: 0.7em;
    color: #7a7a7a;
    letter-spacing: 0;
  }
  .eband :global(.eband__spark) {
    position: absolute;
    right: 1.4%;
    top: 8%;
    width: clamp(34px, 3vw, 54px);
    color: #111;
    pointer-events: none;
  }
  @media (max-width: 700px) {
    .eband {
      flex-direction: column;
      align-items: flex-start;
    }
    .eband .ebtn {
      width: 100%;
    }
    .eband :global(.eband__spark) {
      top: 10px;
      right: 10px;
    }
  }
</style>
