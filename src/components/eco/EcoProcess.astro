---
import SectionHead from './SectionHead.astro';
import { useEcommerce } from '../../content/ecommerce';

const p = useEcommerce(Astro.currentLocale).process;
---

<section id="proceso" class="esec eproc" aria-labelledby="proc-title">
  <SectionHead note={p.note} title={p.title} id="proc-title" />

  <ol class="eproc__list">
    {
      p.steps.map((s, i) => (
        <li class="estep" data-reveal style={`--reveal-delay:${i * 0.07}s`}>
          <span class="estep__num">{i + 1}</span>
          <h3 class="estep__title">{s.title}</h3>
          <p class="estep__text">{s.text}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .eproc__list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(10px, 1vw, 16px);
    margin: clamp(34px, 4vw, 64px) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  /* hand-drawn-ish dashed track behind the numbers */
  .eproc__list::before {
    content: '';
    position: absolute;
    left: 4%;
    right: 4%;
    top: calc(clamp(18px, 1.8vw, 30px) + clamp(19px, 1.6vw, 26px));
    height: 3px;
    background-image: linear-gradient(90deg, #111 0 9px, transparent 9px 18px);
    background-size: 18px 3px;
    opacity: 0.22;
  }

  .estep {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(18px, 1.8vw, 30px);
    border-radius: var(--radius-bento);
    background: var(--card);
  }
  .estep:last-child {
    background:
      radial-gradient(ellipse 90% 80% at 100% 0%, rgba(254, 200, 26, 0.6) 0%, rgba(251, 220, 90, 0.32) 34%, rgba(242, 235, 189, 0) 80%),
      var(--card-warm);
  }
  .estep__num {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(38px, 3.2vw, 52px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #0b0b0b;
    color: var(--sun-text);
    font-size: clamp(16px, 1.3vw, 21px);
    font-weight: 600;
    box-shadow: 0 0 0 6px var(--card);
  }
  .estep:last-child .estep__num {
    box-shadow: 0 0 0 6px #f3ecd0;
  }
  .estep__title {
    margin-top: clamp(16px, 1.6vw, 26px);
    font-size: clamp(19px, 1.55vw, 27px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.015em;
  }
  .estep__text {
    margin-top: 8px;
    font-size: clamp(14.5px, 1.05vw, 17px);
    line-height: 1.42;
    color: var(--ink-soft);
  }

  @media (max-width: 1100px) {
    .eproc__list {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .eproc__list::before {
      left: calc(clamp(18px, 1.8vw, 30px) + clamp(19px, 1.6vw, 26px) - 1px);
      right: auto;
      top: 30px;
      bottom: 30px;
      width: 3px;
      height: auto;
      background-image: linear-gradient(180deg, #111 0 9px, transparent 9px 18px);
      background-size: 3px 18px;
    }
    .estep {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 16px;
    }
    .estep__num {
      grid-row: 1 / span 2;
    }
    .estep__title,
    .estep__text {
      grid-column: 2;
    }
    .estep__title {
      margin-top: 0;
    }
  }
</style>
