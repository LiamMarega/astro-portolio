---
import SectionHead from './SectionHead.astro';
import Doodle from '../Doodle.astro';
import { ecommerce } from '../../content/ecommerce';

const p = ecommerce.pricing;
---

<section id="planes" class="esec eprice" aria-labelledby="price-title">
  <SectionHead note={p.note} title={p.title} intro={p.intro} id="price-title" center />

  <div class="eprice__grid">
    {
      p.plans.map((plan, i) => (
        <article class:list={['plan', { 'plan--featured': plan.featured }]} data-reveal style={`--reveal-delay:${i * 0.07}s`}>
          {plan.badge && (
            <span class="plan__badge hand">
              {plan.badge}
              <Doodle name="sparkles" seed="badge" class="plan__spark" drawn />
            </span>
          )}
          <h3 class="plan__name">{plan.name}</h3>
          <p class="plan__for">{plan.for}</p>
          <p class="plan__price">
            {p.showPrices && plan.price ? (
              <>
                <small>{p.from}</small>
                <b>{plan.price}</b>
              </>
            ) : (
              <b class="plan__quote">{p.quote}</b>
            )}
          </p>
          <p class="plan__time">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5" />
              <path d="M12 7.5V12l3 2" />
            </svg>
            {plan.time}
          </p>
          <a class:list={['ebtn', 'plan__cta', { 'ebtn--sun': plan.featured }]} href="#aplicar" data-lf-set={`plan=${plan.name}`}>
            {plan.cta}
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6" />
            </svg>
          </a>
          <ul class="plan__features">
            {plan.features.map((f) => (
              <li>
                <span class="echeck">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 12.5l4 4 8-9" />
                  </svg>
                </span>
                {f}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <div class="eprice__foot" data-reveal>
    <p class="eprice__terms">{p.terms}</p>
    <ul class="eprice__trust">
      {
        p.trust.map((t) => (
          <li>
            <span class="echeck">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 12.5l4 4 8-9" />
              </svg>
            </span>
            {t}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .eprice__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: stretch;
    gap: clamp(10px, 1.09vw, 18px);
    margin-top: clamp(34px, 4vw, 64px);
  }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.6vw, 44px);
    border-radius: var(--radius-card);
    background: var(--card);
  }
  .plan--featured {
    background:
      radial-gradient(ellipse 80% 70% at 100% 0%, #fec81a 0%, #fcd13a 14%, #fbdc5a 28%, #f7e590 46%, #f2ebbd 64%, rgba(238, 237, 224, 0) 92%),
      #eeede0;
    box-shadow: 0 24px 60px rgba(160, 120, 0, 0.16);
    transform: translateY(-10px);
  }
  .plan__badge {
    position: absolute;
    right: clamp(18px, 2vw, 32px);
    top: -16px;
    padding: 0.18em 0.6em 0.26em;
    border-radius: 0.4em;
    background: #0b0b0b;
    color: var(--sun-text);
    font-size: clamp(20px, 1.6vw, 28px);
    line-height: 1;
    transform: rotate(4deg);
  }
  .plan__badge :global(.plan__spark) {
    position: absolute;
    right: -0.9em;
    top: -0.8em;
    width: 1.1em;
    color: #111;
  }
  .plan__name {
    font-size: clamp(28px, 2.5vw, 44px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .plan__for {
    min-height: 2.8em;
    margin-top: 10px;
    font-size: clamp(15px, 1.12vw, 18px);
    line-height: 1.4;
    color: var(--ink-soft);
  }
  .plan__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: clamp(18px, 2vw, 30px);
  }
  .plan__price small {
    font-size: clamp(15px, 1.1vw, 18px);
    color: #6f6f6f;
  }
  .plan__price b {
    font-size: clamp(36px, 3.3vw, 58px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .plan__price b.plan__quote {
    font-size: clamp(26px, 2.2vw, 38px);
    letter-spacing: -0.025em;
  }
  .plan__time {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: clamp(14.5px, 1.05vw, 17px);
    color: #444;
  }
  .plan__time svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .plan__cta {
    margin-top: clamp(20px, 2vw, 30px);
    width: 100%;
  }
  .plan__features {
    display: grid;
    gap: 12px;
    margin: clamp(22px, 2.2vw, 34px) 0 0;
    padding: clamp(18px, 1.8vw, 26px) 0 0;
    list-style: none;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  .plan__features li {
    display: flex;
    gap: 10px;
    font-size: clamp(15px, 1.08vw, 17.5px);
    line-height: 1.38;
    color: #2a2a2a;
  }
  .plan__features .echeck {
    margin-top: 1px;
  }

  .eprice__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 30px;
    margin-top: clamp(26px, 3vw, 44px);
  }
  .eprice__terms {
    font-size: clamp(16px, 1.25vw, 21px);
    font-weight: 500;
  }
  .eprice__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: clamp(15px, 1.1vw, 18px);
    color: #333;
  }
  .eprice__trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  @media (max-width: 1000px) {
    .eprice__grid {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
      gap: 26px;
    }
    .plan--featured {
      transform: none;
    }
    .plan__for {
      min-height: 0;
    }
  }
  @media (max-width: 760px) {
    .plan {
      border-radius: 22px;
    }
    .eprice__foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
