---
import SectionHead from './SectionHead.astro';
import { useEcommerce } from '../../content/ecommerce';

const f = useEcommerce(Astro.currentLocale).faq;
const half = Math.ceil(f.items.length / 2);
const cols = [f.items.slice(0, half), f.items.slice(half)];
---

<section id="faq" class="esec efaq" aria-labelledby="faq-title">
  <SectionHead note={f.note} title={f.title} id="faq-title" />

  <div class="efaq__cols">
    {
      cols.map((col) => (
        <div class="efaq__col">
          {col.map((it) => (
            <details class="qa" data-qa>
              <summary>
                <span>{it.q}</span>
                <i aria-hidden="true" />
              </summary>
              <div class="qa__a">
                <p>{it.a}</p>
              </div>
            </details>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .efaq__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.09vw, 18px);
    align-items: start;
    margin-top: clamp(34px, 4vw, 64px);
  }
  .efaq__col {
    display: grid;
    gap: clamp(10px, 1.09vw, 18px);
  }
  .qa {
    border-radius: var(--radius-bento);
    background: var(--card);
    transition: background 0.3s ease;
  }
  .qa[open] {
    background: var(--card-warm);
  }
  .qa summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: clamp(18px, 1.8vw, 30px) clamp(18px, 2vw, 32px);
    font-size: clamp(17px, 1.35vw, 23px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
    list-style: none;
    cursor: pointer;
    border-radius: inherit;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa summary i {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #0b0b0b;
    transition:
      transform 0.4s var(--ease-spring),
      background 0.3s ease;
  }
  .qa summary i::before,
  .qa summary i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--sun);
    transform: translate(-50%, -50%);
  }
  .qa summary i::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform 0.3s ease;
  }
  .qa[open] summary i {
    transform: rotate(180deg);
    background: var(--sun);
  }
  .qa[open] summary i::before,
  .qa[open] summary i::after {
    background: #111;
  }
  .qa[open] summary i::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .qa__a {
    overflow: hidden;
  }
  .qa__a p {
    padding: 0 clamp(18px, 2vw, 32px) clamp(20px, 2vw, 30px);
    max-width: 34em;
    font-size: clamp(15.5px, 1.15vw, 19px);
    line-height: 1.5;
    color: var(--ink-soft);
  }
  @media (max-width: 860px) {
    .efaq__cols {
      grid-template-columns: 1fr;
    }
  }
</style>
