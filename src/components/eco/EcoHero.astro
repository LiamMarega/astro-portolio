---
import StickerWord from '../StickerWord.astro';
import Sticker from '../EcoSticker.astro';
import Doodle from '../Doodle.astro';
import Keycap from '../Keycap.astro';
import { useEcommerce, SHOT } from '../../content/ecommerce';

const e = useEcommerce(Astro.currentLocale);
const h = e.hero;
const v = h.visual;
const stores = e.stores;
---

<section class="ehero" data-ehero aria-labelledby="ehero-title">
  <div class="ehero__inner">
    <div class="ehero__copy">
      {
        h.availability && (
          <p class="ehero__avail">
            <i aria-hidden="true" />
            {h.availability}
          </p>
        )
      }

      <h1 id="ehero-title" class="ehero__title" data-ink>
        <span class="ehero__lead">{h.titleLead}</span>{' '}
        <span class="sr-only">{h.titleWord}</span>
        <span class="ehero__row">
          <StickerWord text={h.titleWord} stickers={h.stickers} uid="hw" class="ehero__word" />
          <span class="ehero__note hand" aria-hidden="true">
            <Doodle name="bigArrow" seed="hn" class="ehero__note-arrow" drawn />
            {h.note}
          </span>
        </span>
      </h1>

      <p class="ehero__sub">{h.sub}</p>

      <div class="ehero__ctas">
        <Keycap href={e.contactHref} label={h.cta} w="clamp(250px, 21.5vw, 350px)" doodles="top" />
        <a class="ehero__more" href="#casos">
          {h.secondary}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
        </a>
      </div>
      <p class="ehero__ctanote">{h.ctaNote}</p>

      <ul class="ehero__trust">
        {
          h.trust.map((t) => (
            <li>
              <span class="echeck">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6 12.5l4 4 8-9" />
                </svg>
              </span>
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="ehero__visual" role="group" aria-label={v.label} data-ehero-visual data-stores={JSON.stringify(stores.map((s) => ({ host: s.host, name: s.name, url: s.url, alt: s.alt.site })))}>
      <figure class="ehero__shot">
        <div class="ehero__bar" aria-hidden="true">
          <i /><i /><i />
          <span class="ehero__url" data-ehero-url>{stores[0].host}</span>
        </div>
        <div class="ehero__screen" style={`aspect-ratio:${SHOT.site.w}/${SHOT.site.h}`}>
          {
            stores.map((s, i) => (
              <img
                class:list={['ehero__img', { 'is-on': i === 0 }]}
                src={`/img/ecommerce/${s.id}-site.webp`}
                alt={i === 0 ? s.alt.site : ''}
                data-store={s.host}
                width={SHOT.site.w}
                height={SHOT.site.h}
                fetchpriority={i === 0 ? 'high' : 'low'}
                decoding="async"
                draggable="false"
              />
            ))
          }
        </div>
      </figure>

      <figure class="ehero__phone">
        <div class="ehero__phone-screen" style={`aspect-ratio:${SHOT.phone.w}/${SHOT.phone.h}`}>
          {
            stores.map((s, i) => (
              <img
                class:list={['ehero__img', { 'is-on': i === 0 }]}
                src={`/img/ecommerce/${s.id}-phone.webp`}
                alt=""
                width={SHOT.phone.w}
                height={SHOT.phone.h}
                fetchpriority={i === 0 ? 'high' : 'low'}
                decoding="async"
                draggable="false"
              />
            ))
          }
        </div>
      </figure>

      <div class="ehero__counter">
        <small>{v.badge.label}</small>
        <b>{v.badge.value}</b>
        <a class="ehero__live" href={stores[0].url} target="_blank" rel="noopener" data-ehero-live data-live={v.live}>{v.live} · {stores[0].name}</a>
      </div>

      <p class="ehero__vnote hand" aria-hidden="true">
        {v.note}
        <Doodle name="bigArrow" seed="hv" class="ehero__vnote-arrow" drawn />
      </p>

      <span class="ehero__stk ehero__stk--cart" aria-hidden="true"><Sticker type="cart" uid="hs-cart" /></span>
      <span class="ehero__stk ehero__stk--star" aria-hidden="true"><Sticker type="star" uid="hs-star" /></span>
      <span class="ehero__stk ehero__stk--tag" aria-hidden="true"><Sticker type="tag" uid="hs-tag" /></span>
    </div>
  </div>
</section>

<style>
  .ehero {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    padding: clamp(100px, 9.6vw, 150px) 0 clamp(30px, 4vw, 70px);
  }

  .ehero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
    align-items: center;
    gap: clamp(24px, 3.6vw, 70px);
    width: min(92vw, 1640px);
    margin: 0 auto;
  }

  /* ── copy ── */
  .ehero__avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 15px 7px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.62);
    border: 1px solid rgba(0, 0, 0, 0.06);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-size: clamp(14px, 1vw, 16px);
    font-weight: 480;
    color: #2b2b2b;
  }
  .ehero__avail i {
    position: relative;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #1fb35c;
  }
  .ehero__avail i::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid #1fb35c;
    opacity: 0;
    animation: avail-ping 2.2s ease-out infinite;
  }
  @keyframes avail-ping {
    0% {
      transform: scale(0.5);
      opacity: 0.7;
    }
    80%,
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .ehero__title {
    position: relative;
    margin-top: clamp(16px, 1.6vw, 26px);
    font-size: clamp(36px, 4.25vw, 78px);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .ehero__lead {
    display: block;
    max-width: 12em;
    text-wrap: balance;
  }
  .ehero__row {
    display: flex;
    align-items: flex-end;
    gap: 0.3em;
  }
  .ehero__title :global(.ehero__word) {
    font-size: 2.35em;
    line-height: 0.92;
    letter-spacing: -0.065em;
    margin-left: -0.04em;
  }

  .ehero__note {
    position: relative;
    max-width: 6.4em;
    margin-bottom: 0.7em;
    font-size: clamp(21px, 1.9vw, 34px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    color: #7d7d7d;
    transform: rotate(-6deg);
  }
  .ehero__note :global(.ehero__note-arrow) {
    display: block;
    width: 2.3em;
    margin: 0 0 0.2em -0.5em;
    color: #8a8a8a;
    transform: rotate(192deg);
  }

  .ehero__sub {
    max-width: 29em;
    margin-top: clamp(18px, 2vw, 32px);
    font-size: clamp(17px, 1.4vw, 24px);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .ehero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px clamp(26px, 2.6vw, 44px);
    margin-top: clamp(30px, 3.2vw, 52px);
    padding-left: 4px;
  }
  .ehero__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: clamp(16px, 1.2vw, 20px);
    font-weight: 480;
    color: #222;
    text-decoration: underline;
    text-decoration-color: rgba(0, 0, 0, 0.2);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.2s ease;
  }
  .ehero__more:hover {
    text-decoration-color: currentColor;
  }
  .ehero__more svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s var(--ease-spring);
  }
  .ehero__more:hover svg {
    transform: translateY(3px);
  }
  .ehero__ctanote {
    margin-top: clamp(22px, 2vw, 30px);
    font-size: clamp(14px, 1vw, 16px);
    color: #6f6f6f;
  }

  .ehero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: clamp(18px, 1.8vw, 28px) 0 0;
    padding: 0;
    list-style: none;
    font-size: clamp(15px, 1.05vw, 17px);
    font-weight: 470;
    color: #2a2a2a;
  }
  .ehero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* ── visual: store + orders coming in ── */
  .ehero__visual {
    position: relative;
    aspect-ratio: 1 / 0.86;
    container-type: inline-size;
  }

  /* browser window with a real store screenshot (cycles through the stores) */
  .ehero__shot {
    position: absolute;
    left: 0;
    top: 2%;
    width: 86%;
    margin: 0;
    overflow: hidden;
    border-radius: 2.2cqw;
    background: #fff;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.06),
      0 24px 60px rgba(140, 100, 0, 0.18);
    transform: rotate(-2.2deg);
  }
  .ehero__bar {
    display: flex;
    align-items: center;
    gap: 0.9cqw;
    padding: 1.5cqw 2cqw;
    background: #f1f1f1;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .ehero__bar i {
    width: 1.5cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #d4d4d4;
  }
  .ehero__bar i:nth-child(1) {
    background: #ff6159;
  }
  .ehero__bar i:nth-child(2) {
    background: #ffbd2e;
  }
  .ehero__bar i:nth-child(3) {
    background: #28c941;
  }
  .ehero__url {
    flex: 1;
    max-width: 52%;
    margin-left: 1.4cqw;
    padding: 0.5cqw 1.6cqw;
    overflow: hidden;
    border-radius: 999px;
    background: #fff;
    font-size: max(9.5px, 1.6cqw);
    color: #6d6d6d;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ehero__screen,
  .ehero__phone-screen {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #eee;
  }
  .ehero__img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    opacity: 0;
    transition: opacity 0.7s ease;
    user-select: none;
  }
  .ehero__screen .ehero__img {
    aspect-ratio: 1440 / 900;
  }
  .ehero__phone-screen .ehero__img {
    aspect-ratio: 600 / 1298;
  }
  .ehero__img.is-on {
    opacity: 1;
  }

  .ehero__phone {
    position: absolute;
    right: 4%;
    bottom: 0;
    z-index: 4;
    width: 24%;
    margin: 0;
    padding: 0.9cqw;
    border-radius: 4.2cqw;
    background: #111;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.12),
      0 20px 44px rgba(0, 0, 0, 0.28);
    transform: rotate(3deg);
  }
  .ehero__phone-screen {
    border-radius: 3.4cqw;
  }

  .ehero__counter {
    position: absolute;
    left: 3%;
    bottom: 3%;
    z-index: 5;
    display: grid;
    gap: 0.4cqw;
    max-width: 44%;
    padding: 2.2cqw 2.6cqw 2.4cqw;
    border-radius: 3cqw;
    background: #fff;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.06),
      0 14px 34px rgba(0, 0, 0, 0.12);
    transform: rotate(-2.4deg);
  }
  .ehero__counter small {
    font-size: max(11px, 1.9cqw);
    color: #8a8a8a;
  }
  .ehero__counter b {
    font-size: max(24px, 6cqw);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #111;
  }
  .ehero__live {
    margin-top: 0.6cqw;
    overflow: hidden;
    font-size: max(11px, 1.9cqw);
    font-weight: 500;
    color: #111;
    text-decoration: underline;
    text-decoration-color: rgba(0, 0, 0, 0.25);
    text-underline-offset: 0.2em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ehero__live:hover {
    text-decoration-color: currentColor;
  }

  .ehero__vnote {
    position: absolute;
    right: 3%;
    top: -5%;
    z-index: 3;
    font-size: max(20px, 4.2cqw);
    line-height: 1;
    color: #7d7d7d;
    transform: rotate(-4deg);
  }
  .ehero__vnote :global(.ehero__vnote-arrow) {
    display: block;
    width: 2.6em;
    margin: 0.15em 0 0 3.2em;
    color: #8a8a8a;
    transform: rotate(12deg);
  }

  .ehero__stk {
    position: absolute;
    z-index: 5;
    display: block;
    animation: float 6s ease-in-out infinite;
  }
  .ehero__stk :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 2px 1px rgba(0, 0, 0, 0.16)) drop-shadow(0 8px 10px rgba(0, 0, 0, 0.14));
  }
  .ehero__stk--cart {
    left: -4%;
    top: -6%;
    width: 17%;
  }
  .ehero__stk--star {
    left: 38%;
    top: -9%;
    width: 13%;
    animation-duration: 7s;
    animation-delay: -2s;
  }
  .ehero__stk--tag {
    left: 46%;
    bottom: 0%;
    width: 11%;
    animation-duration: 5.4s;
    animation-delay: -1s;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-6px) rotate(-3deg);
    }
  }

  @media (max-width: 1100px) and (min-width: 901px) {
    .ehero__title {
      font-size: 3.9vw;
    }
  }

  @media (max-width: 900px) {
    .ehero {
      min-height: 0;
      padding-top: 96px;
    }
    .ehero__inner {
      grid-template-columns: 1fr;
      width: calc(100% - 32px);
      gap: 46px;
    }
    .ehero__title {
      font-size: clamp(34px, 8.6vw, 56px);
    }
    .ehero__title :global(.ehero__word) {
      font-size: 2.3em;
    }
    .ehero__note {
      max-width: 5em;
      margin-bottom: 0.5em;
      font-size: clamp(19px, 4.8vw, 28px);
    }
    .ehero__note :global(.ehero__note-arrow) {
      width: 1.8em;
    }
    .ehero__visual {
      width: 100%;
      max-width: 640px;
      margin: 0 auto;
    }
  }

  @media (max-width: 560px) {
    .ehero__ctas {
      flex-direction: column;
      align-items: flex-start;
      gap: 26px;
    }
    .ehero__ctas :global(.key) {
      --w: min(calc(100vw - 60px), 310px) !important;
    }
    .ehero__visual {
      aspect-ratio: 1 / 1.02;
    }
    .ehero__shot {
      width: 94%;
    }
    .ehero__phone {
      right: 0;
      width: 31%;
    }
    .ehero__counter {
      left: -1%;
      bottom: 2%;
      max-width: 62%;
    }
    .ehero__vnote {
      display: none;
    }
    .ehero__stk--cart {
      width: 19%;
      left: -3%;
      top: -9%;
    }
    .ehero__stk--star {
      width: 15%;
      left: auto;
      right: -1%;
      top: -8%;
    }
    .ehero__stk--tag {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ehero__stk,
    .ehero__avail i::after {
      animation: none;
    }
  }
</style>
