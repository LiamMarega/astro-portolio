---
import StickerWord from '../StickerWord.astro';
import Sticker from '../EcoSticker.astro';
import Doodle from '../Doodle.astro';
import Keycap from '../Keycap.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { useEcommerce } from '../../content/ecommerce';
import { responsiveImage, ECO_HERO_POSTER_SIZES } from '../../lib/responsive';

const e = useEcommerce(Astro.currentLocale);
const h = e.hero;
const v = h.visual;
const m = v.media;
// Phone rendition by naming convention (nochats-hero.mp4 -> nochats-hero-704.mp4), only when the file exists.
// The poster gets its srcset from the same helper (nochats-hero-poster-640.webp).
const small = (file: string) => {
  const f = file.replace(/(\.[a-z0-9]+)$/i, '-704$1');
  return existsSync(join(process.cwd(), 'public', f)) ? f : undefined;
};
const poster = await responsiveImage(m.poster, ECO_HERO_POSTER_SIZES, m.w);
---

<section class="ehero" data-ehero data-pause-offscreen aria-labelledby="ehero-title">
  <div class="ehero__inner">
    <div class="ehero__copy">
      {
        h.availability && (
          <p class="ehero__avail">
            <i aria-hidden="true" />
            {h.availability}
          </p>
        )
      }

      {/*
        The h1 holds one clean sentence (visually hidden, clip-based like the home hero); the per-letter sticker
        markup is decorative and aria-hidden, and lives OUTSIDE the h1 so its textContent stays readable for crawlers.
      */}
      <div class="ehero__head" data-ink>
        <h1 id="ehero-title" class="sr-only">{h.titleLead} {h.titleWord}</h1>
        <div class="ehero__title" aria-hidden="true">
          <span class="ehero__lead">{h.titleLead}</span>
          <span class="ehero__row">
            <StickerWord text={h.titleWord} stickers={h.stickers} uid="hw" class="ehero__word" />
            <span class="ehero__note hand">
              <Doodle name="bigArrow" seed="hn" class="ehero__note-arrow" drawn />
              {h.note}
            </span>
          </span>
        </div>
      </div>

      <p class="ehero__sub">{h.sub}</p>

      <div class="ehero__ctas">
        <Keycap href={e.contactHref} label={h.cta} w="clamp(250px, 21.5vw, 350px)" doodles="top" />
        <a class="ehero__more" href="#casos">
          {h.secondary}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
        </a>
      </div>
      <p class="ehero__ctanote">{h.ctaNote}</p>

      <ul class="ehero__trust">
        {
          h.trust.map((t) => (
            <li>
              <span class="echeck">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6 12.5l4 4 8-9" />
                </svg>
              </span>
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    {/*
      Silent, decorative screen recording. The frame is aria-hidden (nothing to operate, no audio, no controls) and the
      figcaption carries the text alternative: a visible caption plus a visually hidden description of the motion.
      Poster = LCP candidate (<img>, intrinsic size, fetchpriority high); the video only loads from src/scripts/ehero.ts.
    */}
    <figure class="ehero__visual" data-ehero-visual>
      <div class="ehero__shot" aria-hidden="true">
        <div class="ehero__bar">
          <i /><i /><i />
          <span class="ehero__url">{v.bar}</span>
        </div>
        <div class="ehero__screen" style={`aspect-ratio:${m.w}/${m.h}`}>
          <img class="ehero__poster" {...poster} width={m.w} height={m.h} alt="" fetchpriority="high" decoding="async" draggable="false" />
          <video
            class="ehero__video"
            data-ehero-video
            data-webm={m.webm}
            data-mp4={m.mp4}
            data-webm-sm={small(m.webm)}
            data-mp4-sm={small(m.mp4)}
            width={m.w}
            height={m.h}
            muted
            loop
            playsinline
            disablepictureinpicture
            disableremoteplayback
            preload="none"
            tabindex="-1"
          >
          </video>
        </div>
      </div>
      <span class="ehero__base" aria-hidden="true"></span>

      <figcaption class="ehero__cap">
        <span class="sr-only">{v.desc} </span>
        <small>{v.kicker}</small>
        <b>{v.name}</b>
        <span class="ehero__cap-detail">{v.detail}</span>
      </figcaption>

      <p class="ehero__vnote hand" aria-hidden="true">
        {v.note}
        <Doodle name="bigArrow" seed="hv" class="ehero__vnote-arrow" drawn />
      </p>

      <span class="ehero__stk ehero__stk--cart" aria-hidden="true"><Sticker type="cart" uid="hs-cart" /></span>
      <span class="ehero__stk ehero__stk--star" aria-hidden="true"><Sticker type="star" uid="hs-star" /></span>
      <span class="ehero__stk ehero__stk--tag" aria-hidden="true"><Sticker type="tag" uid="hs-tag" /></span>
    </figure>
  </div>
</section>

<style>
  .ehero {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    padding: clamp(100px, 9.6vw, 150px) 0 clamp(30px, 4vw, 70px);
    contain: layout style;
  }

  .ehero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 3.6vw, 70px);
    width: min(92vw, 1640px);
    margin: 0 auto;
  }

  /* ── copy ── */
  .ehero__avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 15px 7px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.62);
    border: 1px solid rgba(0, 0, 0, 0.06);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-size: clamp(14px, 1vw, 16px);
    font-weight: 480;
    color: #2b2b2b;
  }
  .ehero__avail i {
    position: relative;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #1fb35c;
  }
  .ehero__avail i::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid #1fb35c;
    opacity: 0;
    animation: avail-ping 2.2s ease-out infinite;
  }
  @keyframes avail-ping {
    0% {
      transform: scale(0.5);
      opacity: 0.7;
    }
    80%,
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .ehero__title {
    position: relative;
    margin-top: clamp(16px, 1.6vw, 26px);
    font-size: clamp(34px, 3.3vw, 62px);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .ehero__lead {
    display: block;
    max-width: 8.6em;
    text-wrap: balance;
  }
  .ehero__row {
    display: flex;
    align-items: flex-end;
    gap: 0.3em;
  }
  .ehero__title :global(.ehero__word) {
    font-size: 2.3em;
    line-height: 0.92;
    letter-spacing: -0.065em;
    margin-left: -0.04em;
  }

  .ehero__note {
    position: relative;
    max-width: 6.4em;
    margin-bottom: 0.7em;
    font-size: clamp(21px, 1.9vw, 34px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    color: #7d7d7d;
    transform: rotate(-6deg);
  }
  .ehero__note :global(.ehero__note-arrow) {
    display: block;
    width: 2.3em;
    margin: 0 0 0.2em -0.5em;
    color: #8a8a8a;
    transform: rotate(192deg);
  }

  .ehero__sub {
    max-width: 29em;
    margin-top: clamp(18px, 2vw, 32px);
    font-size: clamp(17px, 1.4vw, 24px);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .ehero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px clamp(26px, 2.6vw, 44px);
    margin-top: clamp(30px, 3.2vw, 52px);
    padding-left: 4px;
  }
  .ehero__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: clamp(16px, 1.2vw, 20px);
    font-weight: 480;
    color: #222;
    text-decoration: underline;
    text-decoration-color: rgba(0, 0, 0, 0.2);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.2s ease;
  }
  .ehero__more:hover {
    text-decoration-color: currentColor;
  }
  .ehero__more svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s var(--ease-spring);
  }
  .ehero__more:hover svg {
    transform: translateY(3px);
  }
  .ehero__ctanote {
    margin-top: clamp(22px, 2vw, 30px);
    font-size: clamp(14px, 1vw, 16px);
    color: #6f6f6f;
  }

  .ehero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: clamp(18px, 1.8vw, 28px) 0 0;
    padding: 0;
    list-style: none;
    font-size: clamp(15px, 1.05vw, 17px);
    font-weight: 470;
    color: #2a2a2a;
  }
  .ehero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* ── visual: the screen recording is the star of the hero ── */
  .ehero__visual {
    position: relative;
    align-self: start;
    margin: clamp(48px, 5.6vw, 96px) 0 0;
    container-type: inline-size;
  }

  /* browser window around the recording (poster underneath, video fades in on top) */
  .ehero__shot {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 1.6cqw;
    background: #05030d;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.06),
      0 3cqw 7cqw rgba(110, 70, 0, 0.3),
      0 0.6cqw 1.6cqw rgba(0, 0, 0, 0.18);
    transform: rotate(-1.6deg);
  }
  .ehero__bar {
    display: flex;
    align-items: center;
    gap: 0.7cqw;
    padding: 1.1cqw 1.6cqw;
    background: #f1f1f1;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .ehero__bar i {
    width: 1.1cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #d4d4d4;
  }
  .ehero__bar i:nth-child(1) {
    background: #ff6159;
  }
  .ehero__bar i:nth-child(2) {
    background: #ffbd2e;
  }
  .ehero__bar i:nth-child(3) {
    background: #28c941;
  }
  .ehero__url {
    flex: 1;
    max-width: 36%;
    margin-left: 1.2cqw;
    padding: 0.4cqw 1.4cqw;
    overflow: hidden;
    border-radius: 999px;
    background: #fff;
    font-size: max(9.5px, 1.25cqw);
    color: #6d6d6d;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ehero__screen {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #05030d;
  }
  .ehero__poster,
  .ehero__video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }
  .ehero__video {
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  .ehero__video.is-playing {
    opacity: 1;
  }

  /* laptop base under the window: a thin hinge and a lip */
  .ehero__base {
    position: relative;
    display: block;
    width: 112%;
    height: 1.6cqw;
    margin: 0.6cqw 0 0 -6%;
    border-radius: 0 0 2.4cqw 2.4cqw;
    background: linear-gradient(#e7e7ea, #b9b9c0);
    box-shadow: 0 2cqw 3.4cqw rgba(110, 70, 0, 0.22);
    transform: rotate(-1.6deg);
  }
  .ehero__base::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 16%;
    height: 55%;
    border-radius: 0 0 1cqw 1cqw;
    background: #a1a1a8;
    transform: translateX(-50%);
  }

  .ehero__cap {
    position: absolute;
    left: -2%;
    bottom: -5%;
    z-index: 5;
    display: grid;
    gap: 0.3cqw;
    max-width: 38%;
    padding: 1.6cqw 2cqw 1.8cqw;
    border-radius: 2cqw;
    background: #fff;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.06),
      0 14px 34px rgba(0, 0, 0, 0.14);
    transform: rotate(-2.4deg);
  }
  .ehero__cap small {
    font-size: max(11px, 1.4cqw);
    color: #8a8a8a;
  }
  .ehero__cap b {
    font-size: max(18px, 3cqw);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #111;
  }
  .ehero__cap-detail {
    font-size: max(11px, 1.4cqw);
    font-weight: 500;
    color: #2b2b2b;
  }

  .ehero__vnote {
    position: absolute;
    right: 2%;
    top: -11%;
    z-index: 3;
    font-size: max(20px, 3cqw);
    line-height: 1;
    color: #7d7d7d;
    transform: rotate(-4deg);
  }
  .ehero__vnote :global(.ehero__vnote-arrow) {
    display: block;
    width: 2.6em;
    margin: 0.15em 0 0 3.2em;
    color: #8a8a8a;
    transform: rotate(12deg);
  }

  .ehero__stk {
    position: absolute;
    z-index: 5;
    display: block;
    animation: float 6s ease-in-out infinite;
  }
  .ehero__stk :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 2px 1px rgba(0, 0, 0, 0.16)) drop-shadow(0 8px 10px rgba(0, 0, 0, 0.14));
  }
  .ehero__stk--cart {
    left: -4%;
    top: -9%;
    width: 11%;
  }
  .ehero__stk--star {
    left: 40%;
    top: -11%;
    width: 9%;
    animation-duration: 7s;
    animation-delay: -2s;
  }
  .ehero__stk--tag {
    right: 2%;
    bottom: -8%;
    width: 8%;
    animation-duration: 5.4s;
    animation-delay: -1s;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-6px) rotate(-3deg);
    }
  }

  @media (max-width: 1100px) and (min-width: 901px) {
    .ehero__inner {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1fr);
    }
    .ehero__vnote {
      display: none;
    }
    .ehero__title {
      font-size: 3.5vw;
    }
  }

  @media (max-width: 900px) {
    .ehero {
      min-height: 0;
      padding-top: 96px;
    }
    .ehero__inner {
      grid-template-columns: 1fr;
      width: calc(100% - 32px);
      gap: 0;
    }
    /* phones: headline and intro first, then the recording, then the calls to action */
    .ehero__copy {
      display: contents;
    }
    .ehero__avail {
      order: 1;
      justify-self: start;
    }
    .ehero__head {
      order: 2;
    }
    .ehero__sub {
      order: 3;
    }
    .ehero__visual {
      order: 4;
    }
    .ehero__ctas {
      order: 5;
    }
    .ehero__ctanote {
      order: 6;
    }
    .ehero__trust {
      order: 7;
    }
    .ehero__title {
      font-size: clamp(34px, 8.6vw, 56px);
    }
    .ehero__lead {
      max-width: 12em;
    }
    .ehero__title :global(.ehero__word) {
      font-size: 2.3em;
    }
    .ehero__note {
      max-width: 5em;
      margin-bottom: 0.5em;
      font-size: clamp(19px, 4.8vw, 28px);
    }
    .ehero__note :global(.ehero__note-arrow) {
      width: 1.8em;
    }
    .ehero__visual {
      width: 100%;
      margin: 40px 0 clamp(54px, 15vw, 80px);
      align-self: auto;
    }
  }

  @media (max-width: 560px) {
    .ehero__ctas {
      flex-direction: column;
      align-items: flex-start;
      gap: 26px;
    }
    .ehero__ctas :global(.key) {
      --w: min(calc(100vw - 60px), 310px) !important;
    }
    .ehero__bar {
      padding: 2cqw 2.6cqw;
    }
    .ehero__bar i {
      width: 1.8cqw;
    }
    .ehero__url {
      font-size: max(9px, 2.2cqw);
    }
    .ehero__base {
      width: 104%;
      margin-left: -2%;
    }
    .ehero__cap {
      left: 0;
      bottom: -12%;
      max-width: 62%;
      padding: 2.6cqw 3cqw 2.8cqw;
    }
    .ehero__cap small,
    .ehero__cap-detail {
      font-size: max(11px, 2.8cqw);
    }
    .ehero__cap b {
      font-size: max(18px, 5cqw);
    }
    .ehero__vnote {
      display: none;
    }
    .ehero__stk--cart {
      width: 15%;
      left: -3%;
      top: -12%;
    }
    .ehero__stk--star {
      width: 12%;
      left: auto;
      right: -1%;
      top: -11%;
    }
    .ehero__stk--tag {
      width: 11%;
      right: 3%;
      bottom: -10%;
    }
  }

  .ehero.is-offscreen .ehero__stk,
  .ehero.is-offscreen .ehero__avail i::after {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .ehero__stk,
    .ehero__avail i::after {
      animation: none;
    }
    .ehero__video {
      transition: none;
    }
  }
</style>
