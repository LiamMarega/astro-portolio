---
import SectionHead from './SectionHead.astro';
import Doodle from '../Doodle.astro';
import { ecommerce } from '../../content/ecommerce';

const t = ecommerce.testimonials;
const initials = (n: string) =>
  n
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .replace(/[^\p{L}]/gu, '')
    .slice(0, 2)
    .toUpperCase();
const tilt = [-1.2, 0.9, 0.7, -0.8];
---

<section class="esec equotes" aria-labelledby="quotes-title">
  <SectionHead note={t.note} title={t.title} id="quotes-title" />

  <ul class="equotes__grid">
    {
      t.items.map((q, i) => (
        <li class="equote" data-reveal style={`--reveal-delay:${(i % 2) * 0.08}s;--tilt:${tilt[i % tilt.length]}deg;--tone:${q.tone}`}>
          <figure>
            <Doodle name="quote" seed={`q${i}`} class="equote__mark" onView duration={0.5} />
            <span class="equote__stars" aria-label="5 de 5 estrellas">
              ★★★★★
            </span>
            <blockquote>
              <p>{q.quote}</p>
            </blockquote>
            <figcaption>
              <span class="equote__avatar" aria-hidden="true">
                {initials(q.name)}
              </span>
              <span>
                <b>{q.name}</b>
                <small>{q.role}</small>
              </span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .equotes__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(12px, 1.4vw, 24px);
    margin: clamp(34px, 4vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }
  .equote figure {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding: clamp(22px, 2.6vw, 46px);
    border-radius: var(--radius-bento);
    background: var(--card);
    transform: rotate(var(--tilt));
    transition: transform 0.6s var(--ease-spring);
  }
  @media (hover: hover) and (pointer: fine) {
    .equote figure:hover {
      transform: rotate(0deg) translateY(-4px);
    }
  }
  .equote figure :global(.equote__mark) {
    position: absolute;
    right: clamp(18px, 2vw, 34px);
    top: clamp(18px, 2vw, 34px);
    width: clamp(44px, 4vw, 70px);
    color: #c9c9c9;
  }
  .equote__stars {
    font-size: clamp(16px, 1.3vw, 22px);
    letter-spacing: 2px;
    color: #f5b400;
  }
  .equote blockquote {
    flex: 1;
    margin: clamp(14px, 1.4vw, 22px) 0 0;
  }
  .equote blockquote p {
    font-size: clamp(19px, 1.85vw, 32px);
    font-weight: 450;
    line-height: 1.3;
    letter-spacing: -0.012em;
    color: #151515;
  }
  .equote figcaption {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: clamp(20px, 2.2vw, 36px);
  }
  .equote__avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(42px, 3.4vw, 56px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--tone);
    border: 3px solid #fff;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    font-size: clamp(14px, 1.1vw, 18px);
    font-weight: 600;
    color: #111;
  }
  .equote figcaption b {
    display: block;
    font-size: clamp(16px, 1.2vw, 20px);
    font-weight: 560;
  }
  .equote figcaption small {
    display: block;
    font-size: clamp(14px, 1vw, 17px);
    color: var(--ink-mute);
  }

  @media (max-width: 760px) {
    .equotes__grid {
      grid-template-columns: 1fr;
    }
    .equote figure {
      transform: rotate(calc(var(--tilt) * 0.6));
    }
  }
</style>
