---
import * as lucide from 'lucide-static';
import SectionHead from './SectionHead.astro';
import { ecommerce } from '../../content/ecommerce';

const p = ecommerce.pains;
const icon = (name: string) =>
  ((lucide as Record<string, string>)[name] ?? '').replace(/\s(width|height)="24"/g, '').replace('class="', 'aria-hidden="true" focusable="false" class="');
---

<section class="esec epains" aria-labelledby="pains-title" data-pains data-copy={JSON.stringify({ idle: p.idle, one: p.one, some: p.some, all: p.all })}>
  <SectionHead note={p.note} title={p.title} id="pains-title" center />

  <ul class="epains__grid">
    {
      p.items.map((it, i) => (
        <li data-reveal style={`--reveal-delay:${(i % 3) * 0.06}s`}>
          <button class="epain" type="button" aria-pressed="false" data-pain={it.title}>
            <span class="epain__icon" set:html={icon(it.icon)} />
            <span class="epain__title">{it.title}</span>
            <span class="epain__text">{it.text}</span>
            <span class="epain__tick" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M6 12.5l4 4 8-9" />
              </svg>
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  <div class="epains__foot">
    <p class="epains__msg hand" data-pains-msg aria-live="polite">{p.idle}</p>
    <a class="ebtn" href="#aplicar" data-pains-cta>
      {p.cta}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
    </a>
  </div>
</section>

<style>
  .epains__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(10px, 1.09vw, 18px);
    margin: clamp(34px, 4vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }
  .epains__grid li {
    display: flex;
  }

  .epain {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto 1fr;
    gap: 6px 16px;
    width: 100%;
    padding: clamp(18px, 2vw, 32px);
    padding-right: clamp(46px, 3.6vw, 60px);
    border-radius: var(--radius-bento);
    background: var(--card);
    text-align: left;
    transition:
      background 0.3s ease,
      transform 0.45s var(--ease-spring),
      box-shadow 0.3s ease;
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: hover) and (pointer: fine) {
    .epain:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.06);
    }
  }
  .epain__icon {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: clamp(42px, 3.4vw, 54px);
    aspect-ratio: 1;
    border-radius: 26%;
    background: #0b0b0b;
    color: #fff;
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }
  .epain__icon :global(svg) {
    width: 52%;
    height: 52%;
    stroke-width: 1.8;
  }
  .epain__title {
    align-self: center;
    font-size: clamp(18px, 1.5vw, 26px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #111;
  }
  .epain__text {
    font-size: clamp(15px, 1.12vw, 18px);
    line-height: 1.42;
    color: var(--ink-soft);
  }
  .epain__tick {
    position: absolute;
    right: clamp(14px, 1.4vw, 22px);
    top: clamp(14px, 1.4vw, 22px);
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1.5px solid #cfcfcf;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      transform 0.4s var(--ease-spring);
  }
  .epain__tick svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: #111;
    stroke-width: 2.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 20;
    stroke-dashoffset: 20;
    transition: stroke-dashoffset 0.35s var(--ease-out);
  }

  .epain[aria-pressed='true'] {
    background:
      radial-gradient(ellipse 80% 90% at 100% 0%, rgba(254, 200, 26, 0.55) 0%, rgba(251, 220, 90, 0.35) 30%, rgba(242, 235, 189, 0) 75%),
      var(--card-warm);
  }
  .epain[aria-pressed='true'] .epain__icon {
    background: var(--sun);
    color: #111;
  }
  .epain[aria-pressed='true'] .epain__tick {
    background: var(--sun);
    border-color: var(--sun);
    transform: scale(1.08);
  }
  .epain[aria-pressed='true'] .epain__tick svg {
    stroke-dashoffset: 0;
  }

  .epains__foot {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px 30px;
    margin-top: clamp(28px, 3vw, 48px);
  }
  .epains__msg {
    font-size: clamp(22px, 2vw, 34px);
    line-height: 1.1;
    color: #6f6f6f;
    text-align: center;
    transform: rotate(-1.5deg);
  }
  .epains__msg.is-on {
    color: #222;
  }

  @media (max-width: 1000px) {
    .epains__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .epains__grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .epain {
      padding: 16px 52px 16px 16px;
      gap: 4px 14px;
    }
    .epains__foot {
      flex-direction: column;
    }
  }
</style>
