---
import SectionHead from './SectionHead.astro';
import CtaBand from './CtaBand.astro';
import Logo from '../Logo.astro';
import { ecommerce } from '../../content/ecommerce';

const c = ecommerce.cases;
---

<section id="casos" class="esec ecases" aria-labelledby="cases-title">
  <SectionHead note={c.note} title={c.title} intro={c.intro} id="cases-title" />

  <div class="ecases__list">
    {
      c.items.map((p) => (
        <article class="ecase" data-reveal>
          <div class="ecase__glow" aria-hidden="true" />
          <header class="ecase__head">
            <span class="ecase__logo">
              <Logo id={p.logo} />
            </span>
            <h3 class="ecase__name">{p.name}</h3>
            <span class="ecase__cat">{p.category}</span>
          </header>

          <div class="ecase__body">
            <div>
              <p class="ecase__desc">{p.summary}</p>
              <ul class="ecase__tags" aria-label="Qué se hizo">
                {p.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
            <ul class="ecase__stats">
              {p.stats.map((s) => (
                <li>
                  <b>{s.value}</b>
                  <span>{s.label}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="ecase__media" aria-hidden="true">
            {p.media.map((m) => (
              <figure
                class="ecase__img"
                style={`--l:${m.left}%;--w:${m.width}%;--t:${m.top};--r:${m.rotate}deg;--hx:${m.hover?.x ?? 0}px;--hy:${m.hover?.y ?? -60}px;--hr:${m.hover?.rotate ?? m.rotate * 2}deg;--hs:${m.hover?.scale ?? 1.05}`}
              >
                <img src={m.src} alt={m.alt} width={m.w} height={m.h} loading="lazy" decoding="async" draggable="false" />
              </figure>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <CtaBand text={c.band.text} cta={c.band.cta} />
</section>

<style>
  .ecases__list {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.6vw, 26px);
    margin-top: clamp(34px, 4vw, 64px);
  }

  .ecase {
    --pad: clamp(20px, 3.27vw, 56px);
    position: relative;
    isolation: isolate;
    padding: var(--pad) var(--pad) 0;
    border-radius: var(--radius-card);
    background: var(--card);
    overflow: hidden;
    contain: layout paint;
  }
  .ecase__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background:
      radial-gradient(ellipse 66% 86% at 100% 0%, #fec81a 0%, #fcd13a 14%, #fbdc5a 28%, #f7e590 46%, #f2ebbd 64%, rgba(238, 237, 224, 0) 92%),
      #eeede0;
    transition: opacity 0.5s ease;
  }

  .ecase__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(10px, 1.16vw, 20px);
  }
  .ecase__logo {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(34px, 3.41vw, 58px);
    aspect-ratio: 1;
    border-radius: 24%;
    background: #000;
    color: #fff;
  }
  .ecase__logo :global(svg) {
    width: 76%;
    height: 76%;
  }
  .ecase__name {
    font-size: clamp(26px, 3.14vw, 54px);
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1.1;
  }
  .ecase__cat {
    margin-left: auto;
    padding: 0.42em 0.9em;
    border-radius: 999px;
    background: #fff;
    font-size: clamp(13px, 1vw, 17px);
    font-weight: 500;
    color: #333;
  }

  .ecase__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(20px, 3vw, 56px);
    align-items: start;
    margin-top: clamp(14px, 1.84vw, 32px);
  }
  .ecase__desc {
    max-width: 25em;
    font-size: clamp(16px, 1.55vw, 26px);
    line-height: 1.38;
    color: var(--ink-soft);
  }
  .ecase__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: clamp(14px, 1.4vw, 22px) 0 0;
    padding: 0;
    list-style: none;
  }
  .ecase__tags li {
    padding: 0.42em 0.85em;
    border-radius: 999px;
    background: #e3e3e3;
    font-size: clamp(12px, 0.95vw, 16px);
    font-weight: 500;
    color: #111;
  }

  .ecase__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ecase__stats li {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: clamp(14px, 1.4vw, 22px);
    border-radius: clamp(12px, 1vw, 18px);
    background: #fff;
  }
  .ecase__stats b {
    font-size: clamp(26px, 2.6vw, 48px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .ecase__stats span {
    font-size: clamp(13px, 0.98vw, 16px);
    line-height: 1.3;
    color: var(--ink-mute);
  }

  .ecase__media {
    position: relative;
    margin-top: clamp(28px, 3.55vw, 60px);
    height: clamp(210px, 24.7vw, 420px);
  }
  .ecase__img {
    position: absolute;
    left: var(--l);
    width: var(--w);
    top: calc(var(--t) * 0.0682vw);
    margin: 0;
    padding: clamp(3px, 0.41vw, 7px);
    border-radius: clamp(10px, 1.1vw, 18px);
    background: #fff;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.06),
      0 8px 30px rgba(0, 0, 0, 0.08);
    transform: rotate(var(--r));
    transform-origin: 50% 30%;
    transition: transform 0.7s cubic-bezier(0.3, 1.18, 0.4, 1);
    will-change: transform;
  }
  .ecase__img img {
    width: 100%;
    border-radius: clamp(7px, 0.75vw, 12px);
    user-select: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .ecase:hover .ecase__glow {
      opacity: 1;
    }
    .ecase:hover .ecase__img {
      transform: translate(var(--hx), var(--hy)) rotate(var(--hr)) scale(var(--hs));
    }
  }

  @media (max-width: 900px) {
    .ecase__body {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .ecase {
      --pad: 20px;
      border-radius: 22px;
    }
    .ecase__cat {
      margin-left: 0;
    }
    .ecase__head {
      row-gap: 12px;
    }
    .ecase__stats {
      gap: 6px;
    }
    .ecase__stats li {
      padding: 12px 10px;
    }
    .ecase__stats b {
      font-size: clamp(22px, 6.6vw, 30px);
    }
    .ecase__media {
      height: 40vw;
      margin-top: 24px;
    }
    .ecase__img {
      top: calc(var(--t) * 0.16vw);
    }
  }
</style>
