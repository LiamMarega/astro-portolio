---
import { ecommerce } from '../../content/ecommerce';
---

<section class="estats" aria-label="Resultados en números">
  <ul class="estats__list" data-reveal>
    {
      ecommerce.stats.map((s) => (
        <li>
          <b>{s.value}</b>
          <span>{s.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .estats {
    position: relative;
    z-index: 2;
    width: var(--wrap);
    margin: 0 auto;
  }
  .estats__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: clamp(22px, 2.4vw, 40px) 0;
    list-style: none;
    border-radius: var(--radius-card);
    background: var(--card);
  }
  .estats__list li {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 0 clamp(18px, 2.2vw, 40px);
  }
  .estats__list li + li {
    border-left: 1px solid rgba(0, 0, 0, 0.08);
  }
  .estats__list b {
    font-size: clamp(34px, 3.7vw, 66px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .estats__list span {
    max-width: 14em;
    font-size: clamp(14px, 1.08vw, 18px);
    line-height: 1.3;
    color: var(--ink-mute);
  }

  @media (max-width: 760px) {
    .estats {
      width: calc(100% - 32px);
    }
    .estats__list {
      grid-template-columns: 1fr 1fr;
      gap: 26px 0;
      padding: 24px 0;
      border-radius: 22px;
    }
    .estats__list li:nth-child(3) {
      border-left: 0;
    }
  }
</style>
