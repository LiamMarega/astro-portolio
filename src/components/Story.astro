---
import Polaroids from './Polaroids.astro';
import TagsArt from './TagsArt.astro';
import Gallery from './Gallery.astro';
import { site } from '../content/site';
---

<section id="story" class="story" data-section="story" aria-labelledby="story-title">
  <h2 id="story-title" class="story__title" data-ink>
    {site.story.title.map((l) => <span>{l}</span>)}
  </h2>

  <div class="bento">
    <div class="bento__row">
      <div class="bento__card bento__card--text" data-reveal>
        <div class="bento__copy">
          {site.story.bio.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="bento__card bento__card--wide" data-reveal style="--reveal-delay:.08s">
        <Polaroids />
      </div>
    </div>

    <div class="bento__row bento__row--flip">
      <div class="bento__card bento__card--wide" data-reveal>
        <TagsArt />
      </div>
      <div class="bento__card bento__card--text" data-reveal style="--reveal-delay:.08s">
        <div class="bento__copy">
          {site.story.mission.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </div>

  <Gallery />
</section>

<style>
  .story {
    position: relative;
    z-index: 2;
    padding-top: clamp(70px, 8.8vw, 160px);
  }

  .story__title {
    padding: 0 var(--gutter);
    font-size: clamp(42px, 6.89vw, 124px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .story__title span {
    display: block;
  }

  .bento {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.09vw, 18px);
    margin-top: clamp(32px, 4vw, 72px);
    padding: 0 var(--gutter);
  }

  .bento__row {
    display: grid;
    grid-template-columns: 0.7703fr 1fr;
    gap: clamp(10px, 1.09vw, 18px);
    height: clamp(460px, 43.66vw, 760px);
  }
  .bento__row--flip {
    grid-template-columns: 1fr 0.7703fr;
  }

  .bento__card {
    position: relative;
    border-radius: var(--radius-bento);
    background: var(--card);
    overflow: hidden;
  }

  .bento__card--text {
    display: flex;
    align-items: flex-end;
    padding: clamp(20px, 2.73vw, 48px);
  }

  .bento__copy {
    font-size: clamp(16px, 1.733vw, 28px);
    line-height: 1.36;
    color: var(--ink-soft);
  }
  .bento__copy p + p {
    margin-top: 0.92em;
  }

  @media (max-width: 900px) {
    .bento__row,
    .bento__row--flip {
      grid-template-columns: 1fr;
      height: auto;
    }
    .bento__card--text {
      min-height: 0;
      padding-top: 72px;
    }
    .bento__copy {
      max-width: 34em;
    }
    .bento__card--wide {
      aspect-ratio: 1 / 0.95;
    }
    .bento__row--flip .bento__card--wide {
      order: 0;
    }
  }
  @media (max-width: 560px) {
    .bento__card--wide {
      aspect-ratio: 1 / 1.08;
    }
  }
</style>
