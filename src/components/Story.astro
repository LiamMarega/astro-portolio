---
import Polaroids from './Polaroids.astro';
import TagsArt from './TagsArt.astro';
import Gallery from './Gallery.astro';
import Doodle from './Doodle.astro';
import { useContent } from '../content/site';
const { site } = useContent(Astro.currentLocale);
const { story, impact, stack } = site;

type Sticker = (typeof story.stickers.bio)[number];
const peel = (s: Sticker) => ({
  style: `--px:${(s.x * 100).toFixed(1)}%;--py:${(s.y * 100).toFixed(1)}%;--pw:${s.width};--pr:${s.rotate}deg`,
  src: s.src,
  alt: s.alt,
  'data-peel': '',
  'data-width': s.width,
  'data-x': s.x,
  'data-y': s.y,
  'data-rotate': s.rotate,
  title: site.ui.stickerHint,
});
---

<section id="story" class="story" data-section="story" aria-labelledby="story-title">
  <h2 id="story-title" class="story__title" data-ink>
    {story.title.map((l) => <span>{l}</span>)}
  </h2>

  <div class="bento">
    <div class="bento__row">
      <div class="bento__card bento__card--text" data-reveal data-peel-zone>
        {story.stickers.bio.map((s) => <img class="peel-fallback" {...peel(s)} width={s.width} loading="lazy" decoding="async" draggable="false" />)}
        <div class="bento__copy">
          {story.bio.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="bento__card bento__card--wide" data-reveal style="--reveal-delay:.08s">
        <Polaroids />
      </div>
    </div>

    <div class="bento__row bento__row--flip">
      <div class="bento__card bento__card--wide" data-reveal>
        <TagsArt />
      </div>
      <div class="bento__card bento__card--text" data-reveal style="--reveal-delay:.08s" data-peel-zone>
        {story.stickers.mission.map((s) => <img class="peel-fallback" {...peel(s)} width={s.width} loading="lazy" decoding="async" draggable="false" />)}
        <div class="bento__copy">
          {story.mission.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>

    <div class="bento__row bento__row--info">
      <div class="bento__card bento__card--impact" data-reveal>
        <h3 class="bento__label">{impact.title}</h3>
        <ul class="impact">
          {
            impact.items.map((it) => (
              <li>
                <b data-count={it.value}>{it.value}</b>
                <span>{it.label}</span>
              </li>
            ))
          }
        </ul>
        <Doodle name="burst" seed="imp" class="impact__d" duration={0.6} onView />
      </div>
      <div class="bento__card bento__card--stack" data-reveal style="--reveal-delay:.08s">
        <h3 class="bento__label">{stack.title}</h3>
        <div class="stack">
          {
            stack.groups.map((g) => (
              <div class="stack__group">
                <h4>{g.name}</h4>
                <ul>
                  {g.items.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="stack__flow hand">{stack.flow}</p>
      </div>
    </div>
  </div>

  <Gallery />
</section>

<style>
  .story {
    position: relative;
    z-index: 2;
    padding-top: clamp(70px, 8.8vw, 160px);
  }

  .story__title {
    padding: 0 var(--gutter);
    font-size: clamp(42px, 6.89vw, 124px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .story__title span {
    display: block;
  }

  .bento {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.09vw, 18px);
    margin-top: clamp(32px, 4vw, 72px);
    padding: 0 var(--gutter);
  }

  .bento__row {
    display: grid;
    grid-template-columns: 0.7703fr 1fr;
    gap: clamp(10px, 1.09vw, 18px);
    height: clamp(460px, 43.66vw, 760px);
  }
  .bento__row--flip {
    grid-template-columns: 1fr 0.7703fr;
  }
  .bento__row--info {
    grid-template-columns: 1fr 1fr;
    height: auto;
  }

  .bento__card {
    position: relative;
    border-radius: var(--radius-bento);
    background: var(--card);
    overflow: hidden;
  }

  .bento__card--text {
    display: flex;
    align-items: flex-end;
    padding: clamp(20px, 2.73vw, 48px);
  }

  .bento__copy {
    position: relative;
    font-size: clamp(16px, 1.733vw, 28px);
    line-height: 1.36;
    color: var(--ink-soft);
  }
  .bento__copy p + p {
    margin-top: 0.92em;
  }

  /* static stickers until the WebGL peel takes over (and the fallback when it can't) */
  .peel-fallback {
    position: absolute;
    left: calc(50% + var(--px, 0%));
    top: calc(50% + var(--py, 0%));
    width: calc(var(--pw, 130) * 0.0682vw);
    max-width: 34%;
    height: auto;
    z-index: 3;
    transform: translate(-50%, -50%) rotate(var(--pr, 0deg));
    filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.14));
    transition: transform 0.5s var(--ease-spring);
    user-select: none;
  }
  .peel-fallback:hover {
    transform: translate(-50%, -54%) rotate(calc(var(--pr, 0deg) * -0.5)) scale(1.06);
  }
  :global(.peel-on) .peel-fallback {
    visibility: hidden;
  }

  .bento__label {
    display: block;
    font-size: clamp(13px, 1.02vw, 17px);
    font-weight: 550;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a8a8a;
  }

  /* ── impact numbers ── */
  .bento__card--impact {
    padding: clamp(20px, 2.73vw, 48px);
  }
  .impact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(22px, 3vw, 52px) clamp(16px, 2vw, 34px);
    margin: clamp(22px, 3vw, 54px) 0 0;
    padding: 0;
    list-style: none;
  }
  .impact li {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }
  .impact b {
    font-size: clamp(46px, 6.2vw, 112px);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.055em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .impact span {
    max-width: 16em;
    font-size: clamp(14px, 1.3vw, 22px);
    line-height: 1.3;
    color: var(--ink-soft);
  }
  .bento__card--impact :global(.impact__d) {
    position: absolute;
    right: clamp(14px, 2vw, 34px);
    top: clamp(12px, 1.6vw, 28px);
    width: clamp(46px, 5vw, 86px);
    color: #111;
  }

  /* ── stack ── */
  .bento__card--stack {
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 2.73vw, 48px);
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 1.8vw, 30px);
    margin-top: clamp(22px, 3vw, 54px);
  }
  .stack__group h4 {
    margin: 0 0 0.6em;
    font-size: clamp(15px, 1.3vw, 22px);
    font-weight: 550;
    color: var(--ink);
  }
  .stack__group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stack__group li {
    padding: 0.36em 0.78em 0.42em;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 0 0 1px #e3e3e3;
    font-size: clamp(12.5px, 1.05vw, 18px);
    font-weight: 500;
    color: #222;
    transition:
      transform 0.35s var(--ease-spring),
      background 0.2s ease;
  }
  .stack__group li:hover {
    background: var(--sun);
    transform: translateY(-2px) rotate(-2deg);
  }
  .stack__flow {
    margin-top: auto;
    padding-top: clamp(20px, 2.4vw, 40px);
    font-size: clamp(18px, 1.9vw, 32px);
    line-height: 1.15;
    color: #858585;
    transform: rotate(-1.2deg);
    transform-origin: left center;
  }

  @media (max-width: 900px) {
    .bento__row,
    .bento__row--flip,
    .bento__row--info {
      grid-template-columns: 1fr;
      height: auto;
    }
    .bento__card--text {
      min-height: 0;
      padding-top: 72px;
    }
    .bento__card--text[data-peel-zone] {
      padding-top: clamp(170px, 36vw, 260px);
    }
    .bento__copy {
      max-width: 34em;
    }
    .bento__card--wide {
      aspect-ratio: 1 / 0.95;
    }
    .bento__row--flip .bento__card--wide {
      order: 0;
    }
    .peel-fallback {
      top: clamp(90px, 19vw, 140px);
      width: clamp(96px, 22vw, 140px);
    }
  }
  @media (max-width: 560px) {
    .bento__card--wide {
      aspect-ratio: 1 / 1.08;
    }
    .impact {
      gap: 26px 14px;
    }
  }
</style>
