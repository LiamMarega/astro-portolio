---
// Freelance / indie-hacker projects that don't get a full case-study card
// in Works.astro. Grid on tablet+/desktop, horizontal snap-scroll on
// mobile — visible on every breakpoint (unlike the old version of this,
// which was buried inside a desktop-only stacking card).
import { minorProjects } from "../../data/projects";

interface Props {
  title: string;
  meta: string;
}

const { title, meta } = Astro.props;
---

<section
  id="more-projects"
  class="w-full flex flex-col items-center px-4 sm:px-6 py-16 sm:py-20"
  role="region"
  aria-label={title}
>
  <div class="w-full max-w-4xl">
    <div class="mb-8 sm:mb-10 text-center sm:text-left">
      <h2 class="text-3xl sm:text-4xl font-bold text-white">{title}</h2>
      <p class="mt-2 text-sm sm:text-base text-white/50 max-w-xl">{meta}</p>
    </div>

    <div
      class="flex sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-4 overflow-x-auto sm:overflow-visible scrollbar-hide snap-x snap-mandatory sm:snap-none -mx-4 px-4 sm:mx-0 sm:px-0 pb-1"
    >
      {
        minorProjects.map((project) => {
          const Tag = project.link ? "a" : "div";
          const linkAttrs = project.link
            ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
            : {};
          return (
            <Tag
              {...linkAttrs}
              aria-label={project.link ? project.text : undefined}
              class="group relative shrink-0 w-[220px] sm:w-auto snap-start overflow-hidden rounded-xl border border-white/10 bg-white/[0.02] ring-1 ring-inset ring-white/5 shadow-[0_10px_30px_-12px_rgba(0,0,0,0.6)] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E2FF00]/40 hover:shadow-[0_16px_40px_-12px_rgba(226,255,0,0.18)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E2FF00]/60"
            >
              <div class="relative h-[140px] overflow-hidden">
                <img
                  src={project.image}
                  alt={project.text}
                  width="220"
                  height="140"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                />
                <div
                  class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"
                  aria-hidden="true"
                />
              </div>
              <div class="p-3">
                <p class="text-sm font-bold text-white leading-tight">
                  {project.text}
                </p>
              </div>
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
