---
import Contact from '../Contact/Contact.astro';
import SaaSShowcase from './SaaSShowcase.astro';
import SelectedWork from './SelectedWork.astro';
import LanguageSwitcher from '../linktree/LanguageSwitcher.astro';
import { getPortfolioCopy } from '../../i18n/portfolio';
import type { Locale } from '../../i18n/linktree';
import '../../styles/portfolio-editorial.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getPortfolioCopy(locale);
const es = locale === 'es';
---
<LanguageSwitcher currentLocale={locale} />
<main class="pe" id="portfolio-content">
  <header class="pe-hero">
    <p class="pe-eyebrow">Liam Marega · {es ? 'Desarrollador web y mobile' : 'Web & mobile developer'}</p>
    <h1>{t.hero.titleLine1}<br /><span>{t.hero.titleLine2}</span></h1>
    <div class="pe-hero-bottom">
      <p>{es ? 'Construyo interfaces para productos web y mobile. React, TypeScript y Flutter, del diseño a la implementación.' : 'I build interfaces for web and mobile products. React, TypeScript and Flutter, from design to implementation.'}</p>
      <div class="pe-actions"><a class="pe-button" href="#work">{t.nav.work} <span aria-hidden="true">↓</span></a><a class="pe-text-link" href="#contact">{t.hero.cta} <span aria-hidden="true">↗</span></a></div>
    </div>
  </header>
  <SelectedWork locale={locale} />
  <div class="pe-product"><SaaSShowcase copy={t.saas} /></div>
  <section class="pe-section pe-about" id="about" aria-labelledby="pe-about-title">
    <div><p class="pe-eyebrow">{t.nav.about}</p><h2 id="pe-about-title">{es ? 'Detrás del trabajo, Liam.' : 'Behind the work, Liam.'}</h2><p>{t.about1.desc}</p></div>
    <div class="pe-expertise">
      <div><h3>{es ? 'Experiencia mobile' : 'Mobile experience'}</h3><p>{t.infobox.mobileDesc}</p></div>
      <div><h3>{es ? 'Desarrollo web' : 'Web development'}</h3><p>{t.infobox.webDesc}</p></div>
    </div>
  </section>
  <section class="pe-section" aria-labelledby="pe-stack-title">
    <div class="pe-section-head"><h2 id="pe-stack-title">{t.stack.title}</h2><p>{t.stack.meta}</p></div>
    <dl class="pe-stack">{t.stack.groups.map((group) => <div><dt>{group.label}</dt><dd>{group.items.join(' · ')}</dd></div>)}</dl>
  </section>
  <Contact title={t.contact.title} meta={t.contact.meta} />
</main>
<footer class="pe-footer"><p>{t.footer} · {new Date().getFullYear()}</p><a href={`/${locale}/`}>{t.nav.backToLinks} ↗</a></footer>
