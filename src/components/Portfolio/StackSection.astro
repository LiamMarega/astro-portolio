---
import type { PortfolioCopy } from "../../i18n/portfolio";

interface Props {
  copy: PortfolioCopy["stack"];
}

const { copy } = Astro.props;

// Cycle through the same pastel sticker palette used elsewhere on the
// portfolio (bubble-card / tech-card colors) so the stack section feels
// like part of the same scrapbook, not a bolted-on new component.
const palette = ["bg-yellow-300", "bg-green-200", "bg-lime-200", "bg-[#E4F4E4]"];

// Icon-per-chip so recruiters get a scannable "what does he actually use"
// summary instead of just text. Simple Icons CDN — no icon assets to
// source/maintain locally. Slug overrides only for names that don't map
// to a plain lowercase/no-punctuation slug (see simpleicons.org).
const slugOverrides: Record<string, string> = {
  "Next.js": "nextdotjs",
  "Tailwind CSS": "tailwindcss",
  "Node.js": "nodedotjs",
  "iOS": "apple",
};
const iconSlug = (label: string) =>
  slugOverrides[label] ?? label.toLowerCase().replace(/[^a-z0-9]/g, "");
---

<section
  id="stack"
  class="w-full flex flex-col items-center px-4 sm:px-6 py-16 sm:py-20"
  role="region"
  aria-label={copy.title}
>
  <div class="w-full max-w-4xl">
    <div class="mb-8 sm:mb-10 text-center sm:text-left">
      <h2 class="text-3xl sm:text-4xl font-bold text-white">{copy.title}</h2>
      <p class="mt-2 text-sm sm:text-base text-white/50">{copy.meta}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
      {
        copy.groups.map((group, i) => (
          <div>
            <h3 class="text-xs font-bold uppercase tracking-[0.18em] text-white/40 mb-3">
              {group.label}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span
                  class={`inline-flex items-center gap-1.5 text-black text-xs sm:text-sm font-bold px-3 py-1.5 rounded-full shadow-sm ${palette[i % palette.length]}`}
                >
                  <img
                    src={`https://cdn.simpleicons.org/${iconSlug(item)}/000000`}
                    alt=""
                    width="14"
                    height="14"
                    loading="lazy"
                    decoding="async"
                    aria-hidden="true"
                  />
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
