---
import WorkCard from "../Work/parts/WorkCard.astro";
import WorkCardMobile from "../Work/parts/WorkCardMobile.astro";
import WorkCardTablet from "../Work/parts/WorkCardTablet.astro";
import { getProjects, shouldReverse } from "../../data/projects";
import { getPortfolioCopy, projectDescriptionsEs } from "../../i18n/portfolio";
import type { Locale } from "../../i18n/linktree";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const t = getPortfolioCopy(locale);

// Get all projects from centralized data source, swapping in translated
// descriptions when available for the current locale.
const projects = getProjects(true).map((project) => ({
  ...project,
  description:
    locale === "es" && projectDescriptionsEs[project.id]
      ? projectDescriptionsEs[project.id]
      : project.description,
})); // Sort by featured first
---

<!-- Mobile Version: < 768px -->
<section
  id="work-mobile"
  class="block md:hidden w-full scroll-smooth"
  aria-label="Projects showcase"
>
  {
    projects.map((project, index) => (
      <WorkCardMobile
        {...project}
        isReversed={shouldReverse(project, index)}
        techStackLabel={t.work.techStackLabel}
      />
    ))
  }
</section>

<!-- Tablet Version: 768px - 1023px -->
<section
  id="work-tablet"
  class="hidden md:block lg:hidden w-full scroll-smooth"
  aria-label="Projects showcase"
>
  {
    projects.map((project, index) => (
      <WorkCardTablet
        {...project}
        isReversed={shouldReverse(project, index)}
        techStackLabel={t.work.techStackLabel}
      />
    ))
  }
</section>

<!-- Desktop Version: >= 1024px -->
<section
  id="work"
  class="hidden lg:block relative w-full"
  aria-label="Projects showcase"
>
  <div class="work-stack-container p-5">
    {
      projects.map((project, index) => (
        <WorkCard
          {...project}
          cardIndex={index}
          totalCards={projects.length}
          isReversed={shouldReverse(project, index)}
          techStackLabel={t.work.techStackLabel}
        />
      ))
    }
  </div>

  <style>
    /* Scroll snap for smooth scrolling on mobile/tablet */
    #work-mobile,
    #work-tablet {
      scroll-snap-type: y mandatory;
      overflow-y: auto;
    }

    /* Ensure smooth scrolling */
    @media (prefers-reduced-motion: no-preference) {
      #work-mobile,
      #work-tablet,
      #work {
        scroll-behavior: smooth;
      }
    }

    /* Stacking cards container for desktop */
    .work-stack-container {
      position: relative;
      width: 100%;
    }
  </style>
</section>
