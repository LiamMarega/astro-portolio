<div class="sky" data-sky aria-hidden="true">
  <div class="sky__day"></div>
  <div class="sky__dawn"></div>
</div>
<div class="night" data-night aria-hidden="true"></div>

<style>
  .sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: var(--sky-o, 1);
    contain: strict;
  }

  .sky__day,
  .sky__dawn {
    position: absolute;
    inset: 0;
    transform-origin: 50% 0%;
  }

  /* Fitted to the reference frame: ellipse 944×818 centred 153px above the top (at 1466px) */
  .sky__day {
    background: radial-gradient(
      ellipse max(64.4vw, 62vh) max(55.8vw, 52vh) at 50% min(-10.44vw, -4vh),
      #ffc400 0%,
      #ffcc14 19%,
      #fed334 26%,
      #fcdc46 34%,
      #fce562 44%,
      #fdee84 55%,
      #fdf4a6 65%,
      #fcf7c2 75%,
      #fbf8d9 85%,
      #faf8e6 95%,
      #fcfcf2 104%,
      #fdfdfd 114%
    );
  }

  .sky__dawn {
    opacity: 0;
    background: radial-gradient(
      ellipse max(48vw, 50vh) max(42vw, 40vh) at 50% min(-6vw, -3vh),
      #ff9f00 0%,
      #ffb000 30%,
      rgba(255, 186, 20, 0.55) 55%,
      rgba(255, 196, 40, 0) 80%
    );
  }

  .night {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: #000;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  /* ── Sunrise intro (runs on load, replays from the nav sun) ── */
  :global(.js) .night {
    animation: night 1.08s linear both;
  }
  :global(.js) .sky__day {
    animation: day 1.15s cubic-bezier(0.3, 0.6, 0.2, 1) both;
  }
  :global(.js) .sky__dawn {
    animation: dawn 1.15s ease-in-out both;
  }

  :global(.no-intro) .night,
  :global(.no-intro) .sky__day,
  :global(.no-intro) .sky__dawn {
    animation-duration: 1ms;
    animation-delay: 0s;
  }

  :global(.replay) .night {
    animation-name: night-r;
  }
  :global(.replay) .sky__day {
    animation-name: day-r;
  }
  :global(.replay) .sky__dawn {
    animation-name: dawn-r;
  }

  @keyframes night {
    0%,
    13% {
      opacity: 1;
      visibility: visible;
    }
    36% {
      opacity: 0.8;
    }
    60% {
      opacity: 0.44;
    }
    84% {
      opacity: 0.07;
    }
    99% {
      opacity: 0;
      visibility: visible;
    }
    100% {
      opacity: 0;
      visibility: hidden;
    }
  }
  @keyframes day {
    0%,
    12% {
      opacity: 0;
      transform: translateY(14vh) scale(0.7);
    }
    55% {
      opacity: 0.75;
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes dawn {
    0%,
    12% {
      opacity: 0.9;
      transform: translateY(18vh) scale(0.55);
    }
    50% {
      opacity: 0.85;
      transform: translateY(4vh) scale(0.9);
    }
    100% {
      opacity: 0;
      transform: none;
    }
  }
  /* identical copies so the animation can be restarted by swapping names */
  @keyframes night-r {
    0%, 13% { opacity: 1; visibility: visible; }
    36% { opacity: 0.8; }
    60% { opacity: 0.44; }
    84% { opacity: 0.07; }
    99% { opacity: 0; visibility: visible; }
    100% { opacity: 0; visibility: hidden; }
  }
  @keyframes day-r {
    0%, 12% { opacity: 0; transform: translateY(14vh) scale(0.7); }
    55% { opacity: 0.75; }
    100% { opacity: 1; transform: none; }
  }
  @keyframes dawn-r {
    0%, 12% { opacity: 0.9; transform: translateY(18vh) scale(0.55); }
    50% { opacity: 0.85; transform: translateY(4vh) scale(0.9); }
    100% { opacity: 0; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .night {
      display: none;
    }
  }
</style>
