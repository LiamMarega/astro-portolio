---
import Doodle from './Doodle.astro';
import { polaroids } from '../content/site';
// [left doodle x%, y%, right doodle x%, y%] — measured from the reference video
const spots = [
  [11.5, 28, 71, 20],
  [12, 57, 70, 22],
  [9, 18, 72, 60],
  [10, 44, 71, 18],
  [13, 60, 70, 26],
  [10, 24, 72, 56],
];
---

<div class="pols" data-polaroids aria-roledescription="carousel" aria-label="Little moments">
  <div class="pols__stage">
    {
      polaroids.map((p, i) => (
        <figure class="pol" data-pol={i} aria-hidden={i === 0 ? undefined : 'true'}>
          <div class="pol__photo">
            <img src={p.src} alt={p.alt} width="600" height="600" loading="lazy" decoding="async" draggable="false" />
          </div>
          <figcaption class="pol__cap hand">{p.caption}</figcaption>
        </figure>
      ))
    }
  </div>
  {
    polaroids.map((p, i) => {
      const spot = spots[i % spots.length];
      return (
        <div class="pols__doodles" data-pol-doodles={i} aria-hidden="true">
          <Doodle name={p.doodles[0]} seed={`p${i}a`} class="pols__d pols__d--l" duration={0.9} style={`left:${spot[0]}%;top:${spot[1]}%`} />
          <Doodle name={p.doodles[1]} seed={`p${i}b`} class="pols__d pols__d--r" duration={0.9} delay={0.35} style={`left:${spot[2]}%;top:${spot[3]}%`} />
        </div>
      );
    })
  }
</div>

<style>
  .pols {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
  }

  .pols__stage {
    position: absolute;
    left: 48.3%;
    top: 48.4%;
    width: 0;
    height: 0;
  }

  .pol {
    --w: clamp(150px, 21vw, 360px);
    position: absolute;
    left: calc(var(--w) * -0.5);
    top: calc(var(--w) * -0.6);
    width: var(--w);
    margin: 0;
    padding: calc(var(--w) * 0.052) calc(var(--w) * 0.052) 0;
    background: #fff;
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.08),
      0 12px 30px rgba(0, 0, 0, 0.1);
    transform: translateX(calc(var(--x, 0) * var(--gap))) translateY(var(--ty, 0px)) rotate(var(--rot, 0deg));
    transition: transform 0.82s cubic-bezier(0.62, 0, 0.2, 1);
    --gap: clamp(220px, 30vw, 520px);
    will-change: transform;
  }
  .pol.no-anim {
    transition: none;
  }

  .pol__photo {
    aspect-ratio: 1;
    overflow: hidden;
    background: #ddd;
  }
  .pol__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pol__cap {
    display: grid;
    place-items: center;
    height: calc(var(--w) * 0.25);
    font-size: calc(var(--w) * 0.0956);
    color: #151515;
    line-height: 1;
    white-space: nowrap;
  }

  .pols__doodles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pols :global(.pols__d) {
    position: absolute;
    width: clamp(64px, 8.6vw, 150px);
    height: auto;
    color: #0c0c0c;
  }


  /* erase quickly when leaving */
  .pols :global(.pols__d:not(.is-drawn) path) {
    transition: stroke-dashoffset 0.28s ease-in;
  }

  @media (max-width: 900px) and (min-width: 761px) {
    .pol {
      --w: 31vw;
      --gap: 43vw;
    }
    .pols :global(.pols__d) {
      width: 12vw;
    }
  }
  @media (max-width: 760px) {
    .pol {
      --w: 46vw;
      --gap: 62vw;
    }
    .pols :global(.pols__d) {
      width: 19vw;
    }
    .pols :global(.pols__d--l) {
      left: 2% !important;
    }
    .pols :global(.pols__d--r) {
      left: 78% !important;
    }
  }
</style>
