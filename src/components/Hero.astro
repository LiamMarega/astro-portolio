---
import Sticker, { type StickerType } from './Sticker.astro';
import { useContent } from '../content/site';
const { site, lang } = useContent(Astro.currentLocale);

// Sticker per letter (cycles if the name is longer): L i a m · M a r e g a
const order: StickerType[] = ['bubble', 'laptop', 'bubble', 'phone', 'hello', 'mate', 'bubble', 'sun', 'terminal', 'rocket', 'star', 'heart'];
// size (em) and vertical centre (em, relative to the baseline) for each sticker type
const geo: Record<StickerType, { s: number; y: number }> = {
  bubble: { s: 0.96, y: -0.36 },
  laptop: { s: 0.86, y: -0.33 },
  phone: { s: 0.64, y: -0.38 },
  hello: { s: 0.72, y: -0.34 },
  mate: { s: 0.64, y: -0.37 },
  sun: { s: 0.72, y: -0.37 },
  terminal: { s: 0.78, y: -0.36 },
  rocket: { s: 0.66, y: -0.38 },
  star: { s: 0.64, y: -0.36 },
  heart: { s: 0.58, y: -0.32 },
  bolt: { s: 0.62, y: -0.36 },
};

const words = site.name.split(' ');
let k = 0;
const tilt = [-6, 4, -3, 7, -5, 3, -8, 5, -2, 6];
---

<section id="hey" class="hero" data-hero data-section="hey" aria-label={site.name}>
  <div class="hero__inner">
    <p class="hero__tagline" data-hero-tagline>
      <span class="hero__tagin">
        {
          site.hero.taglineLines.map((line, i) => (
            <>
              <span class="hero__line">{line}</span>
              {i < site.hero.taglineLines.length - 1 && ' '}
            </>
          ))
        }
      </span>
    </p>

    <h1 class="hero__name" data-hero-name aria-label={site.name}>
      <span class="hero__fit" data-hero-fit aria-hidden="true">
        {
          words.map((word, wi) => (
            <>
              <span class="hero__word">
                {[...word].map((ch) => {
                  const i = k++;
                  const type = order[i % order.length];
                  const g = geo[type];
                  return (
                    <span class="ch" data-ch={i} style={`--s:${g.s}em;--y:${g.y}em;--r:${tilt[i % tilt.length]}deg`}>
                      <span class="ch__glyph">{ch}</span>
                      <span class="ch__sticker" data-type={type}>
                        <Sticker type={type} char={ch} uid={`stk${i}`} lang={lang} />
                      </span>
                    </span>
                  );
                })}
              </span>
              {wi < words.length - 1 && <span class="hero__space">{' '}</span>}
            </>
          ))
        }
      </span>
    </h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 520px;
    z-index: 2;
    overflow-x: clip;
  }

  .hero__inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .hero__tagline {
    position: relative;
    z-index: 2;
    margin: 0 0 -0.27em 2.885vw;
    max-width: 60em;
    font-size: clamp(19px, 2.53vw, 44px);
    line-height: 1.268;
    font-weight: 470;
    letter-spacing: 0;
    will-change: opacity;
  }
  .hero__tagin {
    display: inline-block;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.535) 0%, rgba(0, 0, 0, 0.47) 45%, rgba(0, 0, 0, 0.34) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__line {
    display: block;
  }

  :global(.js) .hero__tagin {
    animation: tagline-in 0.7s ease 0.62s both;
  }
  :global(.replay) .hero__tagin {
    animation-name: tagline-in-r;
  }
  @keyframes tagline-in-r {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(6px);
    }
  }
  @keyframes tagline-in {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(6px);
    }
  }

  .hero__name {
    position: relative;
    z-index: 3;
    /* room for the descender of the "g" so the whole name stays on screen */
    margin: 0 0 0.19em;
    font-size: var(--name-size, 23.53vw);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.07em;
    color: #050505;
    text-align: center;
    white-space: nowrap;
    user-select: none;
    -webkit-user-select: none;
  }

  .hero__fit {
    display: inline-flex;
    position: relative;
    left: -0.0305em;
  }

  .hero__word {
    display: flex;
  }

  .hero__space {
    display: block;
  }

  .ch {
    position: relative;
    display: inline-block;
    cursor: default;
  }

  .ch__glyph {
    display: inline-block;
    transition: opacity 0.08s linear;
  }

  .ch.is-on .ch__glyph {
    opacity: 0;
    transition-duration: 0.04s;
  }

  .ch__sticker {
    position: absolute;
    left: 50%;
    top: calc(0.863em + var(--y));
    width: var(--s);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    letter-spacing: 0;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%) rotate(var(--r)) scale(0.72);
    transition:
      opacity 0.12s ease,
      transform 0.16s ease;
    z-index: 4;
  }

  .ch.is-on .ch__sticker {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(var(--r)) scale(1);
    transition:
      opacity 0.08s ease,
      transform 0.42s cubic-bezier(0.3, 1.8, 0.45, 1);
  }

  .ch__sticker :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 0.012em 0.008em rgba(0, 0, 0, 0.18)) drop-shadow(0 0.04em 0.05em rgba(0, 0, 0, 0.16));
  }

  @media (max-width: 760px) {
    .hero__tagline {
      margin-left: 5.2vw;
      margin-right: 5.2vw;
      margin-bottom: 0.9em;
      font-size: clamp(19px, 5.2vw, 26px);
      line-height: 1.3;
    }
    .hero__line {
      display: inline;
    }
  }
</style>
