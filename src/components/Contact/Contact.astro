---
import SocialButtons from '../../components/ui/buttons/SocialButtons.astro';

interface Props {
  title?: string;
  meta?: string;
}

const { title = "Let's build something", meta = "Open to full-time roles, freelance and collaborations" } =
  Astro.props;
---

<section
  id='contact'
  class='min-h-screen w-full flex flex-col justify-center items-center gap-8 sm:gap-10 p-6 sm:p-8 md:p-12 lg:p-16 xl:p-24 2xl:p-0'
  role='region'
  aria-label='Contact section'
>
  <div class="text-center px-4">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-balance">{title}</h2>
    <p class="mt-3 text-sm sm:text-base text-white/50 max-w-md mx-auto">{meta}</p>
  </div>
  <div class='w-full max-w-md sm:max-w-lg md:max-w-xl lg:max-w-2xl xl:max-w-4xl'>
    <SocialButtons />
  </div>
</section>
