---
/**
 * The 3D "Connect" key of the home page, as a reusable call to action.
 * It lights up yellow on hover / focus / tap (src/scripts/keycap.ts).
 * Any extra attribute (data-lf-set, aria-*…) is passed to the link.
 */
import Doodle from './Doodle.astro';

interface Props {
  href: string;
  label: string;
  /** width of the key face (any CSS length) */
  w?: string;
  /** rotation in degrees */
  tilt?: number;
  /** hand-drawn strokes that appear when lit: both, only the top one, or none */
  doodles?: boolean | 'top';
  class?: string;
  [attr: string]: unknown;
}
const { href, label, w = 'clamp(250px, 23vw, 380px)', tilt = -2, doodles = true, class: className, ...rest } = Astro.props;
const seed = label.length;
---

<span class:list={['key', className]} data-keycap style={`--w:${w};--tilt:${tilt}deg`}>
  {doodles && <Doodle name="connectTop" seed={`k${seed}t`} class="key__d key__d--tl" duration={0.45} />}
  {doodles === true && <Doodle name="connectBottom" seed={`k${seed}b`} class="key__d key__d--br" duration={0.6} delay={0.06} />}
  <a class="key__btn" href={href} data-keycap-btn {...rest}>
    <span class="key__glow" aria-hidden="true"></span>
    <span class="key__rim" aria-hidden="true"></span>
    <span class="key__side" aria-hidden="true"></span>
    <span class="key__top">
      <span class="key__label" data-text={label}>{label}</span>
    </span>
  </a>
</span>

<style>
  .key {
    --h: calc(var(--w) * 0.27);
    --depth: calc(var(--w) * 0.034);
    position: relative;
    display: inline-block;
    width: var(--w);
    height: var(--h);
  }

  .key :global(.key__d) {
    position: absolute;
    color: #141414;
    pointer-events: none;
  }
  .key :global(.key__d--tl) {
    width: 20%;
    left: -12%;
    top: -52%;
  }
  .key :global(.key__d--br) {
    width: 46%;
    left: 74%;
    top: 112%;
  }
  .key :global(.key__d:not(.is-drawn) path) {
    transition: stroke-dashoffset 0.22s ease-in;
  }

  .key__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    transform: rotate(var(--tilt));
    transition: transform 0.5s var(--ease-spring);
    -webkit-tap-highlight-color: transparent;
  }
  .key__btn:focus-visible {
    outline: none;
  }
  .key__btn:focus-visible .key__top {
    box-shadow:
      0 0 0 3px #fff,
      0 0 0 5px #111;
  }

  .key__glow {
    position: absolute;
    inset: calc(var(--w) * -0.014) calc(var(--w) * -0.03) calc(var(--w) * -0.07);
    border-radius: 999px;
    box-shadow:
      0 0 calc(var(--w) * 0.1) calc(var(--w) * 0.025) rgba(255, 215, 0, 0.6),
      0 calc(var(--w) * -0.01) calc(var(--w) * 0.24) calc(var(--w) * 0.06) rgba(255, 205, 0, 0.6),
      0 calc(var(--w) * -0.01) calc(var(--w) * 0.44) calc(var(--w) * 0.09) rgba(255, 205, 0, 0.18);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .key__rim {
    position: absolute;
    inset: calc(var(--w) * -0.014) calc(var(--w) * -0.03) calc(var(--w) * -0.07);
    border-radius: 999px;
    background: linear-gradient(180deg, #e0e0e0 0, #d8d8d8 calc(var(--w) * 0.012), #c2c2c2 20%, #b3b3b3 42%, #aaa 100%);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.3),
      0 0 calc(var(--w) * 0.008) rgba(0, 0, 0, 0.14),
      0 calc(var(--w) * 0.02) calc(var(--w) * 0.05) rgba(0, 0, 0, 0.1),
      0 calc(var(--w) * 0.06) calc(var(--w) * 0.16) rgba(0, 0, 0, 0.18);
    transition:
      background 0.45s ease,
      box-shadow 0.45s ease;
  }

  .key__side {
    position: absolute;
    inset: calc(var(--w) * -0.003) calc(var(--w) * -0.007) calc(var(--depth) * -1);
    border-radius: 999px;
    background: #1c1c1c;
    transition:
      background 0.45s ease,
      box-shadow 0.45s ease,
      bottom 0.3s var(--ease-out);
    box-shadow:
      inset 0 calc(var(--w) * -0.009) calc(var(--w) * 0.003) #000,
      inset 0 0 0 calc(var(--w) * 0.004) #040404,
      0 calc(var(--w) * 0.006) calc(var(--w) * 0.012) calc(var(--w) * -0.003) rgba(0, 0, 0, 0.5),
      0 calc(var(--w) * 0.022) calc(var(--w) * 0.006) calc(var(--w) * -0.004) rgba(0, 0, 0, 0.45);
  }

  .key__top {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: linear-gradient(180deg, #323232 0%, #373737 10%, #323232 36%, #2e2e2e 52%, #2a2a2a 72%, #252525 100%);
    box-shadow: 0 1.5px 0 rgba(255, 255, 255, 0.13);
    transition:
      background 0.45s ease,
      box-shadow 0.45s ease,
      transform 0.18s ease;
    overflow: hidden;
  }

  .key__label {
    position: relative;
    padding: 0 0.6em 0.04em;
    font-size: calc(var(--h) * 0.34);
    font-weight: 540;
    letter-spacing: -0.005em;
    line-height: 1;
    white-space: nowrap;
    background: linear-gradient(180deg, #f6f6f6 18%, #ebebeb 44%, #e1e1e1 66%, #d9d9d9 86%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 2px 1.5px rgba(0, 0, 0, 0.4));
    transition: filter 0.45s ease;
  }
  .key__label::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    padding: inherit;
    background: linear-gradient(180deg, #f9dc36 22%, #efd42c 55%, #e8cf12 84%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  /* lit: hover / focus / tap */
  .key.is-lit .key__glow {
    opacity: 1;
  }
  .key.is-lit .key__rim {
    background: linear-gradient(180deg, #f5dc50 0%, #efd744 36%, #f6e026 68%, #f8e31c 100%);
    box-shadow:
      inset 0 1px 1px rgba(255, 250, 200, 0.5),
      0 0 calc(var(--w) * 0.008) rgba(230, 190, 0, 0.3);
  }
  .key.is-lit .key__side {
    bottom: calc(var(--depth) * -0.55);
    background: #4a3900;
    box-shadow:
      inset 0 calc(var(--w) * -0.009) calc(var(--w) * 0.003) #8a5f00,
      inset 0 0 0 calc(var(--w) * 0.004) #3a2c00,
      0 calc(var(--w) * 0.004) calc(var(--w) * 0.007) calc(var(--w) * -0.002) rgba(130, 90, 0, 0.6),
      0 calc(var(--w) * 0.013) calc(var(--w) * 0.004) calc(var(--w) * -0.004) rgba(255, 246, 110, 0.85);
  }
  .key.is-lit .key__top {
    background:
      radial-gradient(32% 75% at 79% 0%, rgba(255, 170, 0, 0.34), rgba(255, 170, 0, 0) 100%),
      radial-gradient(42% 70% at 94% 100%, rgba(18, 16, 0, 0.5), rgba(18, 16, 0, 0) 100%),
      linear-gradient(180deg, #4f4200 0%, #544600 18%, #504300 40%, #574600 62%, #523f00 82%, #4a3a00 100%);
    box-shadow: 0 1.5px 0 rgba(255, 220, 60, 0.18);
  }
  .key.is-lit .key__label {
    filter: drop-shadow(0 0 calc(var(--w) * 0.01) rgba(255, 214, 0, 0.18));
  }
  .key.is-lit .key__label::after {
    opacity: 1;
  }
  .key__btn:active .key__top,
  .key__btn.is-pressed .key__top {
    transform: translateY(calc(var(--depth) * 0.7));
  }

  @media (max-width: 560px) {
    .key :global(.key__d--tl) {
      left: -5%;
    }
    .key :global(.key__d--br) {
      left: 60%;
      width: 38%;
    }
  }
</style>
