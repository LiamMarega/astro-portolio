---
import * as lucide from 'lucide-static';
import Logo from './Logo.astro';
import { projects } from '../content/site';

const icon = (name: string) => {
  const svg = (lucide as Record<string, string>)[name] ?? '';
  return svg.replace(/\s(width|height)="24"/g, '').replace('class="', 'aria-hidden="true" class="');
};
---

<div class="case" data-case aria-hidden="true" inert>
  <div class="case__scroller" data-case-scroller data-lenis-prevent tabindex="-1">
    {
      projects.map((p, i) => {
        const next = projects[(i + 1) % projects.length];
        const [a, b] = p.media;
        const dark = p.palette.find((c) => c.ink !== '#111') ?? p.palette[0];
        const light = p.palette.find((c) => c.ink === '#111') ?? p.palette[1];
        const accent = p.palette[1];
        return (
          <article class="case__panel" data-case-panel={p.slug} role="dialog" aria-modal="true" aria-labelledby={`case-${p.slug}`} hidden>
            <div class="case__wrap">
              <span class="case__logo">
                <Logo id={p.logo} />
              </span>
              <h2 id={`case-${p.slug}`} class="case__title">
                {p.name}
              </h2>
              <div class="case__intro">
                {p.caseStudy.intro.map((t) => (
                  <p>{t}</p>
                ))}
              </div>
              <ul class="case__tags" aria-label="Services">
                {p.caseStudy.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>

              <div class="case__grid">
                <figure class="case__fig case__fig--wide">
                  <img src={p.cover.src} alt={p.cover.alt} width={p.cover.w} height={p.cover.h} loading="lazy" decoding="async" />
                </figure>

                <figure class="case__fig" style={`background:${dark.color}`}>
                  <img class="case__float" src={a.src} alt={a.alt} width={a.w} height={a.h} loading="lazy" decoding="async" />
                </figure>

                <div class="case__palette" role="list" aria-label="Colour palette">
                  {p.palette.map((c) => (
                    <div role="listitem" style={`background:${c.color};color:${c.ink}`}>
                      <span>{c.name}</span>
                      <code>{c.color}</code>
                    </div>
                  ))}
                </div>

                <div class="case__logos" style={`background:${light.color}`}>
                  <span style={`background:${dark.color};color:${accent.color}`}>
                    <Logo id={p.logo} />
                  </span>
                  <span style={`background:${accent.color};color:${dark.color}`}>
                    <Logo id={p.logo} />
                  </span>
                  <span style="background:#fff;color:#0b0b0b">
                    <Logo id={p.logo} />
                  </span>
                </div>

                <div class="case__icons" style={`background:${accent.color};color:${accent.ink === '#111' ? '#151515' : '#fff'}`}>
                  {p.icons.map((n) => (
                    <span set:html={icon(n)} />
                  ))}
                </div>

                <figure class="case__fig" style={`background:${dark.color}`}>
                  <img class="case__float case__float--b" src={b.src} alt={b.alt} width={b.w} height={b.h} loading="lazy" decoding="async" />
                </figure>
              </div>

              <a class="case__next" href={`#work/${next.slug}`} data-open-case={next.slug}>
                <span class="case__next-label">Next project</span>
                <span class="case__next-name">
                  <span class="case__next-logo">
                    <Logo id={next.logo} />
                  </span>
                  {next.name}
                  <svg viewBox="0 0 56 44" aria-hidden="true">
                    <path d="M4 22.5C18 21.6 32 22.4 50 21.8M37 9c5 4.6 9.5 8.8 13.5 12.8C46.4 26 42 30.4 37.6 35" />
                  </svg>
                </span>
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
  <div class="case__blur" aria-hidden="true"><i></i><i></i><i></i></div>
</div>

<style>
  .case {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: var(--page);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.22s ease,
      visibility 0s linear 0.22s;
  }
  :global(.is-case) .case {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.24s ease,
      visibility 0s;
  }

  /* the sheet stays docked under the nav; its content scrolls inside it */
  .case__scroller {
    --sheet-top: 69px;
    position: absolute;
    inset: var(--sheet-top) 8px 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    outline: none;
    border-radius: clamp(18px, 1.64vw, 28px) clamp(18px, 1.64vw, 28px) 0 0;
    background: var(--card);
    transform: translateY(26px);
    transition: transform 0.6s var(--ease-out);
  }
  .case__scroller::-webkit-scrollbar {
    display: none;
  }
  :global(.is-case) .case__scroller {
    transform: none;
  }

  .case__panel {
    min-height: 100%;
  }

  /* soft fade where the content slides under the sheet's top edge */
  .case__blur {
    position: absolute;
    top: 69px;
    left: 8px;
    right: 8px;
    height: clamp(36px, 3.6vw, 60px);
    border-radius: clamp(18px, 1.64vw, 28px) clamp(18px, 1.64vw, 28px) 0 0;
    overflow: hidden;
    pointer-events: none;
    transform: translateY(26px);
    transition: transform 0.6s var(--ease-out);
  }
  :global(.is-case) .case__blur {
    transform: none;
  }
  .case__blur i {
    position: absolute;
    inset: 0;
    -webkit-backdrop-filter: blur(var(--b));
    backdrop-filter: blur(var(--b));
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent var(--e));
    mask-image: linear-gradient(to bottom, #000 0%, transparent var(--e));
  }
  .case__blur i:nth-child(1) {
    --b: 1.5px;
    --e: 100%;
  }
  .case__blur i:nth-child(2) {
    --b: 3.5px;
    --e: 62%;
  }
  .case__blur i:nth-child(3) {
    --b: 7px;
    --e: 32%;
  }

  .case__wrap {
    width: var(--wrap);
    margin: 0 auto;
    padding: clamp(36px, 4.9vw, 84px) 0 clamp(40px, 5vw, 90px);
  }

  .case__logo {
    display: grid;
    place-items: center;
    width: clamp(48px, 4.8vw, 82px);
    aspect-ratio: 1;
    border-radius: 21%;
    background: #000;
    color: #fff;
  }
  .case__logo :global(svg) {
    width: 72%;
    height: 72%;
  }

  .case__title {
    margin-top: clamp(28px, 4.3vw, 72px);
    font-size: clamp(40px, 4.78vw, 84px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
  }

  .case__intro {
    margin-top: clamp(18px, 2.4vw, 40px);
    max-width: 38em;
    font-size: clamp(16px, 1.56vw, 26px);
    line-height: 1.43;
    color: #555;
  }
  .case__intro p + p {
    margin-top: 0.9em;
  }

  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 8px;
    margin: clamp(22px, 2.6vw, 44px) 0 0;
    padding: 0;
    max-width: 44em;
    list-style: none;
  }
  .case__tags li {
    padding: 0.42em 0.85em;
    border-radius: 999px;
    background: #e3e3e3;
    font-size: clamp(12px, 1.02vw, 17px);
    font-weight: 500;
    color: #111;
  }

  .case__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(6px, 0.55vw, 10px);
    margin-top: clamp(40px, 5.2vw, 90px);
  }

  .case__fig,
  .case__palette,
  .case__logos,
  .case__icons {
    margin: 0;
    border-radius: clamp(10px, 0.9vw, 16px);
    overflow: hidden;
    min-height: 0;
  }

  .case__fig--wide {
    grid-column: 1 / -1;
  }
  .case__fig img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case__fig:not(.case__fig--wide) {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 0.82;
    padding: 7%;
  }
  .case__fig img.case__float {
    width: auto;
    height: auto;
    max-width: 78%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    transform: rotate(-3deg);
  }
  .case__fig img.case__float--b {
    max-width: 100%;
    transform: rotate(2deg);
  }

  .case__palette {
    display: grid;
    grid-template-rows: 1.3fr 1fr 1fr 0.8fr;
    aspect-ratio: 1 / 0.82;
  }
  .case__palette div {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 clamp(14px, 1.3vw, 22px) clamp(10px, 1vw, 16px);
    font-size: clamp(14px, 1.3vw, 22px);
    font-weight: 450;
  }
  .case__palette code {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.68em;
    opacity: 0.6;
  }

  .case__logos {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 3vw, 48px);
    aspect-ratio: 2.4 / 1;
  }
  .case__logos span {
    display: grid;
    place-items: center;
    width: 16%;
    aspect-ratio: 1;
    border-radius: 22%;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }
  .case__logos span :global(svg) {
    width: 70%;
    height: 70%;
  }

  .case__icons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    place-items: center;
    padding: 12% 10%;
    gap: 9% 0;
    aspect-ratio: 1 / 0.82;
  }
  .case__icons :global(svg) {
    width: clamp(24px, 2.8vw, 46px);
    height: auto;
    stroke-width: 1.6;
  }

  .case__next {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: clamp(48px, 6vw, 110px);
    padding: clamp(20px, 2.4vw, 40px);
    border-radius: clamp(14px, 1.3vw, 22px);
    background: #e9e9e9;
    transition: background 0.3s ease;
  }
  .case__next:hover {
    background: #f1eccb;
  }
  .case__next-label {
    font-size: clamp(14px, 1.1vw, 18px);
    color: #777;
  }
  .case__next-name {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: clamp(26px, 3.14vw, 54px);
    font-weight: 500;
  }
  .case__next-logo {
    display: grid;
    place-items: center;
    width: 1.1em;
    aspect-ratio: 1;
    border-radius: 24%;
    background: #000;
    color: #fff;
  }
  .case__next-logo :global(svg) {
    width: 76%;
    height: 76%;
  }
  .case__next-name > svg {
    width: 1em;
    margin-left: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 3.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.4s var(--ease-spring);
  }
  .case__next:hover .case__next-name > svg {
    transform: translateX(8px);
  }

  @media (max-width: 760px) {
    .case__scroller {
      inset: 62px 6px 0;
    }
    .case__blur {
      top: 62px;
      left: 6px;
      right: 6px;
    }
    .case__wrap {
      width: calc(100% - 40px);
    }
    .case__grid {
      grid-template-columns: 1fr;
    }
    .case__logos {
      aspect-ratio: 1.6 / 1;
    }
    .case__logos span {
      width: 24%;
    }
  }
</style>
