---
import Doodle from './Doodle.astro';
import ProjectCard from './ProjectCard.astro';
import { useContent } from '../content/site';
const { site, projects } = useContent(Astro.currentLocale);
---

<section id="work" class="work" data-section="work" aria-labelledby="work-title">
  <div class="work__head">
    <Doodle name="scallop" class="work__scallop" seed="w" duration={1.05} onView />
    <div class="work__titles">
      <p class="work__note hand" data-fade>{site.work.note}</p>
      <h2 id="work-title" class="work__title" data-ink>{site.work.title}</h2>
    </div>
  </div>

  <div class="work__list">
    {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
  </div>
</section>

<style>
  .work {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(70px, 9vw, 160px);
  }

  .work__head {
    position: relative;
    height: clamp(300px, 45.3vw, 760px);
  }

  .work__head :global(.work__scallop) {
    position: absolute;
    left: 1.364vw;
    top: 2.115vw;
    width: 77.76vw;
    height: auto;
    color: #0b0b0b;
  }

  .work__titles {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(30px, 4.23vw, 76px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .work__note {
    align-self: center;
    transform: translateX(min(14.8vw, 260px)) translate(0.07vw, -0.27vw) rotate(2.6deg);
    margin-bottom: clamp(4px, 0.7vw, 12px);
    font-size: clamp(20px, 2.5vw, 44px);
    line-height: 1;
    color: #858585;
    white-space: nowrap;
  }

  .work__title {
    font-size: clamp(44px, 6.98vw, 124px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.028em;
    text-align: center;
  }

  .work__list {
    --stack-top: clamp(64px, 5.8vw, 96px);
    --stack-step: clamp(8px, 0.82vw, 14px);
    display: flex;
    flex-direction: column;
    gap: clamp(22px, 3.7vw, 64px);
  }

  @media (max-width: 760px) {
    .work__head {
      height: 360px;
    }
    .work__head :global(.work__scallop) {
      width: 92vw;
      left: 3vw;
    }
    .work__note {
      transform: translateX(14vw) rotate(2.2deg);
    }
    .work__titles {
      bottom: 36px;
    }
    .work__list {
      --stack-top: 64px;
      --stack-step: 9px;
      gap: 18px;
    }
  }
</style>
