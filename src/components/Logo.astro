---
import type { LogoId } from '../content/site';
interface Props {
  id: LogoId;
  class?: string;
}
const { id, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round">
  {id === 'leaf' && <path d="M24 37c-8.5-4.6-12.8-10.4-12.8-17.1C11.2 13.6 16.4 10 24 10s12.8 3.6 12.8 9.9C36.8 26.6 32.5 32.4 24 37z M24 37V20" />}
  {id === 'bolt' && <path d="M27.5 8.5 14.5 26h9l-3 13.5L33.5 22h-9z" />}
  {id === 'rings' && (
    <>
      <circle cx="24" cy="24" r="12.5" />
      <circle cx="24" cy="24" r="6.2" />
    </>
  )}
  {id === 'loop' && <path d="M14 30.5a8.5 8.5 0 1 1 6-14.5l8 8a8.5 8.5 0 1 0 6-2.5M30.5 30h4.5v4.5" />}
  {id === 'spark' && <path d="M24 9.5c1.3 7.5 5 11.2 12.5 12.5C29 23.3 25.3 27 24 34.5 22.7 27 19 23.3 11.5 22 19 20.7 22.7 17 24 9.5zM34 33.5l1.2 3.3 3.3 1.2-3.3 1.2L34 42.5l-1.2-3.3-3.3-1.2 3.3-1.2z" />}
  {id === 'shield' && <path d="M24 8.5 36 13v9.2c0 7.6-4.9 13.6-12 16.3-7.1-2.7-12-8.7-12-16.3V13zM18.5 23.5l4 4 7-8" />}
  {id === 'bean' && <path d="M24 9c7.6 0 12.5 6.6 12.5 15S31.6 39 24 39s-12.5-6.6-12.5-15S16.4 9 24 9zM24 9.5c-4.2 4.6-4.2 9.6 0 14.5s4.2 9.9 0 14.5" />}
  {id === 'sprout' && <path d="M24 39V22M24 27c-7.6 0-11.8-4.6-11.8-11.6 7.6 0 11.8 4.6 11.8 11.6zM24 22c0-7 4.2-11.6 11.8-11.6 0 7-4.2 11.6-11.8 11.6z" />}
  {id === 'pulse' && <path d="M7.5 25h8l4.5-10.5 7.5 20 5-13 3 3.5h5" />}
  {id === 'house' && <path d="M10 22.5 24 11l14 11.5M14 19.5V37h20V19.5M21 37v-8.5h6V37" />}
  {id === 'sun' && <path d="M24 16.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 1 0 0-15zM24 6v4.5M24 37.5V42M6 24h4.5M37.5 24H42M11.3 11.3l3.2 3.2M33.5 33.5l3.2 3.2M11.3 36.7l3.2-3.2M33.5 14.5l3.2-3.2" />}
</svg>
