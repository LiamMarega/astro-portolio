---
/**
 * Die-cut stickers that pop over the hero letters on hover.
 * All artwork is original SVG — swap or add types freely.
 */
export type StickerType =
  | 'bubble'
  | 'laptop'
  | 'cards'
  | 'hello'
  | 'polaroid'
  | 'star'
  | 'smiley'
  | 'heart'
  | 'bolt'
  // e-commerce set (used on /ecommerce)
  | 'bag'
  | 'cart'
  | 'card'
  | 'box'
  | 'tag';

interface Props {
  type: StickerType;
  char?: string;
  uid: string;
}
const { type, char = 'A', uid } = Astro.props;
const id = (s: string) => `${uid}-${s}`;
const upper = char === char.toUpperCase();
---

{
  type === 'bubble' && (
    <svg viewBox="0 0 320 320" class="stk stk--bubble">
      <defs>
        <linearGradient id={id('g')} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" />
          <stop offset="1" stop-color="#ececec" />
        </linearGradient>
      </defs>
      <g transform="rotate(-7 160 160)" font-family="Modak, 'Inter Variable', sans-serif" font-size={upper ? 318 : 330} text-anchor="middle">
        <text x="160" y={upper ? 262 : 254} fill="#fff" stroke="#fff" stroke-width="54" stroke-linejoin="round">{char}</text>
        <text x="171" y={upper ? 274 : 266} fill="#111" stroke="#111" stroke-width="12" stroke-linejoin="round">{char}</text>
        <text x="160" y={upper ? 262 : 254} fill={`url(#${id('g')})`} stroke="#111" stroke-width="11" stroke-linejoin="round" paint-order="stroke">{char}</text>
      </g>
      <path d="M262 52c3 16 8 22 24 25-16 3-21 9-24 25-3-16-8-22-24-25 16-3 21-9 24-25z" fill="#ffd60a" stroke="#111" stroke-width="5" stroke-linejoin="round" />
    </svg>
  )
}

{
  type === 'laptop' && (
    <svg viewBox="0 0 340 240" class="stk stk--laptop">
      <defs>
        <linearGradient id={id('scr')} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#14161f" />
          <stop offset="0.55" stop-color="#1d2433" />
          <stop offset="1" stop-color="#0d1f1a" />
        </linearGradient>
        <radialGradient id={id('glow')} cx="0.32" cy="0.62" r="0.6">
          <stop offset="0" stop-color="#ff7a3d" />
          <stop offset="0.45" stop-color="#ffb347" stop-opacity="0.65" />
          <stop offset="1" stop-color="#ffb347" stop-opacity="0" />
        </radialGradient>
        <radialGradient id={id('glow2')} cx="0.78" cy="0.7" r="0.45">
          <stop offset="0" stop-color="#3ddc97" />
          <stop offset="1" stop-color="#3ddc97" stop-opacity="0" />
        </radialGradient>
        <linearGradient id={id('base')} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#d9dadf" />
          <stop offset="1" stop-color="#8e9098" />
        </linearGradient>
      </defs>
      <g transform="rotate(-6 170 120)">
        <rect x="44" y="18" width="252" height="170" rx="12" fill="#0b0b0d" />
        <rect x="52" y="26" width="236" height="152" rx="5" fill={`url(#${id('scr')})`} />
        <rect x="52" y="26" width="236" height="152" rx="5" fill={`url(#${id('glow')})`} />
        <rect x="52" y="26" width="236" height="152" rx="5" fill={`url(#${id('glow2')})`} opacity="0.8" />
        <circle cx="64" cy="38" r="3" fill="#fff" opacity="0.7" />
        <rect x="200" y="34" width="34" height="8" rx="4" fill="#fff" opacity="0.25" />
        <rect x="240" y="34" width="38" height="8" rx="4" fill="#ffd60a" />
        <text x="170" y="112" text-anchor="middle" font-family="'Inter Variable', Inter, sans-serif" font-weight="600" font-size="34" letter-spacing="-1.4" fill="#fff">sunrise</text>
        <rect x="118" y="126" width="104" height="6" rx="3" fill="#fff" opacity="0.35" />
        <rect x="136" y="138" width="68" height="6" rx="3" fill="#fff" opacity="0.2" />
        <path d="M22 196h296l-14 16c-3 3-7 5-11 5H47c-4 0-8-2-11-5z" fill={`url(#${id('base')})`} />
        <rect x="146" y="196" width="48" height="5" rx="2.5" fill="#6b6d74" />
      </g>
    </svg>
  )
}

{
  type === 'cards' && (
    <svg viewBox="0 0 300 300" class="stk stk--cards">
      <defs>
        <linearGradient id={id('c1')} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffcf4a" />
          <stop offset="1" stop-color="#ff6f3c" />
        </linearGradient>
        <linearGradient id={id('c2')} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#7cf0c3" />
          <stop offset="1" stop-color="#1e8f6b" />
        </linearGradient>
        <linearGradient id={id('c3')} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#efe9ff" />
          <stop offset="1" stop-color="#b9a8ff" />
        </linearGradient>
      </defs>
      <g transform="rotate(-16 150 170)">
        <rect x="70" y="70" width="136" height="176" rx="14" fill="#fff" />
        <rect x="80" y="80" width="116" height="156" rx="8" fill={`url(#${id('c2')})`} />
        <path d="M96 200c20-40 44-62 84-70" stroke="#0f3d2e" stroke-width="7" fill="none" stroke-linecap="round" />
        <circle cx="168" cy="110" r="12" fill="#ffe66b" />
      </g>
      <g transform="rotate(12 150 170)">
        <rect x="96" y="80" width="136" height="176" rx="14" fill="#fff" />
        <rect x="106" y="90" width="116" height="156" rx="8" fill={`url(#${id('c1')})`} />
        <circle cx="164" cy="160" r="34" fill="#fff" opacity="0.9" />
        <path d="M150 160l10 10 18-22" stroke="#ff6f3c" stroke-width="7" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      </g>
      <g transform="rotate(-2 150 150)">
        <rect x="84" y="40" width="136" height="176" rx="14" fill="#fff" />
        <rect x="94" y="50" width="116" height="156" rx="8" fill={`url(#${id('c3')})`} />
        <circle cx="152" cy="112" r="26" fill="#fff" />
        <path d="M120 186c8-22 56-22 64 0" stroke="#fff" stroke-width="10" fill="none" stroke-linecap="round" />
        <circle cx="152" cy="112" r="11" fill="#7a4dff" />
      </g>
    </svg>
  )
}

{
  type === 'hello' && (
    <svg viewBox="0 0 300 260" class="stk stk--hello">
      <g transform="rotate(-14 150 130)">
        <rect x="26" y="34" width="248" height="190" rx="18" fill="#fff" />
        <path d="M26 52a18 18 0 0 1 18-18h212a18 18 0 0 1 18 18v52H26z" fill="#e8402f" />
        <text x="150" y="80" text-anchor="middle" font-family="'Inter Variable', Inter, sans-serif" font-weight="800" font-size="40" letter-spacing="6" fill="#fff">HELLO</text>
        <text x="150" y="98" text-anchor="middle" font-family="'Inter Variable', Inter, sans-serif" font-weight="600" font-size="13" letter-spacing="2.4" fill="#fff" opacity="0.92">MY NAME IS</text>
        <g fill="none" stroke="#111" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M150 128c22 0 38 16 38 36s-16 38-38 38-38-17-38-37 16-37 38-37z" />
          <path d="M137 156c0-3 0-5 0-7M163 156c0-3 0-5 0-7" />
          <path d="M132 172c10 14 26 14 36 0" />
          <path d="M150 112v-4M196 134l6-5M206 166h8M104 134l-6-5M94 166h-8M190 198l6 6M110 198l-6 6" />
        </g>
      </g>
    </svg>
  )
}

{
  type === 'polaroid' && (
    <svg viewBox="0 0 280 320" class="stk stk--polaroid">
      <defs>
        <linearGradient id={id('sky')} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ff9a5a" />
          <stop offset="0.55" stop-color="#ffd27a" />
          <stop offset="1" stop-color="#ffe8b0" />
        </linearGradient>
        <linearGradient id={id('sea')} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#3b6fb5" />
          <stop offset="1" stop-color="#1c3a6b" />
        </linearGradient>
        <clipPath id={id('clip')}>
          <rect x="54" y="48" width="172" height="178" rx="3" />
        </clipPath>
      </defs>
      <g transform="rotate(8 140 160)">
        <rect x="40" y="34" width="200" height="262" rx="6" fill="#fff" />
        <g clip-path={`url(#${id('clip')})`}>
          <rect x="54" y="48" width="172" height="178" fill={`url(#${id('sky')})`} />
          <circle cx="140" cy="150" r="30" fill="#fff4cf" />
          <path d="M54 160c30-18 56-22 84-8s58 8 88-6v80H54z" fill="#e2875b" opacity="0.7" />
          <rect x="54" y="168" width="172" height="58" fill={`url(#${id('sea')})`} />
          <path d="M70 186h30M120 198h44M180 182h28M84 210h22" stroke="#ffe8b0" stroke-width="3" stroke-linecap="round" opacity="0.7" />
          <path d="M150 100c6-6 12-6 16 0 4-6 10-6 16 0" stroke="#5a3a2a" stroke-width="3" fill="none" stroke-linecap="round" />
        </g>
        <text x="140" y="268" text-anchor="middle" font-family="'Caveat Variable', Caveat, cursive" font-weight="700" font-size="28" fill="#222">good times ♡</text>
      </g>
    </svg>
  )
}

{
  type === 'star' && (
    <svg viewBox="0 0 300 300" class="stk stk--star">
      <g transform="rotate(-10 150 150)">
        <path
          d="M150 22l24 50 54-14-14 54 50 24-50 24 14 54-54-14-24 50-24-50-54 14 14-54-50-24 50-24-14-54 54 14z"
          fill="#fff"
          stroke="#fff"
          stroke-width="30"
          stroke-linejoin="round"
        />
        <path
          d="M150 22l24 50 54-14-14 54 50 24-50 24 14 54-54-14-24 50-24-50-54 14 14-54-50-24 50-24-14-54 54 14z"
          fill="#ffd60a"
          stroke="#111"
          stroke-width="7"
          stroke-linejoin="round"
        />
        <text x="150" y="168" text-anchor="middle" font-family="'Inter Variable', Inter, sans-serif" font-weight="900" font-size="54" letter-spacing="-2" fill="#111">WOW!</text>
      </g>
    </svg>
  )
}

{
  type === 'smiley' && (
    <svg viewBox="0 0 300 300" class="stk stk--smiley">
      <g transform="rotate(10 150 150)">
        <circle cx="150" cy="150" r="118" fill="#fff" />
        <circle cx="150" cy="150" r="100" fill="#ffd60a" stroke="#111" stroke-width="7" />
        <ellipse cx="116" cy="128" rx="11" ry="17" fill="#111" />
        <ellipse cx="184" cy="128" rx="11" ry="17" fill="#111" />
        <path d="M96 168c24 42 84 42 108 0" stroke="#111" stroke-width="9" fill="none" stroke-linecap="round" />
        <ellipse cx="114" cy="92" rx="22" ry="11" fill="#fff" opacity="0.55" transform="rotate(-24 114 92)" />
      </g>
    </svg>
  )
}

{
  type === 'heart' && (
    <svg viewBox="0 0 300 300" class="stk stk--heart">
      <defs>
        <linearGradient id={id('h')} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ff7aa8" />
          <stop offset="1" stop-color="#e5285c" />
        </linearGradient>
      </defs>
      <g transform="rotate(-12 150 150)">
        <path d="M150 252C70 196 34 152 48 102c12-42 70-54 102-12 32-42 90-30 102 12 14 50-22 94-102 150z" fill="#fff" stroke="#fff" stroke-width="34" stroke-linejoin="round" />
        <path d="M150 252C70 196 34 152 48 102c12-42 70-54 102-12 32-42 90-30 102 12 14 50-22 94-102 150z" fill={`url(#${id('h')})`} stroke="#111" stroke-width="7" stroke-linejoin="round" />
        <path d="M86 108c4-16 18-26 34-24" stroke="#fff" stroke-width="10" fill="none" stroke-linecap="round" opacity="0.75" />
      </g>
    </svg>
  )
}

{
  type === 'bolt' && (
    <svg viewBox="0 0 300 300" class="stk stk--bolt">
      <g transform="rotate(8 150 150)">
        <path d="M170 18L64 168h76l-22 114 118-160h-80z" fill="#fff" stroke="#fff" stroke-width="34" stroke-linejoin="round" />
        <path d="M170 18L64 168h76l-22 114 118-160h-80z" fill="#ffd60a" stroke="#111" stroke-width="7" stroke-linejoin="round" />
        <path d="M150 54l-48 72" stroke="#fff" stroke-width="8" stroke-linecap="round" opacity="0.7" />
      </g>
    </svg>
  )
}

{
  type === 'bag' && (
    <svg viewBox="0 0 300 300" class="stk stk--bag">
      <g transform="rotate(-8 150 150)">
        <path d="M112 112c0-34 16-54 38-54s38 20 38 54" fill="none" stroke="#fff" stroke-width="40" stroke-linecap="round" />
        <path d="M76 104h148l14 146c1 11-7 20-18 20H80c-11 0-19-9-18-20z" fill="#fff" stroke="#fff" stroke-width="34" stroke-linejoin="round" />
        <path d="M112 112c0-34 16-54 38-54s38 20 38 54" fill="none" stroke="#111" stroke-width="8" stroke-linecap="round" />
        <path d="M76 104h148l14 146c1 11-7 20-18 20H80c-11 0-19-9-18-20z" fill="#ffd60a" stroke="#111" stroke-width="7" stroke-linejoin="round" />
        <circle cx="112" cy="134" r="7" fill="#111" />
        <circle cx="188" cy="134" r="7" fill="#111" />
        <path d="M118 184c16 24 48 24 64 0" fill="none" stroke="#111" stroke-width="8" stroke-linecap="round" />
        <path d="M92 128l7 96" stroke="#fff" stroke-width="9" stroke-linecap="round" opacity="0.75" />
      </g>
    </svg>
  )
}

{
  type === 'cart' && (
    <svg viewBox="0 0 320 300" class="stk stk--cart">
      <g transform="rotate(6 160 150)">
        <g fill="#fff" stroke="#fff" stroke-linejoin="round" stroke-linecap="round">
          <path d="M36 66h44l30 132h142l26-104H98z" stroke-width="40" />
          <rect x="120" y="40" width="50" height="58" rx="10" stroke-width="30" transform="rotate(-12 145 69)" />
          <rect x="178" y="48" width="56" height="48" rx="10" stroke-width="30" transform="rotate(10 206 72)" />
          <circle cx="128" cy="240" r="22" stroke-width="26" />
          <circle cx="232" cy="240" r="22" stroke-width="26" />
        </g>
        <rect x="120" y="40" width="50" height="58" rx="10" fill="#ff7aa8" stroke="#111" stroke-width="6.5" transform="rotate(-12 145 69)" />
        <rect x="178" y="48" width="56" height="48" rx="10" fill="#7be0b0" stroke="#111" stroke-width="6.5" transform="rotate(10 206 72)" />
        <path d="M98 94h180l-26 104H110z" fill="#8fd0ff" stroke="#111" stroke-width="7" stroke-linejoin="round" />
        <path d="M134 94l8 104M184 94l-2 104M232 94l-12 104M104 128h166M112 162h150" stroke="#111" stroke-width="4" opacity="0.28" />
        <path d="M36 66h44l30 132h142" fill="none" stroke="#111" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="128" cy="240" r="19" fill="#ffd60a" stroke="#111" stroke-width="7" />
        <circle cx="232" cy="240" r="19" fill="#ffd60a" stroke="#111" stroke-width="7" />
      </g>
    </svg>
  )
}

{
  type === 'card' && (
    <svg viewBox="0 0 320 240" class="stk stk--card">
      <defs>
        <linearGradient id={id('cc')} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#2b2b2f" />
          <stop offset="0.6" stop-color="#121214" />
          <stop offset="1" stop-color="#000" />
        </linearGradient>
      </defs>
      <g transform="rotate(-10 160 120)">
        <rect x="34" y="40" width="252" height="164" rx="22" fill="#fff" stroke="#fff" stroke-width="30" />
        <rect x="34" y="40" width="252" height="164" rx="22" fill={`url(#${id('cc')})`} stroke="#111" stroke-width="7" />
        <rect x="62" y="84" width="46" height="36" rx="7" fill="#ffd60a" stroke="#111" stroke-width="4" />
        <path d="M62 102h46M85 84v36" stroke="#111" stroke-width="3" opacity="0.5" />
        <path d="M64 160h40M118 160h40M172 160h40M226 160h28" stroke="#fff" stroke-width="9" stroke-linecap="round" opacity="0.8" />
        <circle cx="232" cy="96" r="22" fill="#ffd60a" opacity="0.95" />
        <circle cx="256" cy="96" r="22" fill="#ff8a3d" opacity="0.85" />
        <path d="M48 58c40-10 120-14 200-6" stroke="#fff" stroke-width="7" stroke-linecap="round" opacity="0.22" fill="none" />
      </g>
    </svg>
  )
}

{
  type === 'box' && (
    <svg viewBox="0 0 300 300" class="stk stk--box">
      <g transform="rotate(7 150 150)">
        <path d="M150 40l104 50v124l-104 50-104-50V90z" fill="#fff" stroke="#fff" stroke-width="36" stroke-linejoin="round" />
        <path d="M150 40l104 50-104 50-104-50z" fill="#f4c98a" stroke="#111" stroke-width="7" stroke-linejoin="round" />
        <path d="M46 90l104 50v124L46 214z" fill="#e0a660" stroke="#111" stroke-width="7" stroke-linejoin="round" />
        <path d="M254 90l-104 50v124l104-50z" fill="#c9884a" stroke="#111" stroke-width="7" stroke-linejoin="round" />
        <path d="M98 65l104 50v40l-26 12v-40L72 77z" fill="#ffd60a" stroke="#111" stroke-width="6" stroke-linejoin="round" />
        <path d="M150 182c-10-14-30-10-30 4 0 14 30 30 30 30s30-16 30-30c0-14-20-18-30-4z" fill="#ff5d8f" stroke="#111" stroke-width="5" transform="skewY(-26) translate(-14 82) scale(0.72)" />
      </g>
    </svg>
  )
}

{
  type === 'tag' && (
    <svg viewBox="0 0 300 300" class="stk stk--tag">
      <g transform="rotate(-18 150 150)">
        <path d="M60 110l62-62h118c8 0 14 6 14 14v118l-62 62c-6 6-15 6-21 0L60 131c-6-6-6-15 0-21z" fill="#fff" stroke="#fff" stroke-width="34" stroke-linejoin="round" />
        <path d="M60 110l62-62h118c8 0 14 6 14 14v118l-62 62c-6 6-15 6-21 0L60 131c-6-6-6-15 0-21z" fill="#ff5d5d" stroke="#111" stroke-width="7" stroke-linejoin="round" />
        <circle cx="212" cy="90" r="16" fill="#fff" stroke="#111" stroke-width="6" />
        <text x="150" y="178" text-anchor="middle" transform="rotate(45 150 162)" font-family="'Inter Variable', Inter, sans-serif" font-weight="900" font-size="52" letter-spacing="-2" fill="#fff" stroke="#111" stroke-width="2.5" paint-order="stroke">{'</>'}</text>
      </g>
    </svg>
  )
}
