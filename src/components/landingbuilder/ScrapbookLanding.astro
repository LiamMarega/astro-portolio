---
import ProjectBook from "../scrapbook/ProjectBook.astro";
import QualForm from "./QualForm.tsx";
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";

const services = [
  { number: "01", title: "Un mensaje claro.", text: "Ordenamos tu oferta y escribimos los textos para que se entienda qué hacés y por qué elegirte." },
  { number: "02", title: "Un diseño tuyo.", text: "Una identidad visual a medida, con una acción principal y una buena experiencia en el celular." },
  { number: "03", title: "Una web lista.", text: "Desarrollo, publicación e integraciones definidas según lo que necesita tu proyecto." },
];
const steps = [
  { title: "Conversamos", text: "Entendemos tu negocio y definimos el alcance." },
  { title: "Le damos forma", text: "Diseño, textos y desarrollo, con tu feedback." },
  { title: "Publicamos", text: "Revisamos los detalles y dejamos la web lista." },
];
const questions = [
  { q: "¿Cuánto cuesta?", a: "Las landings parten de USD 600. Definimos el presupuesto final según el alcance antes de empezar." },
  { q: "¿Cuánto tarda?", a: "Entre 7 y 21 días hábiles, según la complejidad y el flujo de feedback." },
  { q: "¿Incluye los textos?", a: "Sí. El trabajo incluye el diseño, los textos y el desarrollo de la landing." },
  { q: "¿Qué pasa después del lanzamiento?", a: "Incluye 14 días de soporte post-lanzamiento para ajustes. Las necesidades de edición y mantenimiento se definen según el proyecto." },
];
---

<div class="sl-page">
  <header class="sl-nav">
    <a class="sl-brand" href="/es/" aria-label="LiamDev, inicio">Liam<span>Dev.</span></a>
    <nav aria-label="Navegación principal">
      <a class="sl-nav-secondary" href="#landing-work" data-open-book>Trabajos</a>
      <a class="sl-nav-secondary" href="#proceso">Proceso</a>
      <a class="sl-nav-cta" href="#calificar">Hablemos <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <section class="sl-hero" aria-labelledby="sl-title">
    <div class="sl-hero-copy">
      <p class="sl-kicker"><span aria-hidden="true">✳</span> DISEÑO & DESARROLLO WEB INDEPENDIENTE</p>
      <h1 id="sl-title">Tu próxima landing,<br /><em>con intención.</em></h1>
      <p class="sl-lead">Diseño, textos y desarrollo para que tu oferta se entienda y sea fácil dar el siguiente paso.</p>
      <div class="sl-actions">
        <a class="sl-button" href="#calificar">Hablemos de tu landing <span aria-hidden="true">↗</span></a>
        <a class="sl-text-link" href="#landing-work" data-open-book>Abrir mis trabajos <span aria-hidden="true">→</span></a>
      </div>
      <p class="sl-price">Desde <strong>USD 600</strong> <span aria-hidden="true">/</span> Diseño + textos + desarrollo</p>
      <div class="sl-signature" id="sobre">
        <img src="/images/uploads/liam.jpg" width="48" height="48" alt="Liam Marega" decoding="async" />
        <div><strong>Soy Liam.</strong><span>Hablás conmigo. La desarrollo yo.</span></div>
        <span class="sl-hand" aria-hidden="true">sin intermediarios.</span>
      </div>
    </div>
    <div class="sl-book-area" id="resultados">
      <span class="sl-book-note" aria-hidden="true">menos promesas, más proyectos ↓</span>
      <ProjectBook id="landing-work" collection="web" locale="es" />
    </div>
  </section>

  <section id="servicios" class="sl-chapter" aria-labelledby="sl-services-title">
    <header class="sl-section-head"><p class="sl-kicker">01 / QUÉ HACEMOS</p><h2 id="sl-services-title">Todo lo necesario.<br /><em>Nada porque sí.</em></h2></header>
    <div class="sl-services">
      {services.map((service) => <article class="sl-service"><span class="sl-service-number" aria-hidden="true">{service.number}</span><h3>{service.title}</h3><p>{service.text}</p></article>)}
    </div>
    <div id="proceso" class="sl-process">
      <span id="vsl" class="sl-anchor" aria-hidden="true"></span>
      <div><p class="sl-kicker">02 / CÓMO TRABAJAMOS</p><h3>De la charla<br />a la pantalla.</h3></div>
      <ol>{steps.map((step) => <li><strong>{step.title}</strong><p>{step.text}</p></li>)}</ol>
    </div>
  </section>

  <section id="faq" class="sl-chapter sl-faq" aria-labelledby="sl-faq-title">
    <header class="sl-section-head"><p class="sl-kicker">03 / ANTES DE EMPEZAR</p><h2 id="sl-faq-title">Las dudas,<br /><em>sobre la mesa.</em></h2></header>
    <div class="sl-questions">{questions.map((question) => <details><summary>{question.q}<span aria-hidden="true">+</span></summary><p>{question.a}</p></details>)}</div>
  </section>

  <section id="calificar" class="sl-chapter sl-contact" aria-labelledby="sl-contact-title">
    <div class="sl-contact-copy" id="contacto"><p class="sl-kicker">04 / TU PRÓXIMO PROYECTO</p><h2 id="sl-contact-title">Contame qué tenés<br /><em>en mente.</em></h2><p>Seis preguntas breves para entender tu proyecto. Después te pido tus datos de contacto.</p><span class="sl-hand" aria-hidden="true">empezamos con una conversación.</span><a class="sl-contact-alternative" href="/es/portfolio/#contact">O contactame desde el portfolio <span aria-hidden="true">↗</span></a></div>
    <div class="sl-form"><QualForm client:visible /></div>
  </section>

  <footer class="sl-footer"><a class="sl-brand" href="/es/">Liam<span>Dev.</span></a><p>Diseñado y desarrollado por Liam Marega.</p><nav aria-label="Más información"><a href="/es/portfolio/">Portfolio</a><a href="/landing-builder/articulos/">Artículos</a><a href="/landing/builder/privacy">Privacidad</a></nav></footer>
</div>

<style>
  .sl-page { --sl-ink:#29251e; --sl-muted:#676052; --sl-line:#d6cdb9; width:min(1200px,calc(100% - 80px)); margin:auto; font-family:"Inter",sans-serif; color:var(--sl-ink); }
  .sl-page *, .sl-page *::before,.sl-page *::after { box-sizing:border-box; }
  .sl-page :is(a,button,summary):focus-visible { outline:3px solid #6b5834; outline-offset:5px; }
  .sl-nav { display:flex; align-items:center; justify-content:space-between; gap:25px; padding:22px 0; border-bottom:1px solid var(--sl-line); }
  .sl-brand { color:var(--sl-ink); text-decoration:none; font:600 26px/1 "Source Serif 4",Georgia,serif; letter-spacing:-.07em; }
  .sl-brand span { font-style:italic; }
  .sl-nav nav { display:flex; align-items:center; gap:30px; }
  .sl-nav nav a { display:inline-flex; align-items:center; gap:20px; min-height:44px; color:var(--sl-ink); font:600 12px/1.4 "Inter",sans-serif; text-decoration:none; }
  .sl-nav nav .sl-nav-cta { border-bottom:1px solid var(--sl-ink); }
  .sl-hero { display:grid; grid-template-columns:1fr 1.05fr; align-items:center; gap:60px; padding:78px 0 94px; }
  .sl-page .sl-kicker { display:flex; align-items:center; gap:9px; margin:0 0 24px; color:#6a614e; font:600 10px/1.6 "Inter",sans-serif; letter-spacing:.11em; }
  .sl-kicker>span { color:#6b7049; font-size:24px; }
  .sl-page h1 { margin:0; color:var(--sl-ink); font:600 clamp(43px,4.8vw,70px)/1.02 "Source Serif 4",Georgia,serif; letter-spacing:-.055em; }
  .sl-page h1 em,.sl-page h2 em { font-weight:400; }
  .sl-page h1 em { background:linear-gradient(transparent 71%,#e7cc743f 71%,#e7cc746b 94%,transparent 94%); }
  .sl-page .sl-lead { max-width:420px; margin:25px 0 30px; color:var(--sl-muted); font:400 17px/1.75 "Inter",sans-serif; }
  .sl-actions { display:flex; align-items:flex-start; flex-direction:column; gap:14px; }
  .sl-button { display:inline-flex; align-items:center; justify-content:space-between; gap:25px; min-height:54px; padding:15px 21px; color:#29251e; background:#edd47d; border:1px solid #c2a953; box-shadow:3px 3px 0 #392f1821; border-radius:2px; font:600 13px/1.5 "Inter",sans-serif; text-decoration:none; transition:background .2s ease; }
  .sl-button:hover { background:#e6c65c; }
  .sl-text-link { display:inline-flex; align-items:center; gap:18px; min-height:44px; color:#534d40; font:400 12px/1.5 "Inter",sans-serif; text-decoration:underline; text-underline-offset:5px; }
  .sl-page .sl-price { margin:18px 0 0; color:var(--sl-muted); font:400 11px/1.8 "Inter",sans-serif; }
  .sl-price>span { padding:0 8px; color:#8a806a; }
  .sl-signature { display:flex; align-items:center; flex-wrap:wrap; gap:11px; margin-top:38px; }
  .sl-signature img { width:44px; height:44px; object-fit:cover; object-position:50% 28%; padding:3px; background:#fffdf7; box-shadow:1px 2px 4px #40371e30; transform:rotate(-5deg); }
  .sl-signature div { display:flex; flex-direction:column; gap:3px; font:400 11px/1.5 "Inter",sans-serif; color:var(--sl-muted); }
  .sl-signature strong { color:var(--sl-ink); font-weight:600; }
  .sl-hand { font:600 23px/1.1 "Caveat",cursive; color:#75643d; }
  .sl-signature>.sl-hand { margin-left:3px; transform:rotate(-6deg); font-size:20px; }
  .sl-book-area { position:relative; min-width:0; padding:10px 0; }
  .sl-book-note { display:block; margin:0 auto 26px; text-align:center; font:600 23px/1.2 "Caveat",cursive; color:#756c51; transform:rotate(-3deg); }
  .sl-chapter { border-top:1px solid var(--sl-line); padding:64px 0; scroll-margin-top:25px; }
  .sl-section-head { margin-bottom:36px; }
  .sl-page h2 { margin:0; color:var(--sl-ink); font:600 clamp(34px,3.6vw,49px)/1.07 "Source Serif 4",Georgia,serif; letter-spacing:-.04em; }
  .sl-page .sl-section-head .sl-kicker { margin-bottom:16px; }
  .sl-services { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:22px; }
  .sl-service { position:relative; padding:33px 28px 30px; background:#fffdf6; border:1px solid #ddd4c0; box-shadow:3px 4px 0 #ede7d8,4px 5px 0 #d6cebb; }
  .sl-service:nth-child(2) { background:#f4edda; }
  .sl-service::before { content:""; position:absolute; top:-11px; left:34%; width:30%; height:23px; background:#dacb9d75; transform:rotate(-4deg); clip-path:polygon(1% 0,99% 5%,96% 100%,0 94%); }
  .sl-service-number { display:block; margin-bottom:25px; color:#8d8269; font:italic 28px/1 "Source Serif 4",Georgia,serif; }
  .sl-page .sl-service h3 { margin:0 0 13px; color:var(--sl-ink); font:600 25px/1.1 "Source Serif 4",Georgia,serif; letter-spacing:-.03em; }
  .sl-page .sl-service p { margin:0; font:400 14px/1.7 "Inter",sans-serif; color:var(--sl-muted); }
  .sl-anchor { position:absolute; pointer-events:none; }
  .sl-process { position:relative; display:grid; grid-template-columns:1fr 2fr; gap:40px; padding-top:62px; scroll-margin-top:35px; }
  .sl-page .sl-process .sl-kicker { margin-bottom:15px; }
  .sl-page .sl-process h3 { margin:0; font:600 30px/1.1 "Source Serif 4",Georgia,serif; letter-spacing:-.03em; }
  .sl-process ol { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:22px; list-style:none; margin:0; padding:0; counter-reset:process; }
  .sl-process li { padding-top:20px; border-top:1px solid #c7b98f; counter-increment:process; }
  .sl-process li::before { content:"0" counter(process); display:block; margin-bottom:15px; color:#8d805f; font:600 12px/1 "Inter",sans-serif; }
  .sl-process li strong { font:600 13px/1.4 "Inter",sans-serif; }
  .sl-page .sl-process li p { margin:10px 0 0; font:400 12px/1.7 "Inter",sans-serif; color:var(--sl-muted); }
  .sl-faq { display:grid; grid-template-columns:1fr 1.3fr; gap:70px; }
  .sl-questions details { border-bottom:1px solid var(--sl-line); }
  .sl-questions summary { display:flex; justify-content:space-between; align-items:center; gap:20px; min-height:65px; cursor:pointer; list-style:none; padding:18px 0; color:var(--sl-ink); font:600 14px/1.5 "Inter",sans-serif; }
  .sl-questions summary::-webkit-details-marker { display:none; }
  .sl-questions summary>span { font:400 24px/1 "Source Serif 4",Georgia,serif; transition:transform .2s; }
  .sl-questions details[open] summary>span { transform:rotate(45deg); }
  .sl-page .sl-questions p { margin:0 0 22px; max-width:48ch; color:var(--sl-muted); font:400 14px/1.75 "Inter",sans-serif; }
  .sl-contact { display:grid; grid-template-columns:1fr 1.3fr; align-items:start; gap:70px; padding:70px 0 85px; }
  .sl-page .sl-contact-copy>p:not(.sl-kicker) { max-width:32ch; margin:23px 0; font:400 14px/1.75 "Inter",sans-serif; color:var(--sl-muted); }
  .sl-contact-copy>.sl-hand { display:block; margin:26px 0; }
  .sl-contact-alternative { display:inline-flex; align-items:center; min-height:44px; gap:8px; max-width:100%; font:400 11px/1.6 "Inter",sans-serif; color:#605845; text-decoration:underline; text-underline-offset:4px; }
  .sl-form { min-width:0; }
  .sl-footer { display:flex; flex-wrap:wrap; align-items:center; gap:25px; padding:28px 0; border-top:1px solid var(--sl-line); }
  .sl-page .sl-footer p { margin:0; color:var(--sl-muted); font:400 10px/1.6 "Inter",sans-serif; }
  .sl-footer nav { margin-left:auto; display:flex; align-items:center; flex-wrap:wrap; gap:18px; }
  .sl-footer nav a { display:inline-flex; align-items:center; min-height:44px; font:400 11px/1.5 "Inter",sans-serif; color:var(--sl-muted); text-decoration:none; }
  @media (max-width:1000px) { .sl-page { width:calc(100% - 48px); } .sl-hero { gap:30px; padding-top:50px; } .sl-signature>.sl-hand { display:none; } .sl-services { gap:16px; } .sl-service { padding:30px 20px; } .sl-faq,.sl-contact { gap:35px; } .sl-process { grid-template-columns:1fr; gap:25px; } }
  @media (max-width:700px) { .sl-page { width:calc(100% - 36px); } .sl-nav { padding:14px 0; gap:12px; } .sl-nav nav { gap:18px; } .sl-nav .sl-nav-secondary { display:none; } .sl-hero { grid-template-columns:1fr; gap:45px; padding:45px 0 50px; } .sl-page h1 { font-size:clamp(39px,10vw,58px); } .sl-page .sl-lead { font-size:16px; margin:22px 0; } .sl-page .sl-kicker { font-size:9px; letter-spacing:.06em; } .sl-actions { gap:7px; } .sl-button { width:100%; } .sl-signature { margin-top:25px; } .sl-book-area { padding:0 8px; } .sl-book-note { margin-bottom:22px; font-size:21px; } .sl-services,.sl-faq,.sl-contact { grid-template-columns:1fr; } .sl-services { gap:25px; } .sl-service { padding:25px; } .sl-service-number { margin-bottom:18px; } .sl-chapter { padding:43px 0; } .sl-process { padding-top:42px; } .sl-process ol { grid-template-columns:1fr; gap:20px; } .sl-process li { position:relative; padding:18px 0 0 35px; } .sl-process li::before { position:absolute; top:21px; left:0; } .sl-faq,.sl-contact { gap:10px; } .sl-section-head { margin-bottom:28px; } .sl-contact-copy>.sl-hand { margin:20px 0 10px; } .sl-form { margin-top:24px; } .sl-footer { gap:16px; } .sl-footer nav { margin-left:0; width:100%; } }
  @media (prefers-reduced-motion:reduce) { .sl-page * { transition:none !important; animation:none !important; } }
</style>
<style is:global>
  /* Opt out of the legacy fixed-nav offset only on this route, not articles. */
  .lb-root main:has(> .sl-page) { padding-top:0; }
  @media (prefers-reduced-motion:reduce) { html:has(.sl-page) { scroll-behavior:auto; } }
</style>
