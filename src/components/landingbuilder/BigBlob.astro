---
interface Props {
  size?: number;
  rotate?: string;
  flip?: boolean;
  drift?: boolean;
  parallax?: number;
  blur?: string;
  style?: string;
}
const {
  size = 520,
  rotate = "0deg",
  flip = false,
  drift = true,
  parallax,
  blur,
  style = "",
} = Astro.props;
const imgStyle = `transform:rotate(${rotate})${flip ? " scaleX(-1)" : ""}${blur ? `;filter:blur(${blur})` : ""}`;
---

<div
  class="big-blob"
  data-drift={drift ? "1" : undefined}
  data-parallax={parallax}
  style={`width:${size}px;height:${size}px;${style}`}
  aria-hidden="true"
>
  <img src="/images/uploads/blob.webp" width={size} height={size} alt="" loading="lazy" decoding="async" style={imgStyle} />
</div>
