---
// Preserved /gallery page (original design). Tailwind's preflight reset it relied on is precompiled
// (src/styles/legacy/gallery.css, npm run legacy:css); the page itself is plain CSS.
import "../styles/legacy/gallery.css";
import GalleryComponent from "../components/gallery/index.astro";
import LegacyHead from "../components/ui/LegacyHead.astro";
import { legacySeo, legacyPageGraph } from "../content/seo";
import { ogUrlFor } from "../content/og";

const { lang, title, description } = legacySeo.gallery;
const jsonLd = legacyPageGraph(lang, {
  path: "/gallery/",
  title,
  description,
  crumb: "Project Gallery",
  type: "CollectionPage",
  image: ogUrlFor("/gallery/"),
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <LegacyHead title={title} description={description} lang={lang} jsonLd={jsonLd} analytics={false} />

    <style>
      /* Reset and base styles */
      * {
        box-sizing: border-box;
      }
      
      html {
        scroll-behavior: smooth;
      }
      
      body {
        margin: 0;
        padding: 0;
        background-color: #121212;
        color: white;
        font-family: system-ui, -apple-system, sans-serif;
        line-height: 1.6;
        overflow-x: hidden;
      }
      
      /* Skip to main content for accessibility */
      .skip-link {
        position: absolute;
        top: -40px;
        left: 6px;
        background: #000;
        color: #fff;
        padding: 8px;
        text-decoration: none;
        border-radius: 4px;
        z-index: 1000;
      }
      
      .skip-link:focus {
        top: 6px;
      }
      
      /* Mobile-first responsive adjustments */
      @media (max-width: 480px) {
        body {
          font-size: 14px;
        }
      }
      
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </head>
  <body>
    <a href="#gallery" class="skip-link">Skip to main content</a>
    <GalleryComponent />
  </body>
</html>
