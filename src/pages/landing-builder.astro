---
import Layout from '../layouts/LandingBuilderLayout.astro';
import ProjectBook from '../components/landingbuilder/ProjectBook.astro';
import QualForm from '../components/landingbuilder/QualForm';
import '../styles/landing-scrapbook.css';

const services = [
  { n: '01', title: 'Mensaje y estructura', description: 'Ordenamos tu oferta y escribimos el contenido para que se entienda.', detail: 'Copy estratégico, jerarquía de la información y llamados a la acción.' },
  { n: '02', title: 'Diseño y desarrollo', description: 'Una página a medida, cuidada en desktop y en el celular.', detail: 'Diseño sin plantillas, desarrollo responsive y optimización de carga.' },
  { n: '03', title: 'Publicación e integraciones', description: 'Dejamos tu landing online y conectada con las herramientas que necesitás.', detail: 'Email, CRM y analíticas según el alcance acordado para tu proyecto.' },
];
const steps = [
  { title: 'Entendemos tu negocio', description: 'Definimos qué ofrecés, a quién y qué acción debería tomar el visitante.' },
  { title: 'Diseñamos tu landing', description: 'Trabajamos el contenido y el diseño; revisamos juntos antes de avanzar.' },
  { title: 'Publicamos', description: 'Desarrollamos, probamos las integraciones y dejamos la página lista.' },
];
// Existing commercial conditions, shortened presentation only.
const faqs = [
  { q: '¿En cuánto tiempo está lista?', a: 'Entre 7 y 21 días hábiles según complejidad y flujo de feedback.' },
  { q: '¿Incluye los textos?', a: 'Sí. Incluye copy estratégico enfocado en conversión.' },
  { q: '¿La puedo editar después?', a: 'Sí, te entrego todo listo para que vos o tu equipo puedan editar.' },
  { q: '¿Qué plataforma usás?', a: 'Desarrollo a medida (Webflow / Next.js) según necesidades del proyecto.' },
  { q: '¿Qué pasa después del lanzamiento?', a: 'Incluye 14 días de soporte post-lanzamiento para ajustes y optimizaciones.' },
];
---

<Layout title="LiamDev — Diseño y desarrollo de landing pages a medida" description="Una landing que explique tu negocio y dé ganas de contactarte. Mirá mis proyectos y contame qué necesitás construir.">
  <div class="sb" id="top">
    <header class="sb-nav">
      <a href="#top" class="sb-logo" aria-label="LiamDev — inicio">Liam<span class="sb-logo-suffix">Dev</span><span class="sb-logo-dot" aria-hidden="true">.</span></a>
      <nav aria-label="Navegación principal">
        <a href="#proyectos">Proyectos</a>
        <a href="#proceso">Cómo trabajo</a>
        <a href="#calificar" class="sb-nav-contact">Hablemos</a>
      </nav>
    </header>

    <div class="sb-container">
      <section class="sb-hero" aria-labelledby="sb-hero-title">
        <div class="sb-hero-copy">
          <p class="sb-label">Diseño y desarrollo web a medida</p>
          <h1 id="sb-hero-title">Una landing que explique tu negocio.<br /><em>Y dé ganas de <span class="sb-highlight">contactarte.</span></em></h1>
          <p class="sb-lead">Diseño, escribo y desarrollo tu página para que tus visitantes entiendan lo que ofrecés y sepan cómo dar el siguiente paso.</p>
          <div class="sb-hero-actions">
            <a class="sb-button" href="#calificar">Hablemos de tu landing <span aria-hidden="true">↗</span></a>
            <a class="sb-text-link" href="#proyectos">Ver proyectos <span aria-hidden="true">↓</span></a>
          </div>
          <p class="sb-price">Desde <strong>USD 600</strong> <span>· Según el alcance de tu proyecto</span></p>
        </div>
        <aside class="sb-personal-note" aria-label="Trabajo directo con Liam">
          <span class="sb-paper-tape" aria-hidden="true"></span>
          <p>De la primera idea al lanzamiento, trabajás conmigo.</p>
          <span class="sb-signature">Liam</span>
        </aside>
      </section>

      <section class="sb-section sb-projects" id="proyectos" aria-labelledby="sb-projects-title">
        <span id="resultados" class="sb-anchor" aria-hidden="true"></span>
        <div class="sb-section-heading">
          <p class="sb-label">01 / Proyectos</p>
          <h2 id="sb-projects-title">Trabajo que podés <em>explorar.</em></h2>
          <p>Abrí el cuaderno o mirá los proyectos en lista.</p>
        </div>
        <ProjectBook />
      </section>

      <section class="sb-section" id="servicios" aria-labelledby="sb-services-title">
        <span id="vsl" class="sb-anchor" aria-hidden="true"></span>
        <span id="problemas" class="sb-anchor" aria-hidden="true"></span>
        <div class="sb-section-heading">
          <p class="sb-label">02 / Qué incluye</p>
          <h2 id="sb-services-title">De la idea a <em>tu página.</em></h2>
        </div>
        <div class="sb-service-grid">
          {services.map((service) => (
            <article class="sb-service-card">
              <span class="sb-service-number" aria-hidden="true">{service.n}</span>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <details><summary>Ver detalle</summary><p>{service.detail}</p></details>
            </article>
          ))}
        </div>
      </section>

      <section class="sb-section sb-process" id="proceso" aria-labelledby="sb-process-title">
        <div class="sb-process-intro">
          <p class="sb-label">03 / Cómo trabajo</p>
          <h2 id="sb-process-title">Un proceso claro.<br /><em>Sin vueltas.</em></h2>
          <figure class="sb-author" id="sobre">
            <img src="/images/uploads/liam.jpg" alt="Liam Marega" width="80" height="96" loading="lazy" decoding="async" />
            <figcaption><span class="sb-signature">Liam</span><span>Diseño y desarrollo.<br />Sin intermediarios.</span></figcaption>
          </figure>
        </div>
        <ol class="sb-process-list">
          {steps.map((step, index) => (
            <li><span aria-hidden="true">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>
          ))}
        </ol>
      </section>

      <section class="sb-section sb-faq" id="faq" aria-labelledby="sb-faq-title">
        <div class="sb-section-heading"><p class="sb-label">04 / Preguntas frecuentes</p><h2 id="sb-faq-title">Antes de <em>empezar.</em></h2></div>
        <div class="sb-faq-list">{faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</div>
      </section>

      <section class="sb-section sb-contact" id="contacto" aria-labelledby="sb-contact-title">
        <span id="calificar" class="sb-anchor" aria-hidden="true"></span>
        <div class="sb-contact-copy">
          <p class="sb-label">05 / Hablemos</p>
          <h2 id="sb-contact-title">Contame qué necesitás <em>construir.</em></h2>
          <p>Dejame algunos datos de tu proyecto y te respondo con el próximo paso.</p>
          <a href="mailto:hola@liammdev.com" class="sb-text-link">¿Preferís email? Escribime <span aria-hidden="true">↗</span></a>
        </div>
        <div class="sb-contact-island">
          <QualForm client:visible />
          <noscript><p>El formulario necesita JavaScript. Podés contarme tu proyecto por <a href="mailto:hola@liammdev.com">email</a>.</p><style is:inline>.sb-contact-island .lc-form{display:none}</style></noscript>
        </div>
      </section>
    </div>

    <footer class="sb-footer">
      <span>© {new Date().getFullYear()} · LiamDev</span>
      <div><a href="/es/portfolio/">Portfolio</a><a href="/landing-builder/articulos">Artículos</a><a href="https://instagram.com/liammdev" target="_blank" rel="noopener noreferrer">Instagram<span class="sb-sr-only"> (abre otra pestaña)</span></a><a href="/landing/builder/privacy">Privacidad y términos</a></div>
    </footer>
  </div>
</Layout>
