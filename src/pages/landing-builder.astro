---
import Layout from '../layouts/LandingBuilderLayout.astro';
import Navbar from '../components/landingbuilder/Navbar.astro';
import Hero from '../components/landingbuilder/Hero.astro';
import Trust from '../components/landingbuilder/Trust.astro';
import Problems from '../components/landingbuilder/Problems.astro';
import VSL from '../components/landingbuilder/VSL.astro';
import TornDivider from '../components/landingbuilder/TornDivider.astro';
import Approach from '../components/landingbuilder/Approach.astro';
import Transformation from '../components/landingbuilder/Transformation.astro';
import Portfolio from '../components/landingbuilder/Portfolio.astro';
import Qualification from '../components/landingbuilder/Qualification.astro';
import Caso from '../components/landingbuilder/Caso.astro';
import FAQ from '../components/landingbuilder/FAQ.astro';
import CTA from '../components/landingbuilder/CTA.astro';
import Footer from '../components/landingbuilder/Footer.astro';
import BookIntro from '../components/landingbuilder/BookIntro.astro';
import BookTabs from '../components/landingbuilder/BookTabs.astro';
import StickyCTA from '../components/landingbuilder/StickyCTA.astro';
---

<Layout
  title="Landing page profesional que convierte | LiamDev"
  description="Diseño y desarrollo de landing pages estratégicas para coaches, consultores, marcas personales y negocios digitales que quieren vender más."
>
  <BookIntro />
  <Navbar />
  <BookTabs />
  <Hero />
  <Trust />
  <Problems />
  <VSL />
  <TornDivider />
  <div class="band">
    <Approach />
    <Transformation />
  </div>
  <TornDivider up />
  <Portfolio />
  <Qualification />
  <Caso />
  <FAQ />
  <CTA />
  <Footer />
  <StickyCTA />
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rectInvalidators: Array<() => void> = [];

  // ---------- Reveal on scroll ----------
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.12, rootMargin: '0px 0px -60px 0px' },
  );
  document.querySelectorAll('.reveal, .hl, .scribble').forEach((el) => io.observe(el));

  // ---------- Hand-drawn pencil borders (size to parent) ----------
  function sizeSketch(svg: SVGSVGElement) {
    const parent = svg.parentElement;
    if (!parent) return;
    const r = parent.getBoundingClientRect();
    const w = r.width, h = r.height;
    if (!w || !h) return;
    const pad = parseFloat(svg.dataset.pad || '3');
    const rad = 10;
    const x0 = pad + 1, y0 = pad + 1, x1 = w - pad - 1, y1 = h - pad - 1;
    const d =
      `M ${x0 + rad} ${y0} L ${x1 - rad} ${y0} Q ${x1} ${y0} ${x1} ${y0 + rad} ` +
      `L ${x1} ${y1 - rad} Q ${x1} ${y1} ${x1 - rad} ${y1} ` +
      `L ${x0 + rad} ${y1} Q ${x0} ${y1} ${x0} ${y1 - rad} ` +
      `L ${x0} ${y0 + rad} Q ${x0} ${y0} ${x0 + rad} ${y0} Z`;
    svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    svg.querySelector('path')?.setAttribute('d', d);
  }
  const sketches = document.querySelectorAll<SVGSVGElement>('svg.sketch-border[data-pad]');
  if ('ResizeObserver' in window) {
    const ro = new ResizeObserver((entries) => {
      for (const en of entries) {
        const svg = en.target.querySelector<SVGSVGElement>('svg.sketch-border[data-pad]');
        if (svg) sizeSketch(svg);
      }
    });
    sketches.forEach((svg) => { if (svg.parentElement) ro.observe(svg.parentElement); sizeSketch(svg); });
  } else {
    sketches.forEach(sizeSketch);
    globalThis.addEventListener('resize', () => sketches.forEach(sizeSketch));
  }

  // ---------- Hero collage parallax entries (driven by unified scroll rAF below) ----------
  const heroConfig: Record<string, [number, number]> = {
    photo: [1.2, -0.04], usd: [2.5, 0.05], dev: [-1.6, 0.07], seal: [-14, 0.03],
  };
  const heroEls: Array<[HTMLElement, number, number]> = [];
  if (!reduce) {
    for (const [k, [rot, mul]] of Object.entries(heroConfig)) {
      const el = document.querySelector<HTMLElement>(`[data-hero="${k}"]`);
      if (el) heroEls.push([el, rot, mul]);
    }
  }

  // ---------- GSAP: magnetic buttons + scroll triggers + offscreen-paused drift ----------
  const driftTweens = new Map<Element, gsap.core.Tween>();
  const visibleDriftEls = new Set<Element>();
  const visibleAnimEls = new Set<Element>();

  if (!reduce) {
    const fine = window.matchMedia('(pointer: fine)').matches;
    if (fine) {
      document.querySelectorAll<HTMLElement>('.magnet').forEach((el) => {
        const qx = gsap.quickTo(el, 'x', { duration: 0.5, ease: 'power3' });
        const qy = gsap.quickTo(el, 'y', { duration: 0.5, ease: 'power3' });
        let rect: DOMRect | null = null;
        rectInvalidators.push(() => { rect = null; });
        const enter = () => { rect = el.getBoundingClientRect(); };
        const move = (e: MouseEvent) => {
          const r = rect || (rect = el.getBoundingClientRect());
          qx((e.clientX - (r.left + r.width / 2)) * 0.3);
          qy((e.clientY - (r.top + r.height / 2)) * 0.3);
        };
        const leave = () => { rect = null; qx(0); qy(0); };
        el.addEventListener('mouseenter', enter);
        el.addEventListener('mousemove', move);
        el.addEventListener('mouseleave', leave);
      });
    }

    gsap.registerPlugin(ScrollTrigger);

    // Stickers / stamps entrance
    document.querySelectorAll<HTMLElement>('.seal, .vsl-badge, .num-flag, .qual-arrow').forEach((el) => {
      gsap.from(el, {
        scale: 1.9, opacity: 0, duration: 0.5, ease: 'back.out(2.2)',
        scrollTrigger: { trigger: el, start: 'top 92%', once: true },
      });
    });

    // Tape strips entrance (GPU composited)
    document.querySelectorAll<HTMLElement>('.tape').forEach((el, i) => {
      gsap.from(el, {
        opacity: 0, scale: 1.4, duration: 0.38, delay: (i % 3) * 0.07, ease: 'power2.out',
        force3D: true,
        scrollTrigger: { trigger: el.parentElement || el, start: 'top 90%', once: true },
      });
    });

    // 3D hover tilt on cards (cached rect on mouseenter + rAF-coalesced writes)
    if (fine) {
      document.querySelectorAll<HTMLElement>('.card, .photo-card, .note, .faq-item, .art-card').forEach((el) => {
        if (el.closest('.hero .collage')) return;
        const max = 3.4;
        let rect: DOMRect | null = null;
        let tiltRaf = 0;
        let resetTimer = 0;
        let lastX = 0;
        let lastY = 0;
        rectInvalidators.push(() => { rect = null; });

        const applyTilt = () => {
          tiltRaf = 0;
          const r = rect || (rect = el.getBoundingClientRect());
          if (!r.width || !r.height) return;
          const px = (lastX - r.left) / r.width - 0.5;
          const py = (lastY - r.top) / r.height - 0.5;
          el.style.transition = 'transform 0.12s ease-out, box-shadow 0.2s ease';
          el.style.transform =
            `perspective(700px) rotateX(${(-py * max).toFixed(2)}deg) rotateY(${(px * max).toFixed(2)}deg) translateZ(8px)`;
          el.classList.add('tilting');
        };
        const enter = () => {
          clearTimeout(resetTimer);
          rect = el.getBoundingClientRect();
        };
        const move = (e: MouseEvent) => {
          lastX = e.clientX;
          lastY = e.clientY;
          if (!tiltRaf) tiltRaf = requestAnimationFrame(applyTilt);
        };
        const leave = () => {
          if (tiltRaf) { cancelAnimationFrame(tiltRaf); tiltRaf = 0; }
          rect = null;
          el.style.transition = 'transform 0.45s ease, box-shadow 0.3s ease';
          el.style.transform = '';
          el.classList.remove('tilting');
          clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            if (!el.classList.contains('tilting')) el.style.transition = '';
          }, 480);
        };
        el.addEventListener('mouseenter', enter);
        el.addEventListener('mousemove', move);
        el.addEventListener('mouseleave', leave);
      });
    }

    // Case study counters
    document.querySelectorAll<HTMLElement>('#resultados .stats strong').forEach((el) => {
      const raw = (el.textContent || '').trim();
      const m = raw.match(/^([+\-]?)(\d+(?:\.\d+)?)(.*)$/);
      if (!m) return;
      const sign = m[1], end = parseFloat(m[2]), suffix = m[3];
      const dec = m[2].includes('.') ? 1 : 0;
      const obj = { v: 0 };
      gsap.to(obj, {
        v: end, duration: 1.6, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        onUpdate: () => { el.textContent = sign + obj.v.toFixed(dec) + suffix; },
      });
    });

    // Handwritten reveal wipe
    document
      .querySelectorAll<HTMLElement>('.note p, .side, .qual-side, .signature, .hero-handwrite, .lbl-hand')
      .forEach((el) => {
        el.classList.add('write');
        ScrollTrigger.create({
          trigger: el,
          start: 'top 88%',
          once: true,
          onEnter: () => el.classList.add('written'),
        });
      });

    document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
      const spd = parseFloat(el.getAttribute('data-parallax') || '0.2') || 0.2;
      gsap.to(el, {
        yPercent: spd * -100,
        ease: 'none',
        scrollTrigger: {
          trigger: el.closest('section, .caso-wrap, .vsl-wrap') || el,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 1,
        },
      });
    });

    // Infinite [data-drift] tweens: paused when offscreen or tab hidden
    const driftEls = document.querySelectorAll<HTMLElement>('[data-drift]');
    if (driftEls.length) {
      driftEls.forEach((el, i) => {
        const tw = gsap.to(el, {
          y: '+=18', x: '+=12', rotation: '+=4',
          duration: 6 + i, ease: 'sine.inOut', yoyo: true, repeat: -1,
          paused: true,
        });
        driftTweens.set(el, tw);
      });
      const driftIO = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const tw = driftTweens.get(e.target);
            if (!tw) continue;
            if (e.isIntersecting) {
              visibleDriftEls.add(e.target);
              e.target.classList.add('is-visible');
              if (!document.hidden) tw.play();
            } else {
              visibleDriftEls.delete(e.target);
              e.target.classList.remove('is-visible');
              tw.pause();
            }
          }
        },
        { rootMargin: '120px 0px' },
      );
      driftEls.forEach((el) => driftIO.observe(el));
    }

    // Pause infinite CSS animations when outside viewport or tab hidden
    const cssAnimEls = document.querySelectorAll<HTMLElement>('.particle, .vsl-play, .btn-yellow, .hero-cue');
    if (cssAnimEls.length) {
      const cssAnimIO = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              visibleAnimEls.add(e.target);
              if (!document.hidden) e.target.classList.remove('lb-anim-paused');
            } else {
              visibleAnimEls.delete(e.target);
              e.target.classList.add('lb-anim-paused');
            }
          }
        },
        { rootMargin: '80px 0px' },
      );
      cssAnimEls.forEach((el) => {
        el.classList.add('lb-anim-paused');
        cssAnimIO.observe(el);
      });
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        visibleDriftEls.forEach((el) => driftTweens.get(el)?.pause());
        visibleAnimEls.forEach((el) => el.classList.add('lb-anim-paused'));
      } else {
        visibleDriftEls.forEach((el) => driftTweens.get(el)?.play());
        visibleAnimEls.forEach((el) => el.classList.remove('lb-anim-paused'));
      }
    });

    ScrollTrigger.refresh();
  }

  // ---------- Unified rAF-coalesced scroll UI (zero layout reads per scroll frame) ----------
  {
    const prog = document.getElementById('navProgress');
    const sticky = document.getElementById('stickyCta');
    const floatNote = document.getElementById('floatNote');
    const qual = document.getElementById('calificar');
    const heroSection = document.querySelector<HTMLElement>('.hero');
    const tabs = Array.from(document.querySelectorAll<HTMLElement>('.book-tabs .bt'));
    const tabTargets = tabs.map((tab) => ({
      tab,
      el: document.getElementById(tab.dataset.tab || ''),
      top: 0,
    }));

    let viewportH = window.innerHeight;
    let maxScroll = 0;
    let hasQual = false;
    let qualTop = 0;
    let qualBottom = 0;
    let heroBottom = 900;

    let lastStickyShow: boolean | null = null;
    let lastFloatShow: boolean | null = null;
    let lastCur = -2;
    let lastHeroY = -1;
    let scrollRaf = 0;
    let measureRaf = 0;

    const measureLayout = () => {
      measureRaf = 0;
      const sy = window.scrollY;
      viewportH = window.innerHeight;
      maxScroll = Math.max(0, document.documentElement.scrollHeight - viewportH);
      if (qual) {
        const qr = qual.getBoundingClientRect();
        qualTop = qr.top + sy;
        qualBottom = qr.bottom + sy;
        hasQual = true;
      } else {
        hasQual = false;
      }
      if (heroSection) {
        const hr = heroSection.getBoundingClientRect();
        heroBottom = hr.bottom + sy + 120;
      }
      for (const item of tabTargets) {
        if (item.el) item.top = item.el.getBoundingClientRect().top + sy;
      }
    };

    const applyScroll = () => {
      scrollRaf = 0;
      const y = window.scrollY;

      if (prog) {
        const ratio = maxScroll > 0 ? Math.min(1, Math.max(0, y / maxScroll)) : 0;
        prog.style.transform = `scaleX(${ratio.toFixed(4)})`;
      }

      if (heroEls.length) {
        const clampedY = y <= heroBottom ? y : heroBottom;
        if (clampedY !== lastHeroY) {
          for (let i = 0; i < heroEls.length; i++) {
            const [el, rot, mul] = heroEls[i];
            el.style.transform = `rotate(${rot}deg) translateY(${(clampedY * mul).toFixed(2)}px)`;
          }
          lastHeroY = clampedY;
        }
      }

      const onForm = hasQual && qualTop < y + viewportH && qualBottom > y;
      const stickyShow = y > 650 && !onForm;
      if (sticky && stickyShow !== lastStickyShow) {
        sticky.classList.toggle('show', stickyShow);
        lastStickyShow = stickyShow;
      }
      const floatShow = y > 900 && !onForm;
      if (floatNote && floatShow !== lastFloatShow) {
        floatNote.classList.toggle('show', floatShow);
        lastFloatShow = floatShow;
      }

      if (tabTargets.length) {
        const cutoff = y + viewportH * 0.45;
        let cur = -1;
        for (let i = 0; i < tabTargets.length; i++) {
          if (tabTargets[i].el && tabTargets[i].top < cutoff) cur = i;
        }
        if (cur !== lastCur) {
          for (let i = 0; i < tabTargets.length; i++) {
            tabTargets[i].tab.classList.toggle('on', i === cur);
          }
          lastCur = cur;
        }
      }
    };

    const scheduleScroll = () => {
      for (let i = 0; i < rectInvalidators.length; i++) rectInvalidators[i]();
      if (!scrollRaf) scrollRaf = requestAnimationFrame(applyScroll);
    };

    const scheduleMeasure = () => {
      if (!measureRaf) {
        measureRaf = requestAnimationFrame(() => {
          measureLayout();
          applyScroll();
        });
      }
    };

    window.addEventListener('scroll', scheduleScroll, { passive: true });
    window.addEventListener('resize', scheduleMeasure, { passive: true });
    window.addEventListener('load', scheduleMeasure, { once: true });
    if ('ResizeObserver' in window) {
      const layoutRO = new ResizeObserver(scheduleMeasure);
      layoutRO.observe(document.body);
      if (qual) layoutRO.observe(qual);
    }

    measureLayout();
    applyScroll();
  }

  // ---------- Hero entrance after BookIntro finishes ----------
  if (!reduce) {
    const playHero = () => {
      document
        .querySelectorAll('.hero .reveal')
        .forEach((el) => el.classList.add('in'));
      const items: [string, gsap.TweenVars, gsap.TweenVars?][] = [
        ['.hero .photo-card', { y: 60, rotation: -6, opacity: 0, scale: 0.94, duration: 0.7, ease: 'back.out(1.6)' }],
        ['.hero h1', { y: 36, opacity: 0 }, { y: 0, opacity: 1, duration: 0.65, ease: 'power3.out' }],
        ['.hero .lead', { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.55, ease: 'power3.out' }],
        ['.hero .actions', { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out' }],
        ['.hero .meta', { y: 14, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: 'power3.out' }],
        ['.hero .note', { scale: 1.5, opacity: 0, duration: 0.45, ease: 'back.out(2)' }],
        ['.hero .seal', { scale: 2.2, rotation: 30, opacity: 0, duration: 0.5, ease: 'back.out(2.4)' }],
      ];
      const tl = gsap.timeline({ delay: 0.05 });
      items.forEach(([sel, from, to], i) => {
        const els = document.querySelectorAll(sel);
        if (!els.length) return;
        if (to) tl.fromTo(els, from, { ...to, stagger: 0.08 }, i * 0.09);
        else tl.from(els, { ...from, stagger: 0.08 }, i * 0.09);
      });
      const hand = document.querySelector('.hero-handwrite');
      if (hand) hand.classList.add('written');
    };
    if ((window as any).__lbIntroDone) playHero();
    else window.addEventListener('lb:introDone', playHero, { once: true });
  }
</script>

<!-- Pencil cursor drawing (vanilla, desktop fine-pointer only, demand-driven rAF) -->
<script>
  (function () {
    if (!window.matchMedia || !window.matchMedia('(pointer: fine)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const root = document.querySelector('.lb-root') as HTMLElement | null;
    if (!root) return;

    const LIFESPAN = 15000, ERASE_DUR = 1700, MOVE_MIN = 4, INK = '26, 22, 16';
    const canvas = document.createElement('canvas');
    canvas.id = 'lb-pencil-layer';
    let ctx: CanvasRenderingContext2D | null = null;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let mounted = false;
    let lastW = 0;
    let lastH = 0;
    let rafId = 0;

    function size() {
      const w = innerWidth;
      const h = innerHeight;
      if (ctx && w === lastW && h === lastH) return;
      lastW = w;
      lastH = h;
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx = canvas.getContext('2d')!;
      ctx.scale(dpr, dpr);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
    }

    function ensureCanvas() {
      if (!mounted) {
        document.body.appendChild(canvas);
        mounted = true;
      } else if (canvas.style.display === 'none') {
        canvas.style.display = '';
      }
      size();
    }

    type Pt = { x: number; y: number };
    type Stroke = { pts: Pt[]; done: boolean; finishedAt: number };
    const strokes: Stroke[] = [];
    let current: Stroke | null = null;
    let drawing = false, moved = 0;

    function isInteractive(el: EventTarget | null) {
      return !!(el && (el as Element).closest && (el as Element).closest(
        'a, button, input, textarea, select, label, [role="button"], .btn, .qf-opt, .vsl-frame, [data-no-pencil]'));
    }

    function startLoop() {
      if (rafId || document.hidden) return;
      rafId = requestAnimationFrame(loop);
    }

    function stopLoop() {
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = 0;
      }
    }

    window.addEventListener('resize', () => {
      if (mounted && canvas.style.display !== 'none') size();
    }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopLoop();
      else if (strokes.length > 0 || drawing) startLoop();
    });

    // Points are stored in DOCUMENT coordinates (clientX + scroll) so the
    // drawing stays anchored to the page and scrolls away with it.
    window.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' || e.button !== 0) return;
      if (isInteractive(e.target)) return;
      drawing = true; moved = 0;
      current = { pts: [{ x: e.clientX + window.scrollX, y: e.clientY + window.scrollY }], done: false, finishedAt: 0 };
    }, true);

    window.addEventListener('pointermove', (e) => {
      if (!drawing || !current) return;
      const px = e.clientX + window.scrollX, py = e.clientY + window.scrollY;
      const last = current.pts[current.pts.length - 1];
      const d = Math.hypot(px - last.x, py - last.y);
      if (d < 1.2) return;
      moved += d;
      current.pts.push({ x: px, y: py });
      if (moved > MOVE_MIN && strokes.indexOf(current) === -1) {
        strokes.push(current);
        root.classList.add('pencil-drawing');
        ensureCanvas();
        startLoop();
      }
    }, true);

    function end() {
      if (current && moved > MOVE_MIN) { current.done = true; current.finishedAt = performance.now(); }
      else if (current) { const i = strokes.indexOf(current); if (i !== -1) strokes.splice(i, 1); }
      drawing = false; current = null;
      root!.classList.remove('pencil-drawing');
    }
    window.addEventListener('pointerup', end, true);
    window.addEventListener('pointercancel', end, true);
    window.addEventListener('blur', end);

    function drawRange(c: CanvasRenderingContext2D, pts: Pt[], from: number, to: number) {
      if (to - from < 2) {
        if (to - from === 1) {
          const p = pts[from];
          c.beginPath(); c.arc(p.x, p.y, 0.8, 0, Math.PI * 2);
          c.fillStyle = 'rgba(' + INK + ',0.85)'; c.fill();
        }
        return;
      }
      c.beginPath();
      c.moveTo(pts[from].x, pts[from].y);
      for (let i = from + 1; i < to - 1; i++) {
        const mx = (pts[i].x + pts[i + 1].x) / 2;
        const my = (pts[i].y + pts[i + 1].y) / 2;
        c.quadraticCurveTo(pts[i].x, pts[i].y, mx, my);
      }
      c.lineTo(pts[to - 1].x, pts[to - 1].y);
      c.strokeStyle = 'rgba(' + INK + ',0.82)'; c.lineWidth = 1.5; c.stroke();
      c.strokeStyle = 'rgba(' + INK + ',0.18)'; c.lineWidth = 2.6; c.stroke();
    }

    function loop(now: number) {
      rafId = 0;
      if (document.hidden || !ctx) return;
      ctx.clearRect(0, 0, lastW, lastH);
      if (strokes.length > 0) {
        ctx.save();
        ctx.translate(-window.scrollX, -window.scrollY);
        for (let s = strokes.length - 1; s >= 0; s--) {
          const st = strokes[s];
          const n = st.pts.length;
          let from = 0;
          if (st.done) {
            const age = now - st.finishedAt;
            if (age > LIFESPAN) {
              const f = (age - LIFESPAN) / ERASE_DUR;
              from = Math.floor(f * (n - 1));
              if (from >= n - 1) { strokes.splice(s, 1); continue; }
            }
          }
          drawRange(ctx, st.pts, from, n);
        }
        ctx.restore();
      }
      if (strokes.length > 0 || drawing) {
        rafId = requestAnimationFrame(loop);
      } else {
        canvas.style.display = 'none';
      }
    }
  })();
</script>
