---
// Root "/" — this is the URL that lives on the CV, LinkedIn, Instagram bio,
// etc. It never renders content itself; it picks a locale and redirects to
// /en/ or /es/ so the rest of the site stays static and cacheable.
export const prerender = false;

import { resolveLocale } from "../i18n/geo";

const locale = resolveLocale(Astro);

return Astro.redirect(`/${locale}/${Astro.url.search}`, 302);
---
