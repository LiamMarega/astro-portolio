---
// Bare "/portfolio" — kept working for any old links / bookmarks, but the
// real content now lives at /en/portfolio and /es/portfolio.
export const prerender = false;

import { resolveLocale } from "../../i18n/geo";

const locale = resolveLocale(Astro);

return Astro.redirect(`/${locale}/portfolio/${Astro.url.search}`, 302);
---
