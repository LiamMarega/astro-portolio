---
/**
 * /ecommerce (es) and /en/ecommerce (en): sales page for the custom headless e-commerce service.
 * /en/ecommerce re-uses this file (src/pages/en/ecommerce.astro); the language comes from Astro.currentLocale.
 * Funnel order: promise → proof in numbers → "that's me" (pains) → how it works (method)
 * → proof (real stores) → what's included → quote CTA → process → who → fair comparison → objections (FAQ) → close.
 * All copy: src/content/ecommerce.ts. Every CTA goes to the contact form (/contact, /en/contact).
 */
import Base from '../layouts/Base.astro';
import Sky from '../components/Sky.astro';
import TopBlur from '../components/TopBlur.astro';
import Nav from '../components/Nav.astro';
import ContactBar from '../components/ContactBar.astro';
import EcoHero from '../components/eco/EcoHero.astro';
import EcoStats from '../components/eco/EcoStats.astro';
import EcoPains from '../components/eco/EcoPains.astro';
import EcoMethod from '../components/eco/EcoMethod.astro';
import EcoCases from '../components/eco/EcoCases.astro';
import EcoIncluded from '../components/eco/EcoIncluded.astro';
import CtaBand from '../components/eco/CtaBand.astro';
import EcoProcess from '../components/eco/EcoProcess.astro';
import EcoAbout from '../components/eco/EcoAbout.astro';
import EcoCompare from '../components/eco/EcoCompare.astro';
import EcoFaq from '../components/eco/EcoFaq.astro';
import EcoClose from '../components/eco/EcoClose.astro';
import EcoSticky from '../components/eco/EcoSticky.astro';
import { useEcommerce, ecommercePath } from '../content/ecommerce';
import { useContent } from '../content/site';
import '../styles/ecommerce.css';

const { lang, site } = useContent(Astro.currentLocale);
const e = useEcommerce(lang);
const other = lang === 'es' ? 'en' : 'es';
---

<Base title={e.meta.title} description={e.meta.description} ogImage={e.meta.og} alternates={ecommercePath}>
  <Sky />
  <TopBlur />
  <Nav items={e.nav.items} active="" cta={e.nav.cta} langHref={ecommercePath[other]} />
  <main id="top" class="eco">
    <EcoHero />
    <EcoStats />
    <EcoPains />
    <EcoMethod />
    <EcoCases />
    <EcoIncluded />
    <section class="esec equote">
      <CtaBand note={e.quote.note} text={e.quote.text} cta={e.quote.cta} href={e.contactHref} />
    </section>
    <EcoProcess />
    <EcoAbout />
    <EcoCompare />
    <EcoFaq />
    <EcoClose />
    <footer class="efoot">
      <ContactBar />
      <p class="efoot__legal">© {new Date().getFullYear()} {site.name} · {e.footer}</p>
    </footer>
  </main>
  <EcoSticky />
</Base>

<script>
  import '../scripts/ecommerce';
</script>

<style>
  .efoot {
    padding: clamp(80px, 9vw, 160px) 0 clamp(14px, 1.64vw, 28px);
  }
  .efoot :global(.cbar) {
    margin-top: 0;
  }
  .efoot__legal {
    width: min(86.1vw, 1640px);
    margin: 18px auto 0;
    padding: 0 clamp(16px, 2.18vw, 36px);
    font-size: 14px;
    color: var(--ink-mute);
  }
  @media (max-width: 900px) {
    .efoot {
      padding-bottom: calc(86px + env(safe-area-inset-bottom));
    }
  }
  @media (max-width: 760px) {
    .efoot__legal {
      width: calc(100% - 24px);
      padding: 0 18px;
    }
  }
</style>
