---
import "../styles/landing-builder.css";
import "../styles/serif-fallback.css";
import "@fontsource/source-serif-4/latin-400.css";
import "@fontsource/source-serif-4/latin-500.css";
import "@fontsource/source-serif-4/latin-600.css";
import "@fontsource/source-serif-4/latin-700.css";
import "@fontsource/source-serif-4/latin-400-italic.css";
import "@fontsource/source-serif-4/latin-500-italic.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "@fontsource/jetbrains-mono/latin-600.css";
import "@fontsource/jetbrains-mono/latin-700.css";
import "@fontsource/caveat/latin-500.css";
import "@fontsource/caveat/latin-600.css";
import "@fontsource/caveat/latin-700.css";
import serif400 from "@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url";
import serif600 from "@fontsource/source-serif-4/files/source-serif-4-latin-600-normal.woff2?url";
import serif700 from "@fontsource/source-serif-4/files/source-serif-4-latin-700-normal.woff2?url";
import { SEO } from "astro-seo";
import Analytics from "@vercel/analytics/astro";
import { canonicalUrl, ldJson, landingServiceNode, LANDING_DESCRIPTION } from "../content/seo";
import { ogImageFor } from "../content/og";

interface Props {
  title: string;
  description?: string;
}

const { title, description = LANDING_DESCRIPTION } = Astro.props;

// one canonical per page, trailing-slash form (vercel.json redirects the slash-less URL to it)
const canonical = canonicalUrl(Astro.url.pathname);
// share card: generated per route at build time (src/content/og.ts)
const og = ogImageFor(Astro.url.pathname);
const funnelCard = ogImageFor("/landing-builder/");
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* the three serif weights the first screen paints with: fetched in parallel with the CSS, not after it */}
    {[serif400, serif600, serif700].map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}

    {/* title, description, canonical, robots, hreflang, Open Graph and Twitter come from astro-seo, once */}
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      languageAlternates={[
        { hrefLang: "es", href: canonical },
        { hrefLang: "x-default", href: canonical },
      ]}
      openGraph={{
        basic: { title, type: "website", image: og.url, url: canonical },
        optional: { description, locale: "es_AR", siteName: "LiamDev" },
        image: { width: og.width, height: og.height, alt: og.alt, type: og.type },
      }}
      twitter={{
        card: "summary_large_image",
        creator: "@liammdev",
        title,
        description,
        image: og.url,
        imageAlt: og.alt,
      }}
      extend={{ meta: [{ name: "theme-color", content: "#fbfaf5" }] }}
    />

    {/* JSON-LD: the Landing PRO service, founded by the Person in the home graph */}
    <script is:inline type="application/ld+json" set:html={ldJson(landingServiceNode(funnelCard.url))} />
    <Analytics />
  </head>
  <body>
    <!-- ===== SVG filter bank (paper / torn / marker simulated in code) ===== -->
    <svg
      width="0"
      height="0"
      style="position:absolute;pointer-events:none"
      aria-hidden="true"
    >
      <defs>
        <filter id="lbRoughNote" x="-6%" y="-12%" width="112%" height="124%">
          <feTurbulence type="fractalNoise" baseFrequency="0.014 0.02" numOctaves="3" seed="7" result="t" />
          <feDisplacementMap in="SourceGraphic" in2="t" scale="11" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="lbRoughNote2" x="-6%" y="-12%" width="112%" height="124%">
          <feTurbulence type="fractalNoise" baseFrequency="0.016 0.022" numOctaves="3" seed="23" result="t" />
          <feDisplacementMap in="SourceGraphic" in2="t" scale="10" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="lbMarker" x="-8%" y="-45%" width="116%" height="190%">
          <feTurbulence type="fractalNoise" baseFrequency="0.025 0.04" numOctaves="2" seed="3" result="t" />
          <feDisplacementMap in="SourceGraphic" in2="t" scale="6" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="lbRoughBand" x="-3%" y="-220%" width="106%" height="540%">
          <feTurbulence type="fractalNoise" baseFrequency="0.006 0.03" numOctaves="3" seed="11" result="t" />
          <feDisplacementMap in="SourceGraphic" in2="t" scale="18" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="lbDeckle" x="-4%" y="-4%" width="108%" height="108%">
          <feTurbulence type="fractalNoise" baseFrequency="0.022 0.026" numOctaves="2" seed="5" result="t" />
          <feDisplacementMap in="SourceGraphic" in2="t" scale="4" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="lbTapeEdge" x="-10%" y="-30%" width="120%" height="160%">
          <feTurbulence type="fractalNoise" baseFrequency="0.05 0.09" numOctaves="2" seed="9" result="t" />
          <feDisplacementMap in="SourceGraphic" in2="t" scale="3" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="lbPencil" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.018 0.022" numOctaves="2" seed="4" result="t" />
          <feDisplacementMap in="SourceGraphic" in2="t" scale="3.2" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>

    <div class="lb-root">
      <a href="#main-content" class="lb-skip btn btn-yellow">
        Saltar al contenido principal
      </a>
      <main id="main-content" role="main">
        <slot />
      </main>
    </div>

    <style is:global>
      .lb-skip {
        position: absolute;
        left: 16px;
        top: -120px;
        z-index: 100;
        transition: top 0.2s ease;
      }
      .lb-skip:focus {
        top: 16px;
      }
    </style>
  </body>
</html>
