---
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import caveatLatin from '@fontsource-variable/caveat/files/caveat-latin-wght-normal.woff2?url';
import modakLatin from '@fontsource/modak/files/modak-latin-400-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';
import { useContent, homeHref, LOCALES, type Locale } from '../content/site';
import { homeSeo, homeGraph, ldJson } from '../content/seo';
import { ogImageFor } from '../content/og';

interface Props {
  /** <title> and og:title. Defaults to the home title. */
  title?: string;
  /** meta + og description. Defaults to the home description. */
  description?: string;
  /**
   * Counterparts of this page per language (paths, trailing slash), e.g. `{ es: '/contact/', en: '/en/contact/' }`.
   * Emits hreflang es/en + x-default (the es one). Pass `{}` for single-language pages
   * (self + x-default only). Omitted = the home pair (/ and /en/).
   */
  alternates?: Partial<Record<Locale, string>>;
  /** Home pages only: brand title/description, Person graph and the profile card. Inferred from `title` being absent. */
  home?: boolean;
  /**
   * Structured data of the page: one object (usually `{ '@context', '@graph' }`) or a list of them, each
   * emitted as its own `<script type="application/ld+json">`. Builders live in src/content/seo.ts.
   * Omitted on the home pages = the Person + WebSite graph.
   */
  jsonLd?: object | object[];
}

const { site, lang } = useContent(Astro.currentLocale);
const { title: pageTitle, description: pageDescription, alternates, home = pageTitle === undefined, jsonLd } = Astro.props;
// the home head is tuned for brand queries (src/content/seo.ts); site.ts keeps the title the page body shows
const title = pageTitle ?? homeSeo[lang].title;
const description = pageDescription ?? homeSeo[lang].description;
const base = Astro.site ?? new URL(site.url);
// pages are served as /name/ (directory output), so every URL we publish keeps the trailing slash
const path = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = new URL(home ? homeHref(lang) : path, base).toString();
// share card: generated per route at build time (src/content/og.ts, src/pages/og/[id].jpg.ts)
const og = ogImageFor(Astro.url.pathname);
// [hreflang, path] pairs. A page that exists in one language only announces itself + x-default.
const alt: [string, string][] = home
  ? [...LOCALES.map((l): [string, string] => [l, homeHref(l)]), ['x-default', '/']]
  : alternates && Object.keys(alternates).length
    ? [...(Object.entries(alternates) as [Locale, string][]), ['x-default', alternates.es ?? path]]
    : [[lang, path], ['x-default', path]];
const graphs = [jsonLd ?? (home ? homeGraph(lang, og.url) : [])].flat();
// Latin subset covers 100% of English and Spanish glyphs (U+0000-00FF + punctuation),
// avoiding unused cyrillic, greek, vietnamese, latin-ext, and devanagari font assets.
const latinUnicodeRange =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFacesCss = [
  `@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url('${interLatin}') format('woff2-variations');unicode-range:${latinUnicodeRange};}`,
  `@font-face{font-family:'Caveat Variable';font-style:normal;font-display:swap;font-weight:400 700;src:url('${caveatLatin}') format('woff2-variations');unicode-range:${latinUnicodeRange};}`,
  `@font-face{font-family:'Modak';font-style:normal;font-display:swap;font-weight:400;src:url('${modakLatin}') format('woff2');unicode-range:${latinUnicodeRange};}`,
].join('');
---

<!doctype html>
<html lang={lang} class="js-off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    {alt.map(([hreflang, href]) => <link rel="alternate" hreflang={hreflang} href={new URL(href, base).toString()} />)}
    <meta name="theme-color" content="#ffd60a" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFacesCss} />
    {/* page-specific hints (e.g. the LCP image preload): <link slot="head" … /> */}
    <slot name="head" />

    <meta property="og:type" content={home ? 'profile' : 'website'} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og.url} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:type" content={og.type} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={site.handle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.url} />
    <meta name="twitter:image:alt" content={og.alt} />
    {graphs.map((graph) => <script type="application/ld+json" set:html={ldJson(graph)} />)}
    <Analytics />

    <script is:inline>
      document.documentElement.classList.remove('js-off');
      document.documentElement.classList.add('js');
      // coming from the ES/EN switch: skip the sunrise so the page transition stays calm
      try {
        if (sessionStorage.getItem('lang-switch')) {
          sessionStorage.removeItem('lang-switch');
          document.documentElement.classList.add('no-intro');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
