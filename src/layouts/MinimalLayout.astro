---
// Standalone layout of the preserved /newspaper page (original design, no Base.astro).
// Tailwind v3 is precompiled to src/styles/legacy/newspaper.css (npm run legacy:css), so it never reaches the new pages.
import "lenis/dist/lenis.css";
import "../styles/legacy/newspaper.css";
import LegacyHead from "../components/ui/LegacyHead.astro";
import type { Locale } from "../content/site";

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  /** JSON-LD graph(s) of the page (builders in src/content/seo.ts). */
  jsonLd: object | object[];
}

const { title, description, lang = "es", jsonLd } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <LegacyHead title={title} description={description} lang={lang} jsonLd={jsonLd} />

    <link
      rel="preload"
      href="/fonts/helvetica-neue-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body class="overflow-x-hidden bg-black text-white min-h-screen">
    <slot />
  </body>

  <style is:global>
    @font-face {
      font-family: "HelveticaNeue";
      src: url("/fonts/helvetica-neue-bold.woff2") format("woff2");
      font-style: normal;
      font-display: swap;
      font-weight: 700;
    }
    @font-face {
      font-family: "HelveticaNeue";
      src: url("/fonts/helvetica-blk-it.woff2") format("woff2");
      font-style: italic;
      font-display: swap;
      font-weight: 800;
    }
    /* Metric-matched stand-ins (Arial Bold ~ Helvetica Neue Bold, size-adjust from the hmtx advances) so the swap
       to the woff2 does not reflow the page now that the CSS is inlined and paints before the font arrives. */
    @font-face {
      font-family: "HelveticaNeue Fallback";
      src: local("Arial Bold"), local("Arial-BoldMT");
      font-style: normal;
      font-weight: 700;
      size-adjust: 99.96%;
      ascent-override: 97.53%;
      descent-override: 21.81%;
      line-gap-override: 5.7%;
    }
    @font-face {
      font-family: "HelveticaNeue Fallback";
      src: local("Arial Bold Italic"), local("Arial-BoldItalicMT");
      font-style: italic;
      font-weight: 800;
      size-adjust: 109.84%;
      ascent-override: 88.31%;
      descent-override: 20.03%;
      line-gap-override: 0%;
    }

    ::selection {
      background: rgba(226, 255, 0, 0.3);
    }
    html {
      scroll-behavior: smooth;
    }
    body {
      font-family: "HelveticaNeue", "HelveticaNeue Fallback", system-ui, sans-serif;
    }
  </style>

  <script>
    import Lenis from "lenis";
    const lenis = new Lenis({ duration: 1.2, smoothWheel: true });
    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);
  </script>
</html>
