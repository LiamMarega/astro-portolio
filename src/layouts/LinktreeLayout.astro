---
// Standalone layout of the preserved linktree hub (/linktree/ in Spanish, /en/linktree/ in English).
// Original design, no Base.astro. Tailwind v3 is precompiled to src/styles/legacy/linktree.css (npm run legacy:css).
import "lenis/dist/lenis.css";
import "../styles/legacy/linktree.css";
import LegacyHead from "../components/ui/LegacyHead.astro";
import { legacyPageGraph } from "../content/seo";
import { ogUrlFor } from "../content/og";
import type { Locale } from "../content/site";

interface Props {
  title: string;
  description: string;
  lang?: Locale;
}

const { title, description, lang = "es" } = Astro.props;

// hreflang pair: Spanish is the default locale (x-default), English lives under /en/
const alternates = { es: "/linktree/", en: "/en/linktree/" };
const path = alternates[lang];
const jsonLd = legacyPageGraph(lang, {
  path,
  title,
  description,
  crumb: "Links",
  image: ogUrlFor(path),
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <LegacyHead
      title={title}
      description={description}
      lang={lang}
      alternates={alternates}
      jsonLd={jsonLd}
    />

    <!-- Preload critical resources -->
    <link
      rel="preload"
      href="/fonts/helvetica-neue-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/images/avatar.webp" as="image" />

    <!-- ?ref=ig re-orders the sections for visitors coming from Instagram (CSS below), before first paint -->
    <script is:inline>
      if (/[?&]ref=(ig|instagram)(&|$)/i.test(location.search)) document.documentElement.dataset.seg = "client";
    </script>
  </head>

  <body class="overflow-x-hidden bg-black text-white min-h-screen cursor-none">
    <!-- Radial gradient background -->
    <div
      class="fixed inset-0 -z-10 h-full w-full [background:radial-gradient(125%_125%_at_50%_10%,#000_40%,#63e_100%)]"
    >
    </div>
    <slot />
  </body>

  <style is:global>
    @font-face {
      font-family: "HelveticaNeue";
      src: url("/fonts/helvetica-neue-bold.woff2") format("woff2");
      font-style: normal;
      font-display: swap;
      font-weight: 700;
    }
    @font-face {
      font-family: "HelveticaNeue";
      src: url("/fonts/helvetica-blk-it.woff2") format("woff2");
      font-style: italic;
      font-display: swap;
      font-weight: 800;
    }

    /* Metric-matched stand-ins (Arial Bold ~ Helvetica Neue Bold, size-adjust from the hmtx advances) so the swap
       to the woff2 does not reflow the page now that the CSS is inlined and paints before the font arrives. */
    @font-face {
      font-family: "HelveticaNeue Fallback";
      src: local("Arial Bold"), local("Arial-BoldMT");
      font-style: normal;
      font-weight: 700;
      size-adjust: 99.96%;
      ascent-override: 97.53%;
      descent-override: 21.81%;
      line-gap-override: 5.7%;
    }
    @font-face {
      font-family: "HelveticaNeue Fallback";
      src: local("Arial Bold Italic"), local("Arial-BoldItalicMT");
      font-style: italic;
      font-weight: 800;
      size-adjust: 109.84%;
      ascent-override: 88.31%;
      descent-override: 20.03%;
      line-gap-override: 0%;
    }

    ::selection {
      background: rgba(226, 255, 0, 0.3);
    }
    html {
      scroll-behavior: smooth;
    }
    body {
      font-family: "HelveticaNeue", "HelveticaNeue Fallback", system-ui, sans-serif;
    }

    /* Glow pulse animation for Working on section */
    @keyframes glow-pulse {
      0%, 100% {
        box-shadow: 0 0 20px rgba(226, 255, 0, 0.08);
      }
      50% {
        box-shadow: 0 0 28px rgba(226, 255, 0, 0.2);
      }
    }
    .animate-glow-pulse {
      animation: glow-pulse 3s ease-in-out infinite;
    }

    /* ?ref=ig segment: lead with the client path (same order the old server-rendered page used) */
    html[data-seg="client"] [data-sec="landingPro"] { order: 2; }
    html[data-seg="client"] [data-sec="paths"] { order: 3; }
    html[data-seg="client"] [data-sec="projects"] { order: 4; }
    html[data-seg="client"] [data-sec="builder"] { order: 5; }
    html[data-seg="client"] [data-sec="socials"] { order: 6; }
    html[data-seg="client"] [data-sec="footer"] { order: 7; }
    html[data-seg="client"] [data-path="client"] { order: 1; }
    html[data-seg="client"] [data-path="company"] { order: 2; }
  </style>

  <script>
    import Lenis from "lenis";
    const lenis = new Lenis({ duration: 1.2, smoothWheel: true });
    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);
  </script>
</html>
