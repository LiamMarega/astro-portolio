# Copy to .env (local) or set them in your host's dashboard (Vercel, Netlify…).
# Only used by src/pages/api/contact.ts once you enable it (README → "Conectar Resend").

# API key from https://resend.com/api-keys ("Sending access" is enough)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Where leads arrive. Several addresses: separate them with commas.
LEADS_TO=tu@email.com

# Sender on a domain you verified in Resend
LEADS_FROM=Leads <leads@tudominio.com>
